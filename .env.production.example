# Production app config
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-secret
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me
NODE_ENV=production
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Deploy script config (local machine, not server)
# Copy this file to .env.deploy and fill values before first deploy.
HOSTINGER_SSH_HOST=your-server.example.com
HOSTINGER_SSH_USER=your-ssh-user
HOSTINGER_APP_DIR=/home/your-user/apps/ayhanakkayasite
HOSTINGER_BRANCH=main
HOSTINGER_RESTART_COMMAND='echo "Set HOSTINGER_RESTART_COMMAND in .env.deploy"; exit 1'
# Optional:
# HOSTINGER_PORT=22
# Example for PM2:
# HOSTINGER_RESTART_COMMAND=pm2 restart ayhanakkayasite || pm2 start src/app.js --name ayhanakkayasite
