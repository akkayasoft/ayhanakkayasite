<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ogrenci Paneli</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="shell">
      <aside class="sidebar">
        <div>
          <p class="sidebar-kicker">Ogrenci</p>
          <h1 class="sidebar-title">Calisma Paneli</h1>
          <p class="sidebar-user"><strong><%= user.name %></strong></p>
          <p class="muted">Toplam Puan: <strong><%= user.points || 0 %></strong></p>
        </div>

        <nav class="menu">
          <a href="/student/dashboard" class="menu-link <%= currentPage === 'dashboard' ? 'active' : '' %>">Bugun</a>
          <a href="/student/questions" class="menu-link <%= currentPage === 'questions' ? 'active' : '' %>">Soru Takibi</a>
          <a href="/student/points" class="menu-link <%= currentPage === 'points' ? 'active' : '' %>">Puan Gecmisi</a>
        </nav>

        <form method="post" action="/logout" class="sidebar-logout">
          <button type="submit" class="ghost">Cikis</button>
        </form>
      </aside>

      <section class="content">
        <% if (message) { %>
        <div class="alert success"><%= message %></div>
        <% } %>
        <% if (error) { %>
        <div class="alert error"><%= error %></div>
        <% } %>

        <% if (currentPage === 'dashboard') { %>
        <header class="content-header">
          <h2>Bugunun Gorevleri</h2>
          <p class="muted"><%= today %></p>
        </header>

        <section class="kpi-grid">
          <article class="kpi"><p class="kpi-label">Toplam Gorev</p><p class="kpi-value"><%= tasksForToday.length %></p></article>
          <article class="kpi"><p class="kpi-label">Tamamlanan</p><p class="kpi-value"><%= doneCount %></p></article>
          <article class="kpi"><p class="kpi-label">Bekleyen</p><p class="kpi-value"><%= Math.max(tasksForToday.length - doneCount, 0) %></p></article>
          <article class="kpi"><p class="kpi-label">Puan</p><p class="kpi-value"><%= user.points || 0 %></p></article>
        </section>

        <section class="panel">
          <% if (!tasksForToday.length) { %>
          <p class="muted">Bugune atanmis gorev yok.</p>
          <% } %>

          <% tasksForToday.forEach((task) => { %>
          <form method="post" action="/student/tasks/<%= task.id %>/status" class="task">
            <div>
              <h3><%= task.title %></h3>
              <p class="muted"><%= task.categoryName %></p>
              <p><%= task.description %></p>
            </div>

            <div class="stack">
              <label>Durum</label>
              <select name="status" required>
                <option value="done" <%= task.todayStatus?.status === 'done' ? 'selected' : '' %>>Yapildi</option>
                <option value="not_done" <%= task.todayStatus?.status === 'not_done' ? 'selected' : '' %>>Yapilmadi</option>
              </select>

              <label>Not</label>
              <input type="text" name="note" value="<%= task.todayStatus?.note || '' %>" />

              <button type="submit">Kaydet</button>
            </div>
          </form>
          <% }) %>
        </section>
        <% } %>

        <% if (currentPage === 'questions') { %>
        <header class="content-header">
          <h2>Gunluk Soru Takibi</h2>
          <p class="muted"><%= today %></p>
        </header>

        <section class="panel">
          <form method="post" action="/student/questions" class="grid two">
            <div class="stack">
              <label>Kategori</label>
              <select name="categoryId" required>
                <option value="">Seciniz</option>
                <% categories.forEach((c) => { %>
                <option value="<%= c.id %>" <%= questionEntry?.categoryId === c.id ? 'selected' : '' %>><%= c.name %></option>
                <% }) %>
              </select>

              <label>Ders Adi</label>
              <input type="text" name="lessonName" value="<%= questionEntry?.lessonName || '' %>" required />

              <label>Tarih</label>
              <input type="date" name="day" value="<%= today %>" required />
            </div>

            <div class="stack">
              <label>Dogru</label>
              <input type="number" min="0" name="correctCount" value="<%= questionEntry?.correctCount ?? 0 %>" required />

              <label>Yanlis</label>
              <input type="number" min="0" name="wrongCount" value="<%= questionEntry?.wrongCount ?? 0 %>" required />

              <label>Sure (dakika)</label>
              <input type="number" min="0" name="durationMinutes" value="<%= questionEntry?.durationMinutes ?? 0 %>" required />

              <button type="submit">Kaydet</button>
            </div>
          </form>
        </section>

        <section class="panel">
          <h3>Son Kayitlar</h3>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Tarih</th>
                  <th>Kategori</th>
                  <th>Ders Adi</th>
                  <th>Dogru</th>
                  <th>Yanlis</th>
                  <th>Toplam</th>
                  <th>Sure (dk)</th>
                </tr>
              </thead>
              <tbody>
                <% questionHistory.forEach((q) => { %>
                <tr>
                  <td><%= q.date %></td>
                  <td><%= q.categoryName || 'Kategori Yok' %></td>
                  <td><%= q.lessonName %></td>
                  <td><%= q.correctCount %></td>
                  <td><%= q.wrongCount %></td>
                  <td><%= q.totalCount %></td>
                  <td><%= q.durationMinutes %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
        <% } %>

        <% if (currentPage === 'points') { %>
        <header class="content-header">
          <h2>Puan Gecmisi</h2>
        </header>

        <section class="panel">
          <ul class="clean-list">
            <% pointLogs.forEach((p) => { %>
            <li>
              <%= p.createdDate %> - <strong><%= p.type === 'reward' ? 'Odul' : 'Ceza' %></strong>
              - <%= p.points %> puan - <%= p.reason %>
            </li>
            <% }) %>
          </ul>
        </section>
        <% } %>
      </section>
    </main>
  </body>
</html>
