<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ogrenci Paneli</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="shell">
      <aside class="sidebar">
        <div>
          <p class="sidebar-kicker">Ogrenci</p>
          <h1 class="sidebar-title">Calisma Paneli</h1>
          <p class="sidebar-user"><strong><%= user.name %></strong></p>
          <p class="muted">Toplam Puan: <strong><%= user.points || 0 %></strong></p>
        </div>

        <nav class="menu">
          <a href="/student/dashboard" class="menu-link <%= currentPage === 'dashboard' ? 'active' : '' %>">Gorevler</a>
          <a href="/student/calendar" class="menu-link <%= currentPage === 'calendar' ? 'active' : '' %>">Haftalik Takvim</a>
          <a href="/student/questions" class="menu-link <%= currentPage === 'questions' ? 'active' : '' %>">Soru Takibi</a>
          <a href="/student/points" class="menu-link <%= currentPage === 'points' ? 'active' : '' %>">Puan Gecmisi</a>
        </nav>

        <form method="post" action="/logout" class="sidebar-logout">
          <button type="submit" class="ghost">Cikis</button>
        </form>
      </aside>

      <section class="content">
        <% if (message) { %>
        <div class="alert success"><%= message %></div>
        <% } %>
        <% if (error) { %>
        <div class="alert error"><%= error %></div>
        <% } %>

        <% if (currentPage === 'dashboard') { %>
        <header class="content-header">
          <h2>Aktif Gorevlerim</h2>
          <p class="muted"><%= today %></p>
        </header>

        <section class="kpi-grid">
          <article class="kpi"><p class="kpi-label">Toplam Gorev</p><p class="kpi-value"><%= activeTasks.length %></p></article>
          <article class="kpi"><p class="kpi-label">Tamamlanan</p><p class="kpi-value"><%= doneCount %></p></article>
          <article class="kpi"><p class="kpi-label">Bekleyen</p><p class="kpi-value"><%= Math.max(activeTasks.length - doneCount, 0) %></p></article>
          <article class="kpi"><p class="kpi-label">Puan</p><p class="kpi-value"><%= user.points || 0 %></p></article>
        </section>

        <section class="panel compact-panel">
          <div class="legend-row">
            <span class="legend-item"><span class="dot done"></span> ✓</span>
            <span class="legend-item"><span class="dot not-done"></span> ✕</span>
            <span class="legend-item"><span class="dot open"></span> ○</span>
          </div>
        </section>

        <section class="panel">
          <% if (!activeTasks.length) { %>
          <p class="muted">Aktif gorev yok.</p>
          <% } %>

          <% if (activeTasks.length) { %>
          <div class="table-wrap">
            <table class="task-table">
              <thead>
                <tr>
                  <th>Durum</th>
                  <th>Baslik</th>
                  <th>Kategori</th>
                  <th>Tarih</th>
                  <th>Aciklama</th>
                  <th>Islem</th>
                </tr>
              </thead>
              <tbody>
                <% activeTasks.forEach((task) => { %>
                <tr>
                  <td>
                    <span class="task-state-icon <%= task.todayStatus?.status === 'done' ? 'ok' : task.todayStatus?.status === 'not_done' ? 'bad' : 'idle' %>">
                      <%= task.todayStatus?.status === 'done' ? '✓' : task.todayStatus?.status === 'not_done' ? '✕' : '○' %>
                    </span>
                  </td>
                  <td><strong><%= task.title %></strong></td>
                  <td><%= task.categoryName %></td>
                  <td class="task-meta"><%= task.scheduleText %></td>
                  <td><%= task.description || '-' %></td>
                  <td>
                    <div class="task-table-actions">
                      <form method="post" action="/student/tasks/<%= task.id %>/status">
                        <input type="hidden" name="status" value="done" />
                        <input type="hidden" name="note" value="<%= task.todayStatus?.note || '' %>" />
                        <button type="submit" class="icon-btn ok" title="Yapildi" aria-label="Yapildi">✓</button>
                      </form>
                      <form method="post" action="/student/tasks/<%= task.id %>/status">
                        <input type="hidden" name="status" value="not_done" />
                        <input type="hidden" name="note" value="<%= task.todayStatus?.note || '' %>" />
                        <button type="submit" class="icon-btn bad" title="Yapilmadi" aria-label="Yapilmadi">✕</button>
                      </form>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </section>
        <% } %>

        <% if (currentPage === 'calendar' && calendar) { %>
        <header class="content-header row space-between center">
          <div>
            <h2>Haftalik Takvim</h2>
            <p class="muted"><%= calendar.weekStart %> - <%= calendar.weekEnd %></p>
          </div>
          <div class="row">
            <a class="button-link" href="/student/calendar/export?weekStart=<%= calendar.weekStart %>">Excel Indir</a>
            <a class="button-link" href="/student/calendar?weekStart=<%= calendar.prevWeekStart %>">Onceki Hafta</a>
            <a class="button-link" href="/student/calendar?weekStart=<%= calendar.nextWeekStart %>">Sonraki Hafta</a>
          </div>
        </header>

        <section class="panel">
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Gun</th>
                  <th>Tarih</th>
                  <th>Gorev</th>
                  <th>Tamamlanan</th>
                  <th>Soru</th>
                  <th>Sure (dk)</th>
                </tr>
              </thead>
              <tbody>
                <% calendar.days.forEach((d) => { %>
                <tr class="<%= d.dueCount > 0 && d.doneCount === d.dueCount ? 'day-ok' : d.doneCount > 0 ? 'day-partial' : d.dueCount > 0 ? 'day-bad' : '' %>">
                  <td><%= d.dayName %></td>
                  <td><%= d.date %></td>
                  <td><%= d.dueCount %></td>
                  <td><%= d.doneCount %></td>
                  <td><%= d.questionTotal %></td>
                  <td><%= d.durationMinutes %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>

        <section class="grid two">
          <% calendar.days.forEach((d) => { %>
          <article class="panel">
            <h3><%= d.dayName %> - <%= d.date %></h3>
            <% if (!d.tasks.length) { %>
            <p class="muted">Gorev yok.</p>
            <% } %>
            <% if (d.tasks.length) { %>
            <ul class="clean-list">
              <% d.tasks.forEach((t) => { %>
              <li class="row space-between center">
                <span><%= t.title %></span>
                <span class="status-pill <%= t.status === 'done' ? 'ok' : t.status === 'not_done' ? 'bad' : 'idle' %>">
                  <%= t.status === 'done' ? 'Yapildi' : t.status === 'not_done' ? 'Yapilmadi' : 'Isaretlenmedi' %>
                </span>
              </li>
              <% }) %>
            </ul>
            <% } %>
          </article>
          <% }) %>
        </section>
        <% } %>

        <% if (currentPage === 'questions') { %>
        <header class="content-header">
          <h2>Gunluk Soru Takibi</h2>
          <p class="muted"><%= today %></p>
        </header>

        <section class="panel">
          <form method="post" action="/student/questions" class="grid two">
            <div class="stack">
              <label>Kategori</label>
              <select name="categoryId" required>
                <option value="">Seciniz</option>
                <% categories.forEach((c) => { %>
                <option value="<%= c.id %>" <%= questionEntry?.categoryId === c.id ? 'selected' : '' %>><%= c.name %></option>
                <% }) %>
              </select>

              <label>Ders Adi</label>
              <input type="text" name="lessonName" value="<%= questionEntry?.lessonName || '' %>" required />

              <label>Tarih</label>
              <input type="date" name="day" value="<%= today %>" required />
            </div>

            <div class="stack">
              <label>Dogru</label>
              <input type="number" min="0" name="correctCount" value="<%= questionEntry?.correctCount ?? 0 %>" required />

              <label>Yanlis</label>
              <input type="number" min="0" name="wrongCount" value="<%= questionEntry?.wrongCount ?? 0 %>" required />

              <label>Sure (dakika)</label>
              <input type="number" min="0" name="durationMinutes" value="<%= questionEntry?.durationMinutes ?? 0 %>" required />

              <button type="submit">Kaydet</button>
            </div>
          </form>
        </section>

        <section class="panel">
          <h3>Son Kayitlar</h3>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Tarih</th>
                  <th>Kategori</th>
                  <th>Ders Adi</th>
                  <th>Dogru</th>
                  <th>Yanlis</th>
                  <th>Toplam</th>
                  <th>Sure (dk)</th>
                </tr>
              </thead>
              <tbody>
                <% questionHistory.forEach((q) => { %>
                <tr>
                  <td><%= q.date %></td>
                  <td><%= q.categoryName || 'Kategori Yok' %></td>
                  <td><%= q.lessonName %></td>
                  <td><%= q.correctCount %></td>
                  <td><%= q.wrongCount %></td>
                  <td><%= q.totalCount %></td>
                  <td><%= q.durationMinutes %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
        <% } %>

        <% if (currentPage === 'points') { %>
        <header class="content-header">
          <h2>Puan Gecmisi</h2>
          <p class="muted">Haftalik Odul/Ceza: <strong><%= weeklyPointWeekStart %> - <%= weeklyPointWeekEnd %></strong></p>
        </header>

        <section class="panel">
          <form method="get" action="/student/points" class="row center">
            <label>Hafta Baslangici</label>
            <input type="date" name="weekStart" value="<%= weeklyPointWeekStart %>" required />
            <button type="submit">Haftayi Getir</button>
            <a class="button-link" href="/student/points/export-weekly?weekStart=<%= weeklyPointWeekStart %>">Excel Indir</a>
          </form>
        </section>

        <section class="panel">
          <h3>Haftalik Odul/Ceza Sonuclari</h3>
          <% if (!weeklyPointEvaluations.length) { %>
          <p class="muted">Secili hafta icin odul/ceza degerlendirmesi bulunmuyor.</p>
          <% } %>
          <% if (weeklyPointEvaluations.length) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Kategori</th>
                  <th>Toplam Gorev</th>
                  <th>Yapilan</th>
                  <th>Oran</th>
                  <th>Sonuc</th>
                  <th>Puan</th>
                  <th>Aciklama</th>
                </tr>
              </thead>
              <tbody>
                <% weeklyPointEvaluations.forEach((e) => { %>
                <tr>
                  <td><%= e.categoryName %></td>
                  <td><%= e.dueCount %></td>
                  <td><%= e.doneCount %></td>
                  <td>%<%= e.completionRate.toFixed(1) %></td>
                  <td><%= e.resultType === 'reward' ? 'Odul' : e.resultType === 'penalty' ? 'Ceza' : 'Esik' %></td>
                  <td><%= e.pointsApplied %></td>
                  <td><%= e.reasonText || '-' %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </section>

        <section class="panel">
          <h3>Son Puan Kayitlari</h3>
          <ul class="clean-list">
            <% pointLogs.forEach((p) => { %>
            <li>
              <%= p.createdDate %> - <strong><%= p.type === 'reward' ? 'Odul' : 'Ceza' %></strong>
              - <%= p.points %> puan - <%= p.reason %>
            </li>
            <% }) %>
          </ul>
        </section>
        <% } %>
      </section>
    </main>
  </body>
</html>
