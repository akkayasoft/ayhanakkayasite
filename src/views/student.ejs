<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Öğrenci Paneli</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="shell">
      <aside class="sidebar">
        <div>
          <p class="sidebar-kicker">Öğrenci</p>
          <h1 class="sidebar-title">Çalışma Paneli</h1>
          <p class="sidebar-user"><strong><%= user.name %></strong></p>
          <p class="muted">Toplam Puan: <strong><%= user.points || 0 %></strong></p>
        </div>

        <nav class="menu">
          <a href="/student/dashboard" class="menu-link <%= currentPage === 'dashboard' ? 'active' : '' %>">Görevler</a>
          <a href="/student/calendar" class="menu-link <%= currentPage === 'calendar' ? 'active' : '' %>">Haftalık Takvim</a>
          <a href="/student/questions" class="menu-link <%= currentPage === 'questions' ? 'active' : '' %>">Soru Takibi</a>
          <a href="/student/points" class="menu-link <%= currentPage === 'points' ? 'active' : '' %>">Puan Geçmişi</a>
        </nav>

        <form method="post" action="/logout" class="sidebar-logout">
          <button type="submit" class="ghost">Çıkış</button>
        </form>
      </aside>

      <section class="content">
        <% if (message) { %>
        <div class="alert success"><%= message %></div>
        <% } %>
        <% if (error) { %>
        <div class="alert error"><%= error %></div>
        <% } %>

        <% if (currentPage === 'dashboard') { %>
        <header class="content-header">
          <h2>Aktif Görevlerim</h2>
          <p class="muted"><%= today %></p>
        </header>

        <section class="panel">
          <h3>Günlük Görev Ekle</h3>
          <form id="studentTaskCreateForm" method="post" action="/student/tasks" class="grid two">
            <input type="hidden" name="next" value="/student/dashboard" />
            <div class="stack">
              <label>Görev Başlığı</label>
              <input type="text" name="title" minlength="2" maxlength="120" autocomplete="off" required />
            </div>
            <div class="stack">
              <label>Kategori</label>
              <select id="studentTaskCategorySelect" name="categoryId" required>
                <option value="">Kategori Seç</option>
                <% categories.forEach((c) => { %>
                <option value="<%= c.id %>"><%= c.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="stack">
              <label>Plan Tipi</label>
              <select id="studentTaskPlanningMode" name="planningMode" required>
                <option value="single">Tek Gün</option>
                <option value="multi_daily">Toplu Günlük Plan</option>
              </select>
            </div>
            <div id="studentTaskSingleDateFields" class="stack">
              <label>Tarih</label>
              <input id="studentTaskDateInput" type="date" name="singleDate" value="<%= today %>" required />
              <div class="quick-date-row">
                <button type="button" class="quick-date-btn" data-offset-days="0">Bugün</button>
                <button type="button" class="quick-date-btn" data-offset-days="1">Yarın</button>
                <button type="button" class="quick-date-btn" data-offset-days="7">+7 Gün</button>
              </div>
            </div>
            <div id="studentTaskRangeFields" class="stack form-block-hidden">
              <label>Başlangıç Tarihi</label>
              <input id="studentTaskRangeStartInput" type="date" name="rangeStartDate" value="<%= today %>" />
              <label>Kaç Gün Sürecek?</label>
              <input id="studentTaskRangeDayCountInput" type="number" name="rangeDayCount" min="1" max="180" value="30" />
            </div>
            <div class="stack">
              <label>Tahmini Saat</label>
              <input type="time" name="estimatedTime" />
            </div>
            <div class="stack">
              <label>Açıklama</label>
              <input type="text" name="description" maxlength="300" placeholder="Yaptıklarını kısaca yazabilirsin" />
            </div>
            <div>
              <button type="submit" data-default-label="Görev Ekle">Görev Ekle</button>
              <p class="muted form-helper">Aynı gün, aynı kategori ve aynı başlıkta çift kayıt engellenir. Toplu planda mevcut günler atlanır.</p>
            </div>
          </form>
        </section>
        <script>
          (() => {
            const form = document.getElementById('studentTaskCreateForm');
            if (!form) return;
            const categorySelect = document.getElementById('studentTaskCategorySelect');
            const planningModeSelect = document.getElementById('studentTaskPlanningMode');
            const dateInput = document.getElementById('studentTaskDateInput');
            const singleDateFields = document.getElementById('studentTaskSingleDateFields');
            const rangeFields = document.getElementById('studentTaskRangeFields');
            const rangeStartInput = document.getElementById('studentTaskRangeStartInput');
            const rangeDayCountInput = document.getElementById('studentTaskRangeDayCountInput');
            const quickDateButtons = Array.from(form.querySelectorAll('.quick-date-btn'));
            const submitButton = form.querySelector('button[type="submit"]');
            const categoryStorageKey = `student:lastTaskCategory:<%= user.id %>`;

            if (categorySelect) {
              const savedCategory = localStorage.getItem(categoryStorageKey);
              if (savedCategory) {
                const optionExists = Array.from(categorySelect.options).some((opt) => opt.value === savedCategory);
                if (optionExists) categorySelect.value = savedCategory;
              }
              categorySelect.addEventListener('change', () => {
                if (categorySelect.value) {
                  localStorage.setItem(categoryStorageKey, categorySelect.value);
                }
              });
            }

            const dateStringByOffset = (offsetDays) => {
              const date = new Date();
              date.setDate(date.getDate() + offsetDays);
              const local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
              return local.toISOString().slice(0, 10);
            };

            quickDateButtons.forEach((button) => {
              button.addEventListener('click', () => {
                if (!dateInput) return;
                const offset = Number(button.getAttribute('data-offset-days') || '0');
                dateInput.value = dateStringByOffset(offset);
                if (rangeStartInput && !rangeStartInput.value) {
                  rangeStartInput.value = dateInput.value;
                }
              });
            });

            const updatePlanningModeUI = () => {
              const isMulti = planningModeSelect && planningModeSelect.value === 'multi_daily';
              if (singleDateFields) singleDateFields.classList.toggle('form-block-hidden', Boolean(isMulti));
              if (rangeFields) rangeFields.classList.toggle('form-block-hidden', !isMulti);

              if (dateInput) dateInput.required = !isMulti;
              if (rangeStartInput) rangeStartInput.required = Boolean(isMulti);
              if (rangeDayCountInput) rangeDayCountInput.required = Boolean(isMulti);

              quickDateButtons.forEach((button) => {
                button.disabled = Boolean(isMulti);
              });

              if (submitButton) {
                submitButton.textContent = isMulti ? 'Toplu Görev Oluştur' : 'Görev Ekle';
              }
            };

            if (planningModeSelect) {
              planningModeSelect.addEventListener('change', updatePlanningModeUI);
            }
            updatePlanningModeUI();

            form.addEventListener('submit', () => {
              if (!submitButton) return;
              submitButton.disabled = true;
              submitButton.textContent = 'Kaydediliyor...';
            });
          })();
        </script>

        <section class="kpi-grid">
          <article class="kpi"><p class="kpi-label">Toplam Görev</p><p class="kpi-value"><%= activeTasks.length %></p></article>
          <article class="kpi"><p class="kpi-label">Tamamlanan</p><p class="kpi-value"><%= doneCount %></p></article>
          <article class="kpi"><p class="kpi-label">Bekleyen</p><p class="kpi-value"><%= Math.max(activeTasks.length - doneCount, 0) %></p></article>
          <article class="kpi"><p class="kpi-label">Puan</p><p class="kpi-value"><%= user.points || 0 %></p></article>
        </section>

        <section class="panel compact-panel">
          <div class="legend-row">
            <span class="legend-item"><span class="dot done"></span> Yapıldı</span>
            <span class="legend-item"><span class="dot not-done"></span> Yapılmadı</span>
            <span class="legend-item"><span class="dot open"></span> Bekliyor</span>
          </div>
        </section>

        <section class="panel">
          <% if (activeTasks.length) { %>
          <div class="datatable-filter-row">
            <div class="datatable-search">
              <label for="studentTaskTitleFilter">Başlık</label>
              <input id="studentTaskTitleFilter" type="text" placeholder="Başlığa göre filtrele" />
            </div>
            <div class="datatable-search">
              <label for="studentTaskCategoryFilter">Kategori</label>
              <select id="studentTaskCategoryFilter">
                <option value="">Tüm Kategoriler</option>
                <% categories.forEach((c) => { %>
                <option value="<%= c.name %>"><%= c.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="datatable-search">
              <label for="studentTaskDateFilter">Tarih</label>
              <input id="studentTaskDateFilter" type="text" placeholder="YYYY-MM-DD" />
            </div>
          </div>
          <% } %>

          <% if (!activeTasks.length) { %>
          <p class="muted">Aktif görev yok.</p>
          <% } %>

          <% if (activeTasks.length) { %>
          <div class="table-wrap">
            <table class="task-table student-task-table">
              <thead>
                <tr>
                  <th>Durum</th>
                  <th>Başlık</th>
                  <th>Kategori</th>
                  <th>Tarih</th>
                  <th>Saat</th>
                  <th>Açıklama</th>
                  <th>İşlem</th>
                </tr>
              </thead>
              <tbody>
                <% activeTasks.forEach((task) => { %>
                <tr
                  class="student-task-row <%= task.displayStatus?.status === 'done' ? 'task-row-success' : task.displayStatus?.status === 'not_done' ? 'task-row-error' : '' %>"
                  data-task-id="<%= task.id %>"
                  data-title="<%= (task.title || '').toLowerCase() %>"
                  data-category="<%= (task.categoryName || '').toLowerCase() %>"
                  data-date="<%= (task.scheduleText || '').toLowerCase() %>"
                >
                  <td data-label="Durum" class="status-cell">
                    <span class="task-state-icon <%= task.displayStatus?.status === 'done' ? 'ok' : task.displayStatus?.status === 'not_done' ? 'bad' : 'idle' %>">
                      <%= task.displayStatus?.status === 'done' ? '✓' : task.displayStatus?.status === 'not_done' ? '✕' : '○' %>
                    </span>
                    <% if (task.displayStatus && !task.displayStatusIsToday) { %>
                    <small class="muted"><%= task.displayStatusDay %></small>
                    <% } %>
                  </td>
                  <td data-label="Başlık" class="single-line-cell <%= task.canManage ? 'editable-cell' : '' %>" data-field="title" data-value="<%= task.title || '' %>"><strong><%= task.title %></strong></td>
                  <td data-label="Kategori" class="single-line-cell <%= task.canManage ? 'editable-cell' : '' %>" data-field="categoryId" data-value="<%= task.categoryId || '' %>"><%= task.categoryName %></td>
                  <td data-label="Tarih" class="task-meta <%= task.canManage ? 'editable-cell' : '' %>" data-field="singleDate" data-value="<%= task.singleDate || today %>"><%= task.scheduleText %></td>
                  <td data-label="Saat" class="single-line-cell <%= task.canManage ? 'editable-cell' : '' %>" data-field="estimatedTime" data-value="<%= task.estimatedTime || '' %>"><%= task.estimatedTime || '-' %></td>
                  <td data-label="Açıklama" class="single-line-cell <%= task.canManage ? 'editable-cell' : '' %>" data-field="description" data-value="<%= task.description || '' %>"><%= task.description || '-' %></td>
                  <td data-label="İşlem">
                    <div class="task-table-actions">
                      <form method="post" action="/student/tasks/<%= task.id %>/status">
                        <input type="hidden" name="status" value="done" />
                        <input type="hidden" name="note" value="<%= task.description || task.todayStatus?.note || task.displayStatus?.note || '' %>" />
                        <button type="submit" class="icon-btn ok" title="Yapıldı" aria-label="Yapıldı">
                          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M20 6L9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
                          </svg>
                        </button>
                      </form>
                      <form method="post" action="/student/tasks/<%= task.id %>/status">
                        <input type="hidden" name="status" value="not_done" />
                        <input type="hidden" name="note" value="<%= task.description || task.todayStatus?.note || task.displayStatus?.note || '' %>" />
                        <button type="submit" class="icon-btn bad" title="Yapılmadı" aria-label="Yapılmadı">
                          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M18 6L6 18M6 6l12 12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
                          </svg>
                        </button>
                      </form>
                      <% if (task.canManage) { %>
                      <form method="post" action="/student/tasks/<%= task.id %>/delete" onsubmit="return confirm('Bu görev silinsin mi?')">
                        <input type="hidden" name="next" value="/student/dashboard" />
                        <button type="submit" class="icon-btn danger" title="Sil" aria-label="Sil">
                          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M4 7h16M9 7V5h6v2m-8 0l1 12h8l1-12M10 11v6M14 11v6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
                          </svg>
                        </button>
                      </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <script>
            (() => {
              const titleInput = document.getElementById('studentTaskTitleFilter');
              const categoryInput = document.getElementById('studentTaskCategoryFilter');
              const dateInput = document.getElementById('studentTaskDateFilter');
              const rows = Array.from(document.querySelectorAll('.student-task-row'));
              const editableCells = Array.from(document.querySelectorAll('.student-task-row .editable-cell'));
              const categoryOptions = <%- JSON.stringify(categories.map((c) => ({ value: c.id, label: c.name }))) %>;
              if (!rows.length) return;

              const applyFilters = () => {
                const title = String((titleInput && titleInput.value) || '').toLowerCase().trim();
                const category = String((categoryInput && categoryInput.value) || '').toLowerCase().trim();
                const date = String((dateInput && dateInput.value) || '').toLowerCase().trim();

                rows.forEach((row) => {
                  const rowTitle = row.getAttribute('data-title') || '';
                  const rowCategory = row.getAttribute('data-category') || '';
                  const rowDate = row.getAttribute('data-date') || '';
                  const matchTitle = !title || rowTitle.includes(title);
                  const matchCategory = !category || rowCategory.includes(category);
                  const matchDate = !date || rowDate.includes(date);
                  row.hidden = !(matchTitle && matchCategory && matchDate);
                });
              };

              if (titleInput) titleInput.addEventListener('input', applyFilters);
              if (categoryInput) categoryInput.addEventListener('change', applyFilters);
              if (dateInput) dateInput.addEventListener('input', applyFilters);

              const escapeHtml = (value) =>
                String(value || '')
                  .replace(/&/g, '&amp;')
                  .replace(/</g, '&lt;')
                  .replace(/>/g, '&gt;')
                  .replace(/"/g, '&quot;')
                  .replace(/'/g, '&#39;');

              const refreshRowSearch = (row) => {
                const title = row.querySelector('[data-field="title"]')?.textContent || '';
                const category = row.querySelector('[data-field="categoryId"]')?.textContent || '';
                const date = row.querySelector('[data-field="singleDate"]')?.textContent || '';
                row.setAttribute('data-title', title.toLowerCase());
                row.setAttribute('data-category', category.toLowerCase());
                row.setAttribute('data-date', date.toLowerCase());
              };

              const finishEdit = (cell, originalMarkup) => {
                cell.classList.remove('is-editing');
                if (originalMarkup != null) {
                  cell.innerHTML = originalMarkup;
                }
              };

              const saveCell = async (cell, newValue, originalMarkup) => {
                if (cell.classList.contains('is-saving')) return;
                const row = cell.closest('.student-task-row');
                if (!row) return;
                const taskId = row.getAttribute('data-task-id');
                const field = cell.getAttribute('data-field');
                const previousValue = cell.getAttribute('data-value') || '';
                const normalized = String(newValue || '').trim();

                if (normalized === previousValue) {
                  finishEdit(cell, originalMarkup);
                  return;
                }

                cell.classList.add('is-saving');
                try {
                  const body = new URLSearchParams({ field, value: normalized });
                  const response = await fetch(`/student/tasks/${taskId}/cell-update`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
                    body
                  });
                  const data = await response.json();
                  if (!response.ok || !data.ok) {
                    throw new Error(data.error || 'Kayıt başarısız.');
                  }

                  cell.setAttribute('data-value', data.value || '');
                  if (field === 'title') {
                    cell.innerHTML = `<strong>${escapeHtml(data.display)}</strong>`;
                  } else {
                    cell.textContent = data.display || '-';
                  }
                  if (field === 'description') {
                    const noteInputs = Array.from(row.querySelectorAll('input[name="note"]'));
                    noteInputs.forEach((input) => {
                      input.value = data.value || '';
                    });
                  }
                  refreshRowSearch(row);
                  applyFilters();
                } catch (err) {
                  alert(err.message || 'Kayıt başarısız.');
                  finishEdit(cell, originalMarkup);
                } finally {
                  cell.classList.remove('is-saving');
                  cell.classList.remove('is-editing');
                }
              };

              editableCells.forEach((cell) => {
                cell.addEventListener('click', () => {
                  if (cell.classList.contains('is-editing')) return;

                  const field = cell.getAttribute('data-field');
                  const currentValue = cell.getAttribute('data-value') || '';
                  const originalMarkup = cell.innerHTML;
                  cell.classList.add('is-editing');

                  if (field === 'categoryId') {
                    const select = document.createElement('select');
                    select.className = 'cell-editor';
                    categoryOptions.forEach((item) => {
                      const option = document.createElement('option');
                      option.value = item.value;
                      option.textContent = item.label;
                      if (item.value === currentValue) option.selected = true;
                      select.appendChild(option);
                    });
                    cell.innerHTML = '';
                    cell.appendChild(select);
                    select.focus();
                    select.addEventListener('change', () => saveCell(cell, select.value, originalMarkup));
                    select.addEventListener('blur', () => {
                      if (!cell.classList.contains('is-saving')) {
                        finishEdit(cell, originalMarkup);
                      }
                    });
                    return;
                  }

                  const input = document.createElement('input');
                  input.className = 'cell-editor';
                  input.value = currentValue;
                  input.type = field === 'singleDate' ? 'date' : field === 'estimatedTime' ? 'time' : 'text';
                  cell.innerHTML = '';
                  cell.appendChild(input);
                  input.focus();
                  if (field !== 'singleDate' && field !== 'estimatedTime') input.select();

                  const commit = () => saveCell(cell, input.value, originalMarkup);
                  input.addEventListener('keydown', (event) => {
                    if (event.key === 'Enter') {
                      event.preventDefault();
                      commit();
                    }
                    if (event.key === 'Escape') {
                      finishEdit(cell, originalMarkup);
                    }
                  });
                  input.addEventListener('blur', commit);
                });
              });
            })();
          </script>
          <% } %>
        </section>

        <% } %>

        <% if (currentPage === 'calendar' && calendar) { %>
        <header class="content-header row space-between center">
          <div>
            <h2>Haftalık Takvim</h2>
            <p class="muted"><%= calendar.weekStart %> - <%= calendar.weekEnd %></p>
          </div>
          <div class="row">
            <a class="button-link" href="/student/calendar/export?weekStart=<%= calendar.weekStart %>">Excel İndir</a>
            <a class="button-link" href="/student/calendar?weekStart=<%= calendar.prevWeekStart %>">Önceki Hafta</a>
            <a class="button-link" href="/student/calendar?weekStart=<%= calendar.nextWeekStart %>">Sonraki Hafta</a>
          </div>
        </header>

        <section class="panel">
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Gün</th>
                  <th>Tarih</th>
                  <th>Görev</th>
                  <th>Tamamlanan</th>
                  <th>Soru</th>
                  <th>Süre (dk)</th>
                </tr>
              </thead>
              <tbody>
                <% calendar.days.forEach((d) => { %>
                <tr class="<%= d.dueCount > 0 && d.doneCount === d.dueCount ? 'day-ok' : d.doneCount > 0 ? 'day-partial' : d.dueCount > 0 ? 'day-bad' : '' %>">
                  <td><%= d.dayName %></td>
                  <td><%= d.date %></td>
                  <td><%= d.dueCount %></td>
                  <td><%= d.doneCount %></td>
                  <td><%= d.questionTotal %></td>
                  <td><%= d.durationMinutes %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>

        <section class="grid two">
          <% calendar.days.forEach((d) => { %>
          <article class="panel">
            <h3><%= d.dayName %> - <%= d.date %></h3>
            <% if (!d.tasks.length) { %>
            <p class="muted">Görev yok.</p>
            <% } %>
            <% if (d.tasks.length) { %>
            <ul class="clean-list">
              <% d.tasks.forEach((t) => { %>
              <li class="row space-between center">
                <span><%= t.title %></span>
                <span class="status-pill <%= t.status === 'done' ? 'ok' : t.status === 'not_done' ? 'bad' : 'idle' %>">
                  <%= t.status === 'done' ? 'Yapıldı' : t.status === 'not_done' ? 'Yapılmadı' : 'İşaretlenmedi' %>
                </span>
              </li>
              <% }) %>
            </ul>
            <% } %>
          </article>
          <% }) %>
        </section>
        <% } %>

        <% if (currentPage === 'questions') { %>
        <header class="content-header">
          <h2>Günlük Soru Takibi</h2>
          <p class="muted"><%= today %></p>
        </header>

        <section class="panel">
          <form method="post" action="/student/questions" class="grid two">
            <div class="stack">
              <label>Kategori</label>
              <select name="categoryId" required>
                <option value="">Seçiniz</option>
                <% categories.forEach((c) => { %>
                <option value="<%= c.id %>" <%= questionEntry?.categoryId === c.id ? 'selected' : '' %>><%= c.name %></option>
                <% }) %>
              </select>

              <label>Ders Adı</label>
              <input type="text" name="lessonName" value="<%= questionEntry?.lessonName || '' %>" required />

              <label>Tarih</label>
              <input type="date" name="day" value="<%= today %>" required />
            </div>

            <div class="stack">
              <label>Doğru</label>
              <input type="number" min="0" name="correctCount" value="<%= questionEntry?.correctCount ?? 0 %>" required />

              <label>Yanlış</label>
              <input type="number" min="0" name="wrongCount" value="<%= questionEntry?.wrongCount ?? 0 %>" required />

              <label>Süre (dakika)</label>
              <input type="number" min="0" name="durationMinutes" value="<%= questionEntry?.durationMinutes ?? 0 %>" required />

              <button type="submit">Kaydet</button>
            </div>
          </form>
        </section>

        <section class="panel">
          <h3>Son Kayıtlar</h3>
          <% if (!questionHistory.length) { %>
          <p class="muted">Henüz soru kaydı yok.</p>
          <% } %>
          <% if (questionHistory.length) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Tarih</th>
                  <th>Kategori</th>
                  <th>Ders Adı</th>
                  <th>Doğru</th>
                  <th>Yanlış</th>
                  <th>Toplam</th>
                  <th>Süre (dk)</th>
                </tr>
              </thead>
              <tbody>
                <% questionHistory.forEach((q) => { %>
                <tr>
                  <td><%= q.date %></td>
                  <td><%= q.categoryName || 'Kategori Yok' %></td>
                  <td><%= q.lessonName %></td>
                  <td><%= q.correctCount %></td>
                  <td><%= q.wrongCount %></td>
                  <td><%= q.totalCount %></td>
                  <td><%= q.durationMinutes %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </section>
        <% } %>

        <% if (currentPage === 'points') { %>
        <header class="content-header">
          <h2>Puan Geçmişi</h2>
          <p class="muted">Haftalık Ödül/Ceza: <strong><%= weeklyPointWeekStart %> - <%= weeklyPointWeekEnd %></strong></p>
        </header>

        <section class="panel">
          <form method="get" action="/student/points" class="row center">
            <a class="button-link" href="/student/points?weekStart=<%= weeklyPointPrevWeekStart %>">Önceki Hafta</a>
            <a class="button-link" href="/student/points?weekStart=<%= weeklyPointNextWeekStart %>">Sonraki Hafta</a>
            <label>Hafta Başlangıcı</label>
            <input type="date" name="weekStart" value="<%= weeklyPointWeekStart %>" required />
            <button type="submit">Haftayı Getir</button>
            <a class="button-link" href="/student/points/export-weekly?weekStart=<%= weeklyPointWeekStart %>">Haftalık Excel İndir</a>
          </form>
        </section>

        <section class="panel">
          <h3>Haftalık Ödül/Ceza Sonuçları</h3>
          <% if (!weeklyPointEvaluations.length) { %>
          <p class="muted">Seçili hafta için ödül/ceza değerlendirmesi bulunmuyor.</p>
          <% } %>
          <% if (weeklyPointEvaluations.length) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Kategori</th>
                  <th>Toplam Görev</th>
                  <th>Yapılan</th>
                  <th>Oran</th>
                  <th>Sonuç</th>
                  <th>Puan</th>
                  <th>Açıklama</th>
                </tr>
              </thead>
              <tbody>
                <% weeklyPointEvaluations.forEach((e) => { %>
                <tr>
                  <td><%= e.categoryName %></td>
                  <td><%= e.dueCount %></td>
                  <td><%= e.doneCount %></td>
                  <td>%<%= e.completionRate.toFixed(1) %></td>
                  <td><%= e.resultType === 'reward' ? 'Ödül' : e.resultType === 'penalty' ? 'Ceza' : 'Esik' %></td>
                  <td><%= e.pointsApplied %></td>
                  <td><%= e.reasonText || '-' %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </section>

        <section class="panel">
          <h3>Son Puan Kayıtları</h3>
          <ul class="clean-list">
            <% pointLogs.forEach((p) => { %>
            <li>
              <%= p.createdDate %> - <strong><%= p.type === 'reward' ? 'Ödül' : 'Ceza' %></strong>
              - <%= p.points %> puan - <%= p.reason %>
            </li>
            <% }) %>
          </ul>
        </section>
        <% } %>
      </section>
    </main>
  </body>
</html>
