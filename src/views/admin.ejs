            <input type="text" name="title" maxlength="200" placeholder="Örn. Python'da 3 proje bitir" required />
            <label>Açıklama (opsiyonel)</label>
            <textarea name="description" rows="2" maxlength="1000" placeholder="Hedefin ölçüsü ne? Neye bakınca başarıldı sayılacak?"></textarea>
            <button type="submit">Hedefi Ekle</button>
            <p class="muted">
              Aynı ay içinde aynı başlıkta ikinci hedef açılmaz.
            </p>
          </form>
        </section>
        <% } %>

        <% if (currentSection === 'hedefler') { %>
        <% if (!gv.goals.length) { %>
        <section class="panel narrow">
          <h3>Bu ay hedef yok</h3>
          <p class="muted"><%= gv.monthLabel %> için <%= gv.student.name %> adına henüz hedef girilmedi.</p>
        </section>
        <% } else { %>
        <% gv.goals.forEach((g) => { %>
        <section class="panel goal-card">
          <header class="row space-between center">
            <div>
              <h3><%= g.title %></h3>
              <% if (g.description) { %><p class="muted"><%= g.description %></p><% } %>
            </div>
            <span class="day-badge <%= g.status === 'achieved' ? 'ok' : g.status === 'missed' ? 'miss' : 'off' %>"><%= g.statusLabel %></span>
          </header>

          <form method="post" action="/admin/goals/<%= g.id %>/evaluate" class="stack">
            <input type="hidden" name="next" value="/admin/goals?bolum=hedefler&ay=<%= gv.monthStart.slice(0,7) %>&goalStudentId=<%= gv.student.id %>" />
            <label>Kanıt</label>
            <textarea name="evidence" rows="3" maxlength="2000" placeholder="Ne yapıldı, nereden görülüyor? (Başarıldı işaretlemek için zorunlu)"><%= g.evidence %></textarea>
            <label>Durum</label>
            <select name="status">
              <option value="pending" <%= g.status === 'pending' ? 'selected' : '' %>>Bekliyor</option>
              <option value="achieved" <%= g.status === 'achieved' ? 'selected' : '' %>>Başarıldı</option>
              <option value="missed" <%= g.status === 'missed' ? 'selected' : '' %>>Başarılamadı</option>
            </select>
            <div class="row space-between center">
              <p class="muted">
                <% if (g.evaluatedAt) { %>Son değerlendirme: <%= new Date(g.evaluatedAt).toLocaleDateString('tr-TR') %><% } else { %>Henüz değerlendirilmedi.<% } %>
