                        <% if (r.canClear) { %>
                        <button type="submit" name="action" value="clear" class="danger">Temizle</button>
                        <% } %>
                      </div>
                    </form>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
        <% } else { %>
        <section class="panel narrow">
          <h3>Kayıt yok</h3>
          <p class="muted">
            <%= sportAdmin.selected ? sportAdmin.selected.name : 'Bu öğrenci' %> için henüz rutin tanımlı değil. Önce
            <a href="/admin/sport?bolum=ayar">Rutin Ayarla</a> alanından bir hedef gir; günlük
            kayıtlar bundan sonra burada listelenir. Başka bir öğrencinin kayıtlarına
            <a href="/admin/sport?bolum=rutinler">Öğrenci Rutinleri</a> alanından geçebilirsin.
          </p>
        </section>
        <% } %>
        <% } %>
        <% } %>

