            </article>
            <article class="kpi">
              <span class="kpi-icon" aria-hidden="true"><%- menuIcons.analysis %></span>
              <p class="kpi-label">Tamamlama</p>
              <p class="kpi-value"><%= gv.facts.taskRate === null ? '-' : gv.facts.taskRate + '%' %></p>
            </article>
            <article class="kpi">
              <span class="kpi-icon" aria-hidden="true"><%- menuIcons.questions %></span>
              <p class="kpi-label">Çözülen Soru</p>
              <p class="kpi-value"><%= gv.facts.questionsSolved %></p>
            </article>
            <article class="kpi">
              <span class="kpi-icon" aria-hidden="true"><%- menuIcons.percent %></span>
              <p class="kpi-label">Doğruluk</p>
              <p class="kpi-value"><%= gv.facts.accuracy === null ? '-' : gv.facts.accuracy + '%' %></p>
            </article>
            <article class="kpi">
              <span class="kpi-icon" aria-hidden="true"><%- menuIcons.duration %></span>
              <p class="kpi-label">Çalışma Süresi</p>
              <p class="kpi-value"><%= gv.facts.duration %> dk</p>
            </article>
            <article class="kpi">
              <span class="kpi-icon" aria-hidden="true"><%- menuIcons.wake %></span>
              <p class="kpi-label">Zamanında Uyanma</p>
              <p class="kpi-value"><%= gv.facts.wakeOnTime %> / <%= gv.facts.wakeTracked %></p>
            </article>
            <article class="kpi">
              <span class="kpi-icon" aria-hidden="true"><%- menuIcons.sport %></span>
              <p class="kpi-label">Zamanında Spor</p>
              <p class="kpi-value"><%= gv.facts.sportOnTime %> / <%= gv.facts.sportTracked %></p>
            </article>
          </div>
        </section>
        <% } %>

        <% if (currentSection === 'ekle') { %>
        <section class="panel narrow">
          <h3>Yeni Hedef</h3>
          <form method="post" action="/admin/goals" class="stack">
            <input type="hidden" name="next" value="/admin/goals?bolum=hedefler&ay=<%= gv.monthStart.slice(0,7) %>&goalStudentId=<%= gv.student.id %>" />
            <input type="hidden" name="studentId" value="<%= gv.student.id %>" />
            <input type="hidden" name="monthStart" value="<%= gv.monthStart %>" />
