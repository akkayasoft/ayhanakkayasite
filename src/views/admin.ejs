            <a class="button-link" href="/admin/goals?bolum=<%= currentSection %>&ay=<%= gv.prevMonth.slice(0,7) %><%= gv.student ? `&goalStudentId=${gv.student.id}` : '' %>">Önceki Ay</a>
            <a class="button-link" href="/admin/goals?bolum=<%= currentSection %>&ay=<%= gv.nextMonth.slice(0,7) %><%= gv.student ? `&goalStudentId=${gv.student.id}` : '' %>">Sonraki Ay</a>
