<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Paneli</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="shell">
      <aside class="sidebar">
        <div>
          <p class="sidebar-kicker">Yonetim</p>
          <h1 class="sidebar-title">Ogrenci Takip</h1>
          <p class="sidebar-user"><strong><%= user.name %></strong></p>
        </div>

        <nav class="menu">
          <a href="/admin/dashboard" class="menu-link <%= currentPage === 'dashboard' ? 'active' : '' %>">Genel Durum</a>
          <a href="/admin/students" class="menu-link <%= currentPage === 'students' ? 'active' : '' %>">Ogrenciler</a>
          <a href="/admin/users" class="menu-link <%= currentPage === 'users' ? 'active' : '' %>">Kullanici Yonetimi</a>
          <a href="/admin/categories" class="menu-link <%= currentPage === 'categories' ? 'active' : '' %>">Kategoriler</a>
          <a href="/admin/tasks" class="menu-link <%= currentPage === 'tasks' ? 'active' : '' %>">Gorevler</a>
          <a href="/admin/points" class="menu-link <%= currentPage === 'points' ? 'active' : '' %>">Puan Islemleri</a>
          <a href="/admin/reports" class="menu-link <%= currentPage === 'reports' ? 'active' : '' %>">Raporlar</a>
        </nav>

        <form method="post" action="/logout" class="sidebar-logout">
          <button type="submit" class="ghost">Cikis</button>
        </form>
      </aside>

      <section class="content">
        <% if (message) { %>
        <div class="alert success"><%= message %></div>
        <% } %>
        <% if (error) { %>
        <div class="alert error"><%= error %></div>
        <% } %>

        <% if (currentPage === 'dashboard') { %>
        <header class="content-header">
          <h2>Genel Durum</h2>
          <p class="muted">Gunluk performans ozeti - <strong><%= today %></strong></p>
        </header>

        <section class="kpi-grid">
          <article class="kpi"><p class="kpi-label">Ogrenci</p><p class="kpi-value"><%= students.length %></p></article>
          <article class="kpi"><p class="kpi-label">Aktif Gorev</p><p class="kpi-value"><%= activeTasks.length %></p></article>
          <article class="kpi"><p class="kpi-label">Arsiv Gorev</p><p class="kpi-value"><%= archivedTasks.length %></p></article>
          <article class="kpi"><p class="kpi-label">Kategori</p><p class="kpi-value"><%= categories.length %></p></article>
        </section>

        <section class="panel">
          <h3>Bugunluk Ogrenci Durumu</h3>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Ogrenci</th>
                  <th>Toplam Puan</th>
                  <th>Bugun Gorev</th>
                  <th>Tamamlanan</th>
                  <th>Gunluk Soru</th>
                </tr>
              </thead>
              <tbody>
                <% dailyBoard.forEach((row) => { %>
                <tr>
                  <td><%= row.name %></td>
                  <td><%= row.points || 0 %></td>
                  <td><%= row.dueCount %></td>
                  <td><%= row.doneCount %></td>
                  <td><%= row.questionCount %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
        <% } %>

        <% if (currentPage === 'students') { %>
        <header class="content-header">
          <h2>Ogrenci Yonetimi</h2>
        </header>
        <section class="grid two">
          <article class="panel">
            <h3>Yeni Ogrenci</h3>
            <form method="post" action="/admin/students" class="stack">
              <input type="hidden" name="next" value="/admin/students" />
              <label>Ad Soyad</label>
              <input type="text" name="name" required />
              <label>Kullanici Adi</label>
              <input type="text" name="username" required />
              <label>Sifre</label>
              <input type="text" name="password" minlength="6" required />
              <button type="submit">Kaydet</button>
            </form>
          </article>

          <article class="panel">
            <h3>Mevcut Ogrenciler</h3>
            <ul class="clean-list">
              <% students.forEach((s) => { %>
              <li><strong><%= s.name %></strong> (@<%= s.username %>) - Puan: <%= s.points || 0 %></li>
              <% }) %>
            </ul>
          </article>
        </section>
        <% } %>

        <% if (currentPage === 'users') { %>
        <header class="content-header">
          <h2>Kullanici Yonetimi</h2>
          <p class="muted">Toplam kullanici: <strong><%= users.length %></strong> | Admin: <strong><%= adminCount %></strong></p>
        </header>

        <section class="grid two">
          <article class="panel">
            <h3>Yeni Kullanici</h3>
            <form method="post" action="/admin/users" class="stack">
              <input type="hidden" name="next" value="/admin/users" />
              <label>Ad Soyad</label>
              <input type="text" name="name" required />
              <label>Kullanici Adi</label>
              <input type="text" name="username" required />
              <label>Sifre</label>
              <input type="text" name="password" minlength="6" required />
              <label>Rol</label>
              <select name="role" required>
                <option value="student">Ogrenci</option>
                <option value="admin">Admin</option>
              </select>
              <button type="submit">Kullanici Ekle</button>
            </form>
          </article>

          <article class="panel">
            <h3>Kullanim Notlari</h3>
            <ul class="clean-list">
              <li>Son admin hesabi silinemez veya ogrenciye dusurulemez.</li>
              <li>Kendi hesabinizin rolunu veya silme islemini bu ekrandan yapamazsiniz.</li>
              <li>Sifre guncellemede minimum 6 karakter zorunludur.</li>
            </ul>
          </article>
        </section>

        <section class="panel">
          <h3>Mevcut Kullanicilar</h3>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Ad Soyad</th>
                  <th>Kullanici Adi</th>
                  <th>Rol</th>
                  <th>Puan</th>
                  <th>Sifre</th>
                  <th>Sil</th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach((u) => { %>
                <tr>
                  <td><%= u.name %> <%= u.id === user.id ? '(Siz)' : '' %></td>
                  <td>@<%= u.username %></td>
                  <td>
                    <form method="post" action="/admin/users/<%= u.id %>/role" class="row center">
                      <input type="hidden" name="next" value="/admin/users" />
                      <select name="role" <%= u.id === user.id ? 'disabled' : '' %>>
                        <option value="student" <%= u.role === 'student' ? 'selected' : '' %>>Ogrenci</option>
                        <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
                      </select>
                      <% if (u.id !== user.id) { %>
                      <button type="submit">Guncelle</button>
                      <% } %>
                    </form>
                  </td>
                  <td><%= u.points || 0 %></td>
                  <td>
                    <form method="post" action="/admin/users/<%= u.id %>/password" class="row center">
                      <input type="hidden" name="next" value="/admin/users" />
                      <input type="text" name="password" minlength="6" placeholder="Yeni sifre" required />
                      <button type="submit">Sifre Degistir</button>
                    </form>
                  </td>
                  <td>
                    <% if (u.id !== user.id) { %>
                    <form method="post" action="/admin/users/<%= u.id %>/delete" onsubmit="return confirm('Bu kullanici silinsin mi?')">
                      <input type="hidden" name="next" value="/admin/users" />
                      <button type="submit" class="danger">Sil</button>
                    </form>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
        <% } %>

        <% if (currentPage === 'categories') { %>
        <header class="content-header">
          <h2>Kategori Yonetimi</h2>
        </header>
        <section class="grid two">
          <article class="panel">
            <h3>Yeni Kategori</h3>
            <form method="post" action="/admin/categories" class="stack">
              <input type="hidden" name="next" value="/admin/categories" />
              <label>Kategori Adi</label>
              <input type="text" name="name" required />
              <button type="submit">Ekle</button>
            </form>
          </article>

          <article class="panel">
            <h3>Kategori Listesi</h3>
            <ul class="clean-list">
              <% categories.forEach((c) => { %>
              <li class="row space-between center">
                <span><%= c.name %></span>
                <form method="post" action="/admin/categories/<%= c.id %>/delete" onsubmit="return confirm('Kategori silinsin mi?')">
                  <input type="hidden" name="next" value="/admin/categories" />
                  <button type="submit" class="danger">Sil</button>
                </form>
              </li>
              <% }) %>
            </ul>
          </article>
        </section>
        <% } %>

        <% if (currentPage === 'tasks') { %>
        <% const tasksPagePath = activeTaskFilters.studentId ? `/admin/tasks?activeTaskStudentId=${activeTaskFilters.studentId}` : '/admin/tasks'; %>
        <header class="content-header">
          <h2>Gorev Yonetimi</h2>
        </header>

        <section class="panel">
          <details>
            <summary class="summary-toggle"><strong>Yeni Gorev Olustur</strong></summary>
            <form method="post" action="/admin/tasks" class="grid two">
              <input type="hidden" name="next" value="<%= tasksPagePath %>" />
              <div class="stack">
                <label>Gorev Basligi</label>
                <input type="text" name="title" required />

                <label>Aciklama</label>
                <textarea name="description"></textarea>

                <label>Kategori</label>
                <select name="categoryId" required>
                  <option value="">Seciniz</option>
                  <% categories.forEach((c) => { %>
                  <option value="<%= c.id %>"><%= c.name %></option>
                  <% }) %>
                </select>

                <label>Ogrenci</label>
                <select name="studentId" required>
                  <option value="">Seciniz</option>
                  <% students.forEach((s) => { %>
                  <option value="<%= s.id %>"><%= s.name %></option>
                  <% }) %>
                </select>
              </div>

              <div class="stack">
                <label>Tekrar Tipi</label>
                <select name="repeatType" required>
                  <option value="once">Tek Seferlik</option>
                  <option value="daily">Her Gun</option>
                  <option value="weekly">Haftalik</option>
                  <option value="monthly">Aylik</option>
                  <option value="custom">Ozel Tarihler</option>
                </select>

                <label>Tek Seferlik Tarih</label>
                <input type="date" name="singleDate" />

                <label>Haftalik Gun (0-6)</label>
                <input type="number" min="0" max="6" name="weeklyDay" />

                <label>Aylik Gun (1-31)</label>
                <input type="number" min="1" max="31" name="monthlyDay" />

                <label>Ozel Tarihler (YYYY-MM-DD, virgulle)</label>
                <input type="text" name="customDates" placeholder="2026-05-10,2026-05-20" />

                <label>Baslangic Tarihi</label>
                <input type="date" name="startDate" />

                <label>Bitis Tarihi</label>
                <input type="date" name="endDate" />

                <button type="submit">Gorevi Kaydet</button>
              </div>
            </form>
          </details>
        </section>

        <section class="panel">
          <div class="datatable-toolbar">
            <form method="get" action="/admin/tasks" class="row center">
              <label for="activeTaskStudentId">Ogrenci</label>
              <select id="activeTaskStudentId" name="activeTaskStudentId">
                <option value="">Tum Ogrenciler</option>
                <% students.forEach((s) => { %>
                <option value="<%= s.id %>" <%= activeTaskFilters.studentId === s.id ? 'selected' : '' %>><%= s.name %></option>
                <% }) %>
              </select>
              <button type="submit">Filtrele</button>
              <% if (activeTaskFilters.studentId) { %>
              <a class="button-link" href="/admin/tasks">Temizle</a>
              <% } %>
            </form>
            <div class="datatable-search">
              <label for="taskSearchInput">Tabloda Ara</label>
              <input id="taskSearchInput" type="text" placeholder="Baslik, konu, ogrenci, kategori..." />
            </div>
          </div>

          <% if (!activeTasks.length) { %>
          <p class="muted">Aktif gorev yok.</p>
          <% } %>
          <% if (activeTasks.length) { %>
          <form id="bulkTaskForm" method="post" action="/admin/tasks/bulk-update" class="grid two">
            <input type="hidden" name="next" value="<%= tasksPagePath %>" />
            <div class="stack">
              <h4>Toplu Guncelle</h4>
              <label>Yeni Kategori (opsiyonel)</label>
              <select name="categoryId">
                <option value="">Degistirme</option>
                <% categories.forEach((c) => { %>
                <option value="<%= c.id %>"><%= c.name %></option>
                <% }) %>
              </select>

              <label>Yeni Ogrenci (opsiyonel)</label>
              <select name="studentId">
                <option value="">Degistirme</option>
                <% students.forEach((s) => { %>
                <option value="<%= s.id %>"><%= s.name %></option>
                <% }) %>
              </select>

              <label>Arsiv Islemi</label>
              <select name="archiveAction">
                <option value="keep">Degistirme</option>
                <option value="archive">Arsive Al</option>
                <option value="unarchive">Arsivden Cikar</option>
              </select>
            </div>

            <div class="stack">
              <label>Yeni Tekrar Tipi (opsiyonel)</label>
              <select name="repeatType">
                <option value="">Degistirme</option>
                <option value="once">Tek Seferlik</option>
                <option value="weekly">Haftalik</option>
                <option value="monthly">Aylik</option>
                <option value="custom">Ozel Tarihler</option>
              </select>

              <label>Tek Seferlik Tarih</label>
              <input type="date" name="singleDate" />

              <label>Haftalik Gun (0-6)</label>
              <input type="number" min="0" max="6" name="weeklyDay" />

              <label>Aylik Gun (1-31)</label>
              <input type="number" min="1" max="31" name="monthlyDay" />

              <label>Ozel Tarihler (YYYY-MM-DD, virgulle)</label>
              <input type="text" name="customDates" placeholder="2026-05-10,2026-05-20" />

              <label>Baslangic Tarihi (opsiyonel)</label>
              <input type="date" name="startDate" />

              <label>Bitis Tarihi (opsiyonel)</label>
              <input type="date" name="endDate" />

              <button type="submit">Secili Gorevleri Guncelle</button>
              <p class="muted">Toplu guncelleme sadece secili gorevlere uygulanir.</p>
            </div>
          </form>

          <div class="table-wrap">
            <table class="task-table" id="adminTasksTable">
              <thead>
                <tr>
                  <th><input id="bulkSelectAll" type="checkbox" /></th>
                  <th>Baslik</th>
                  <th>Konu</th>
                  <th>Ogrenci</th>
                  <th>Kategori</th>
                  <th>Tarih</th>
                  <th>Islem</th>
                </tr>
              </thead>
              <tbody>
                <% activeTasks.forEach((t) => { %>
                <% const rowSearchText = `${t.title || ''} ${t.description || ''} ${t.student ? t.student.name : ''} ${t.category ? t.category.name : ''}`.toLowerCase(); %>
                <tr class="task-data-row" data-task-id="<%= t.id %>" data-search="<%= rowSearchText %>">
                  <td><input type="checkbox" name="taskIds" value="<%= t.id %>" form="bulkTaskForm" /></td>
                  <td class="editable-cell" data-field="title" data-value="<%= t.title || '' %>"><strong><%= t.title %></strong></td>
                  <td class="editable-cell" data-field="description" data-value="<%= t.description || '' %>"><%= t.description || '-' %></td>
                  <td class="editable-cell" data-field="studentId" data-value="<%= t.studentId || '' %>"><%= t.student ? t.student.name : 'Ogrenci yok' %></td>
                  <td class="editable-cell" data-field="categoryId" data-value="<%= t.categoryId || '' %>"><%= t.category ? t.category.name : 'Kategori yok' %></td>
                  <td><%= t.dateText %></td>
                  <td>
                    <div class="task-table-actions">
                      <form method="post" action="/admin/tasks/<%= t.id %>/delete" onsubmit="return confirm('Gorev kalici olarak silinsin mi?')">
                        <input type="hidden" name="next" value="<%= tasksPagePath %>" />
                        <button type="submit" class="danger">Sil</button>
                      </form>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <script>
            (() => {
              const selectAll = document.getElementById('bulkSelectAll');
              const checkboxes = Array.from(
                document.querySelectorAll('input[name="taskIds"][form="bulkTaskForm"]')
              );
              const searchInput = document.getElementById('taskSearchInput');
              const dataRows = Array.from(document.querySelectorAll('.task-data-row'));
              const editableCells = Array.from(document.querySelectorAll('.editable-cell'));
              const studentOptions = <%- JSON.stringify(students.map((s) => ({ value: s.id, label: s.name }))) %>;
              const categoryOptions = <%- JSON.stringify(categories.map((c) => ({ value: c.id, label: c.name }))) %>;

              const syncHeader = () => {
                if (!selectAll) return;
                selectAll.checked = checkboxes.length > 0 && checkboxes.every((input) => input.checked);
              };

              if (selectAll) {
                selectAll.addEventListener('change', () => {
                  checkboxes.forEach((input) => {
                    input.checked = selectAll.checked;
                  });
                });
              }

              checkboxes.forEach((input) => {
                input.addEventListener('change', syncHeader);
              });

              const applySearch = () => {
                const term = String((searchInput && searchInput.value) || '').toLowerCase().trim();
                dataRows.forEach((row) => {
                  const text = row.getAttribute('data-search') || '';
                  const visible = !term || text.includes(term);
                  row.hidden = !visible;
                });
              };

              if (searchInput) {
                searchInput.addEventListener('input', applySearch);
              }

              const escapeHtml = (value) =>
                String(value || '')
                  .replace(/&/g, '&amp;')
                  .replace(/</g, '&lt;')
                  .replace(/>/g, '&gt;')
                  .replace(/"/g, '&quot;')
                  .replace(/'/g, '&#39;');

              const refreshRowSearch = (row) => {
                const title = row.querySelector('[data-field="title"]')?.textContent || '';
                const desc = row.querySelector('[data-field="description"]')?.textContent || '';
                const student = row.querySelector('[data-field="studentId"]')?.textContent || '';
                const category = row.querySelector('[data-field="categoryId"]')?.textContent || '';
                row.setAttribute('data-search', `${title} ${desc} ${student} ${category}`.toLowerCase());
              };

              const finishEdit = (cell, originalMarkup) => {
                cell.classList.remove('is-editing');
                if (originalMarkup != null) {
                  cell.innerHTML = originalMarkup;
                }
              };

              const saveCell = async (cell, newValue, displayValue, originalMarkup) => {
                if (cell.classList.contains('is-saving')) return;
                const row = cell.closest('.task-data-row');
                if (!row) return;
                const taskId = row.getAttribute('data-task-id');
                const field = cell.getAttribute('data-field');
                const oldValue = cell.getAttribute('data-value') || '';
                const normalized = String(newValue || '').trim();

                if (normalized === oldValue) {
                  finishEdit(cell, originalMarkup);
                  return;
                }

                cell.classList.add('is-saving');
                try {
                  const body = new URLSearchParams({ field, value: normalized });
                  const response = await fetch(`/admin/tasks/${taskId}/cell-update`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
                    body
                  });
                  const data = await response.json();
                  if (!response.ok || !data.ok) {
                    throw new Error(data.error || 'Kayit basarisiz.');
                  }

                  cell.setAttribute('data-value', data.value || '');
                  if (field === 'title') {
                    cell.innerHTML = `<strong>${escapeHtml(data.display)}</strong>`;
                  } else {
                    cell.textContent = data.display || '-';
                  }
                  refreshRowSearch(row);
                } catch (err) {
                  alert(err.message || 'Kayit basarisiz.');
                  if (field === 'title') {
                    cell.innerHTML = `<strong>${escapeHtml(oldValue)}</strong>`;
                  } else if (field === 'description') {
                    cell.textContent = oldValue || '-';
                  } else {
                    cell.textContent = displayValue;
                  }
                } finally {
                  cell.classList.remove('is-saving');
                  cell.classList.remove('is-editing');
                }
              };

              editableCells.forEach((cell) => {
                cell.addEventListener('click', () => {
                  if (cell.classList.contains('is-editing')) return;

                  const field = cell.getAttribute('data-field');
                  const currentValue = cell.getAttribute('data-value') || '';
                  const currentDisplay = cell.textContent.trim();
                  const originalMarkup = cell.innerHTML;
                  cell.classList.add('is-editing');

                  if (field === 'studentId' || field === 'categoryId') {
                    const options = field === 'studentId' ? studentOptions : categoryOptions;
                    const select = document.createElement('select');
                    select.className = 'cell-editor';
                    options.forEach((item) => {
                      const option = document.createElement('option');
                      option.value = item.value;
                      option.textContent = item.label;
                      if (item.value === currentValue) option.selected = true;
                      select.appendChild(option);
                    });
                    cell.innerHTML = '';
                    cell.appendChild(select);
                    select.focus();
                    select.addEventListener('change', () => {
                      const selected = options.find((item) => item.value === select.value);
                      saveCell(cell, select.value, selected ? selected.label : currentDisplay, originalMarkup);
                    });
                    select.addEventListener('blur', () => {
                      if (!cell.classList.contains('is-saving')) {
                        finishEdit(cell, originalMarkup);
                      }
                    });
                    return;
                  }

                  const input = document.createElement('input');
                  input.type = 'text';
                  input.className = 'cell-editor';
                  input.value = currentValue;
                  cell.innerHTML = '';
                  cell.appendChild(input);
                  input.focus();
                  input.select();

                  const commit = () => saveCell(cell, input.value, currentDisplay, originalMarkup);
                  input.addEventListener('keydown', (event) => {
                    if (event.key === 'Enter') {
                      event.preventDefault();
                      commit();
                    }
                    if (event.key === 'Escape') {
                      finishEdit(cell, originalMarkup);
                    }
                  });
                  input.addEventListener('blur', commit);
                });
              });
            })();
          </script>
          <% } %>
        </section>
        <% } %>

        <% if (currentPage === 'points') { %>
        <header class="content-header">
          <h2>Puan Islemleri</h2>
          <p class="muted">Hafta: <strong><%= weeklyRuleWeekStart %> - <%= weeklyRuleWeekEnd %></strong></p>
          <div class="row">
            <a class="button-link" href="/admin/points?weekStart=<%= weeklyRulePrevWeekStart %><%= weeklyEvalFilters.studentId ? `&weeklyEvalStudentId=${weeklyEvalFilters.studentId}` : '' %>">Onceki Hafta</a>
            <a class="button-link" href="/admin/points?weekStart=<%= weeklyRuleNextWeekStart %><%= weeklyEvalFilters.studentId ? `&weeklyEvalStudentId=${weeklyEvalFilters.studentId}` : '' %>">Sonraki Hafta</a>
            <a class="button-link" href="/admin/points/export-weekly?weekStart=<%= weeklyRuleWeekStart %><%= weeklyEvalFilters.studentId ? `&weeklyEvalStudentId=${weeklyEvalFilters.studentId}` : '' %>">Excel Indir</a>
          </div>
        </header>
        <section class="grid two">
          <article class="panel">
            <h3>Odul / Ceza Uygula</h3>
            <form method="post" action="/admin/points" class="stack">
              <input type="hidden" name="next" value="/admin/points" />
              <input type="hidden" name="weekStart" value="<%= weeklyRuleWeekStart %>" />
              <label>Ogrenci</label>
              <select name="studentId" required>
                <option value="">Seciniz</option>
                <% students.forEach((s) => { %>
                <option value="<%= s.id %>"><%= s.name %></option>
                <% }) %>
              </select>

              <label>Islem Tipi</label>
              <select name="type" required>
                <option value="reward">Odul</option>
                <option value="penalty">Ceza</option>
              </select>

              <label>Puan</label>
              <input type="number" name="points" min="1" required />

              <label>Gerekce</label>
              <input type="text" name="reason" required />

              <button type="submit">Uygula</button>
            </form>
          </article>

          <article class="panel">
            <h3>Haftalik Kategori Odul/Ceza Tanimla</h3>
            <form method="post" action="<%= weeklyRuleForm.action %>" class="stack">
              <input type="hidden" name="next" value="/admin/points" />
              <label>Hafta Baslangici</label>
              <input type="date" name="weekStart" value="<%= weeklyRuleForm.weekStart %>" required />

              <label>Ogrenci</label>
              <select name="studentId" required>
                <option value="">Seciniz</option>
                <% students.forEach((s) => { %>
                <option value="<%= s.id %>" <%= weeklyRuleForm.studentId === s.id ? 'selected' : '' %>><%= s.name %></option>
                <% }) %>
              </select>

              <label>Kategori</label>
              <select name="categoryId" required>
                <option value="">Seciniz</option>
                <% categories.forEach((c) => { %>
                <option value="<%= c.id %>" <%= weeklyRuleForm.categoryId === c.id ? 'selected' : '' %>><%= c.name %></option>
                <% }) %>
              </select>

              <label>Odul Puani (>%80)</label>
              <input type="number" name="rewardPoints" min="0" value="<%= weeklyRuleForm.rewardPoints %>" required />

              <label>Odul Aciklamasi</label>
              <input type="text" name="rewardLabel" value="<%= weeklyRuleForm.rewardLabel %>" placeholder="Orn: Haftalik Matematik Odulu" />

              <label>Ceza Puani (%80 alti)</label>
              <input type="number" name="penaltyPoints" min="0" value="<%= weeklyRuleForm.penaltyPoints %>" required />

              <label>Ceza Aciklamasi</label>
              <input type="text" name="penaltyLabel" value="<%= weeklyRuleForm.penaltyLabel %>" placeholder="Orn: Haftalik Matematik Cezasi" />

              <button type="submit"><%= weeklyRuleForm.submitText %></button>
              <% if (weeklyRuleForm.isEdit) { %>
              <a class="button-link" href="/admin/points?weekStart=<%= weeklyRuleWeekStart %>">Vazgec</a>
              <% } %>
            </form>
          </article>
        </section>

        <section class="panel">
          <h3>Haftalik Kurallar</h3>
          <% if (!weeklyRules.length) { %>
          <p class="muted">Bu hafta icin kategori kurali tanimlanmamis.</p>
          <% } %>
          <% if (weeklyRules.length) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Ogrenci</th>
                  <th>Kategori</th>
                  <th>Odul Puani</th>
                  <th>Odul Aciklamasi</th>
                  <th>Ceza Puani</th>
                  <th>Ceza Aciklamasi</th>
                  <th>Islem</th>
                </tr>
              </thead>
              <tbody>
                <% weeklyRules.forEach((r) => { %>
                <tr>
                  <td><%= r.studentName || 'Tum Ogrenciler' %></td>
                  <td><%= r.categoryName %></td>
                  <td><%= r.rewardPoints %></td>
                  <td><%= r.rewardLabel || '-' %></td>
                  <td><%= r.penaltyPoints %></td>
                  <td><%= r.penaltyLabel || '-' %></td>
                  <td>
                    <div class="task-table-actions">
                      <a class="button-link" href="/admin/points?weekStart=<%= weeklyRuleWeekStart %>&weeklyRuleEditId=<%= r.id %>">Guncelle</a>
                      <form method="post" action="/admin/weekly-rules/<%= r.id %>/delete" onsubmit="return confirm('Bu haftalik kural silinsin mi?')">
                        <input type="hidden" name="next" value="/admin/points" />
                        <input type="hidden" name="weekStart" value="<%= weeklyRuleWeekStart %>" />
                        <button type="submit" class="danger">Sil</button>
                      </form>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </section>

        <section class="panel">
          <h3>Haftalik Degerlendirme</h3>
          <form method="post" action="/admin/weekly-evaluations/run" class="row center">
            <input type="hidden" name="next" value="/admin/points" />
            <label>Hafta Baslangici</label>
            <input type="date" name="weekStart" value="<%= weeklyRuleWeekStart %>" required />
            <label>Ogrenci</label>
            <select name="studentId">
              <option value="">Tum Ogrenciler</option>
              <% students.forEach((s) => { %>
              <option value="<%= s.id %>" <%= weeklyEvalFilters.studentId === s.id ? 'selected' : '' %>><%= s.name %></option>
              <% }) %>
            </select>
            <button type="submit">Haftalik Orana Gore Puanla</button>
          </form>
          <p class="muted">Kural: %80 ustu odul, %80 alti ceza, %80 esiginde puan uygulanmaz.</p>
        </section>

        <section class="panel">
          <h3>Haftalik Degerlendirme Sonuclari</h3>
          <form method="get" action="/admin/points" class="row center">
            <input type="hidden" name="weekStart" value="<%= weeklyRuleWeekStart %>" />
            <label>Ogrenci</label>
            <select name="weeklyEvalStudentId">
              <option value="">Tum Ogrenciler</option>
              <% students.forEach((s) => { %>
              <option value="<%= s.id %>" <%= weeklyEvalFilters.studentId === s.id ? 'selected' : '' %>><%= s.name %></option>
              <% }) %>
            </select>
            <button type="submit">Filtrele</button>
          </form>
          <% if (!weeklyEvaluations.length) { %>
          <p class="muted">Secili hafta ve filtre icin degerlendirme kaydi yok.</p>
          <% } %>
          <% if (weeklyEvaluations.length) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Ogrenci</th>
                  <th>Kategori</th>
                  <th>Toplam Gorev</th>
                  <th>Yapilan</th>
                  <th>Oran</th>
                  <th>Sonuc</th>
                  <th>Puan</th>
                  <th>Aciklama</th>
                </tr>
              </thead>
              <tbody>
                <% weeklyEvaluations.forEach((e) => { %>
                <tr>
                  <td><%= e.studentName %></td>
                  <td><%= e.categoryName %></td>
                  <td><%= e.dueCount %></td>
                  <td><%= e.doneCount %></td>
                  <td>%<%= e.completionRate.toFixed(1) %></td>
                  <td>
                    <%= e.resultType === 'reward' ? 'Odul' : e.resultType === 'penalty' ? 'Ceza' : 'Esik' %>
                  </td>
                  <td><%= e.pointsApplied %></td>
                  <td><%= e.reasonText || '-' %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </section>

        <section class="panel">
          <h3>Son Puan Kayitlari</h3>
          <ul class="clean-list">
            <% pointLogs.forEach((p) => { %>
            <li>
              <%= p.createdDate %> - <strong><%= p.type === 'reward' ? 'Odul' : 'Ceza' %></strong>
              - <%= p.points %> puan - <%= p.reason %>
            </li>
            <% }) %>
          </ul>
        </section>
        <% } %>

        <% if (currentPage === 'reports') { %>
        <header class="content-header">
          <h2>Performans Raporlari</h2>
        </header>
        <section class="panel">
          <form method="get" action="/admin/reports" class="grid three">
            <div class="stack">
              <label>Ogrenci</label>
              <select name="reportStudentId" required>
                <option value="">Seciniz</option>
                <% students.forEach((s) => { %>
                <option value="<%= s.id %>" <%= reportFilters.studentId === s.id ? 'selected' : '' %>><%= s.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="stack">
              <label>Baslangic</label>
              <input type="date" name="reportFrom" value="<%= reportFilters.fromDate %>" required />
            </div>
            <div class="stack">
              <label>Bitis</label>
              <input type="date" name="reportTo" value="<%= reportFilters.toDate %>" required />
            </div>
            <div class="stack"><button type="submit">Rapor Getir</button></div>
          </form>

          <% if (reportError) { %>
          <div class="alert error"><%= reportError %></div>
          <% } %>

          <% if (report) { %>
          <p>
            <strong><%= report.student.name %></strong> icin <%= report.fromDate %> - <%= report.toDate %>
            donemi tamamlanma orani: <strong>%<%= report.completionRate %></strong>
          </p>
          <p class="muted">
            Toplam Gorev: <%= report.totals.due %> | Tamamlanan: <%= report.totals.done %> |
            Soru: <%= report.totals.questions %> | Puan Degisimi: <%= report.totals.pointDelta %>
          </p>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Tarih</th>
                  <th>Gorev</th>
                  <th>Yapildi</th>
                  <th>Yapilmadi</th>
                  <th>Soru</th>
                  <th>Puan Delta</th>
                </tr>
              </thead>
              <tbody>
                <% report.rows.forEach((r) => { %>
                <tr>
                  <td><%= r.date %></td>
                  <td><%= r.dueCount %></td>
                  <td><%= r.doneCount %></td>
                  <td><%= r.notDoneCount %></td>
                  <td><%= r.questionCount %></td>
                  <td><%= r.pointDelta %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </section>
        <% } %>
      </section>
    </main>
  </body>
</html>
