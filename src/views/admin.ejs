        <% if (ydsProgramView) { %>
        <section class="panel">
          <h3>Çalışma Programı</h3>
          <p class="muted">
            Kaynak: <%= ydsProgramView.kaynak %> · Sürüm <%= ydsProgramView.surum %> ·
            <%= ydsProgramView.baslangic %> - <%= ydsProgramView.bitis %> ·
            günde ~<%= ydsProgramView.gunlukDakika %> dk
          </p>
          <p class="muted">
            <%= ydsProgramView.toplamParca %> içerik parçası
            <%= ydsProgramView.dersGunu %> ders gününe yayıldı:
            <strong><%= ydsProgramView.doluGun %> gün</strong> içerikli,
            <strong><%= ydsProgramView.bekleyenGun %> gün</strong> içerik bekliyor.
            Bekleyen günlere konu uydurulmaz; yalnızca günlük çalışma görevi açılır.
            İçerik büyüyünce programı yeniden üretip aynı düğmeye bas — yeni içerik
            boş günlere yerleşir, geçmiş günler oynamaz.
          </p>

          <section class="kpi-grid">
            <article class="kpi">
              <p class="kpi-label">Programdaki Görev</p>
              <p class="kpi-value"><%= ydsProgramView.total %></p>
            </article>
            <article class="kpi">
              <p class="kpi-label">Aktarılan</p>
              <p class="kpi-value"><%= ydsProgramView.imported %></p>
            </article>
            <article class="kpi">
              <p class="kpi-label">Bekleyen</p>
              <p class="kpi-value"><%= ydsProgramView.pending %></p>
            </article>
          </section>

          <div class="table-wrap">
            <table class="stack-mobile">
              <thead>
                <tr>
                  <th>Kategori</th>
                  <th>Görev</th>
                  <th>Aktarılan</th>
                  <th>Toplam Süre</th>
                </tr>
              </thead>
              <tbody>
                <% ydsProgramView.turler.forEach((t) => { %>
                <tr>
                  <td><%= t.ad %></td>
                  <td><%= t.total %></td>
                  <td><%= t.imported %> / <%= t.total %></td>
                  <td><%= Math.round(t.sure / 60) %> saat</td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <% if (ydsView.student) { %>
          <form
            method="post"
            action="/admin/yds/program-import"
            class="stack"
            onsubmit="return confirm('<%= ydsProgramView.pending %> görev <%= ydsView.student.name %> adlı öğrencinin görevlerine eklensin mi?')"
          >
            <input type="hidden" name="next" value="/admin/yds" />
            <button type="submit" <%= ydsProgramView.pending === 0 ? 'disabled' : '' %>>
              <%= ydsProgramView.pending === 0 ? 'Aktarılacak yeni görev yok' : 'Görevlere Aktar' %>
            </button>
          </form>
          <% } %>
        </section>

        <section class="panel">
          <h3>Yaklaşan Görevler</h3>
          <% if (!ydsProgramView.upcoming.length) { %>
          <p class="muted">Bugünden sonraya planlanmış görev kalmadı.</p>
          <% } else { %>
          <div class="table-wrap">
            <table class="stack-mobile">
              <thead>
                <tr>
                  <th>Tarih</th>
                  <th>Gün</th>
                  <th>Tür</th>
                  <th>Başlık</th>
                  <th>Süre</th>
                  <th>Durum</th>
                </tr>
              </thead>
              <tbody>
                <% ydsProgramView.upcoming.forEach((g) => { %>
                <tr>
                  <td><%= g.tarih %></td>
                  <td><%= g.gunAdi %></td>
                  <td><%= g.turAdi %></td>
                  <td><%= g.baslik %><% if (g.tekrar) { %> <span class="muted">(<%= g.tekrar %>. tekrar)</span><% } %></td>
                  <td><%= g.sure %> dk</td>
                  <td>
                    <% if (g.imported) { %>
                    <span class="day-badge ok">Aktarıldı</span>
                    <% } else { %>
                    <span class="day-badge off">Bekliyor</span>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </section>
        <% } %>

        <section class="panel">
          <h3>Son <%= ydsView.gunSayisi %> Gün</h3>
          <p class="muted">
            Doğruluk yalnızca <strong>puanlı</strong> testlerden hesaplanır; YDS tarafında
            dilbilgisi testleri puansız olduğu için çözülen soruların bir kısmı doğruluk
            paydasına girmez.
          </p>
          <% if (!ydsView.rows.length) { %>
          <p class="muted">Bu aralıkta kayıt yok.</p>
          <% } else { %>
          <div class="table-wrap">
            <table class="stack-mobile">
              <thead>
                <tr>
                  <th>Tarih</th>
                  <th>Gün</th>
                  <th>Okuma</th>
                  <th>Kelime</th>
                  <th>Gramer</th>
                  <th>Test</th>
                  <th>Kelime Kartı</th>
                  <th>Çözülen</th>
                  <th>Puanlı</th>
                  <th>Doğruluk</th>
                  <th>Hedef</th>
                </tr>
              </thead>
              <tbody>
                <% ydsView.rows.forEach((r) => { %>
                <tr>
                  <td><%= r.date %></td>
                  <td><%= r.gunAdi %></td>
                  <td><%= r.readings %></td>
                  <td><%= r.decks %></td>
                  <td><%= r.lessons %></td>
                  <td><%= r.quizzes %></td>
                  <td><%= r.wordsLearned %></td>
                  <td><%= r.questionsSolved %></td>
                  <td><%= r.scoredQuestions %></td>
                  <td><%= r.accuracy === null ? '-' : r.accuracy + '%' %></td>
                  <td>
                    <% if (r.goalMet) { %>
                    <span class="day-badge ok">Tuttu</span>
                    <% } else { %>
                    <span class="day-badge off">Eksik</span>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </section>
        <% } %>
        <% } %>

        <% if (currentPage === 'schedule' && scheduleView) { %>
        <header class="content-header row space-between center">
          <div>
            <h2>Ders Programı</h2>
            <p class="muted">
              <% if (scheduleView.gorunum === 'konular') { %>
              Haftalık işlenen konular. Çizelgeyle aynı ızgara; dersi olan her saate
              o hafta işlediğin konuyu yazarsın. Tatil ve bayram günlerinde alan açılmaz.
              <% } else { %>
              Haftalık ders çizelgen. Zil saatleri elle girilmez — başlangıç saati ve
              süreler verilir, her ders saatinin saati bunlardan hesaplanır.
              Program Haftalık Takvim'de de görünür; tatil ve bayram günlerinde işlemez.
              <% } %>
            </p>
          </div>
          <div class="row">
            <a class="button-link <%= scheduleView.gorunum === 'cizelge' ? 'active' : '' %>" href="/admin/schedule">Çizelge</a>
            <a class="button-link <%= scheduleView.gorunum === 'konular' ? 'active' : '' %>" href="/admin/schedule?gorunum=konular">İşlenen Konular</a>
          </div>
        </header>

        <% if (scheduleView.gorunum === 'cizelge') { %>
        <section class="kpi-grid">
          <article class="kpi">
            <p class="kpi-label">Haftalık Ders</p>
            <p class="kpi-value"><%= scheduleView.toplamDers %></p>
          </article>
          <article class="kpi">
            <p class="kpi-label">Günün Bitişi</p>
            <p class="kpi-value"><%= scheduleView.bitisSaati %></p>
          </article>
          <article class="kpi">
            <p class="kpi-label">Günlük Ders Saati</p>
            <p class="kpi-value"><%= scheduleView.ayar.periodCount %></p>
          </article>
          <% if (scheduleView.toplamNobet) { %>
          <article class="kpi">
            <p class="kpi-label">Nöbet</p>
            <p class="kpi-value"><%= scheduleView.toplamNobet %></p>
          </article>
          <% } %>
        </section>

        <section class="grid two">
          <article class="panel">
            <h3><%= scheduleView.form.isEdit ? 'Dersi Düzenle' : 'Ders Ekle' %></h3>
            <form method="post" action="/admin/schedule/entry" class="stack">
              <input type="hidden" name="next" value="/admin/schedule" />
              <label>Gün</label>
              <select name="dayOfWeek" required>
                <option value="">Seçin</option>
                <% [1,2,3,4,5].forEach((g) => { %>
                <option value="<%= g %>" <%= String(scheduleView.form.dayOfWeek) === String(g) ? 'selected' : '' %>><%= ['','Pazartesi','Salı','Çarşamba','Perşembe','Cuma'][g] %></option>
                <% }) %>
              </select>

              <label>Ders Saati</label>
              <select name="period" required>
                <option value="">Seçin</option>
                <% scheduleView.saatler.forEach((s) => { %>
                <option value="<%= s.period %>" <%= String(scheduleView.form.period) === String(s.period) ? 'selected' : '' %>><%= s.period %>. ders (<%= s.start %> - <%= s.end %>)</option>
                <% }) %>
              </select>

              <label>Ders Adı</label>
              <input type="text" name="subject" required value="<%= scheduleView.form.subject %>" placeholder="Mobil Uygulamalar" />

              <label>Sınıf / Şube</label>
              <input type="text" name="className" value="<%= scheduleView.form.className %>" placeholder="11-A" />

              <label>Derslik</label>
              <input type="text" name="room" value="<%= scheduleView.form.room %>" placeholder="Lab 2" />

              <label>Tür</label>
              <select name="kind">
                <option value="lesson" <%= scheduleView.form.kind === 'lesson' ? 'selected' : '' %>>Ders</option>
                <option value="duty" <%= scheduleView.form.kind === 'duty' ? 'selected' : '' %>>Nöbet</option>
              </select>

              <button type="submit">Kaydet</button>
              <p class="muted">
                Dolu bir saate tekrar kaydedersen üstüne yazılır; önce silmene gerek yok.
              </p>
            </form>
          </article>

          <article class="panel">
            <h3>Zil Çizelgesi</h3>
            <form method="post" action="/admin/schedule/settings" class="stack">
              <input type="hidden" name="next" value="/admin/schedule" />
              <label>İlk Ders Başlangıcı</label>
              <input type="time" name="startTime" required value="<%= scheduleView.ayar.startTime %>" />

              <label>Ders Süresi (dk)</label>
              <input type="number" name="lessonMinutes" min="10" max="120" required value="<%= scheduleView.ayar.lessonMinutes %>" />

              <label>Teneffüs (dk)</label>
              <input type="number" name="breakMinutes" min="0" max="60" required value="<%= scheduleView.ayar.breakMinutes %>" />

              <label>Günlük Ders Saati Sayısı</label>
              <input type="number" name="periodCount" min="1" max="16" required value="<%= scheduleView.ayar.periodCount %>" />

              <label>Öğle Arası Hangi Dersten Sonra</label>
              <input type="number" name="lunchAfterPeriod" min="1" max="16" value="<%= scheduleView.ayar.lunchAfterPeriod === null ? '' : scheduleView.ayar.lunchAfterPeriod %>" placeholder="boş = öğle arası yok" />

              <label>Öğle Arası (dk)</label>
              <input type="number" name="lunchMinutes" min="0" max="180" required value="<%= scheduleView.ayar.lunchMinutes %>" />

              <button type="submit">Zil Çizelgesini Kaydet</button>
              <p class="muted">
                Şu anki ayarla gün <strong><%= scheduleView.ayar.startTime %> - <%= scheduleView.bitisSaati %></strong>
                arası. Bitiş saati tutmuyorsa süreleri değiştir.
                <% if (scheduleView.ayar.isDefault) { %><br />Henüz kaydedilmedi, varsayılan gösteriliyor.<% } %>
              </p>
            </form>
          </article>
        </section>

        <section class="panel">
          <h3>Toplu Yapıştır</h3>
          <p class="muted">
            Programı satır satır yapıştır: <strong>gün · ders saati · ders adı · sınıf · derslik</strong>.
            Son iki sütun isteğe bağlı. Ayraç fark etmez (sekme, virgul, noktalı virgül veya boşluk),
            Excel'den kopyala-yapıştır da olur.
          </p>
          <form method="post" action="/admin/schedule/paste" class="stack">
            <input type="hidden" name="next" value="/admin/schedule" />
            <textarea name="metin" rows="8" class="paste-box" placeholder="Pazartesi&#9;1-2&#9;Mobil Uygulamalar&#9;11-A&#9;Lab 2
Pazartesi&#9;5&#9;Nesne Tabanlı Programlama&#9;12-B&#9;D-104
Salı&#9;3-4&#9;Veritabanı&#9;10-C&#9;D-201
Çarşamba&#9;1-3&#9;Web Tasarım&#9;9-A&#9;Lab 1
Cuma&#9;8&#9;Nöbet"></textarea>

            <ul class="clean-list muted paste-hints">
              <li><strong>Blok ders:</strong> <code>1-2</code> ya da <code>2/4</code> yazarsan her saate ayrı ayrı işlenir.</li>
              <li><strong>Gün adı:</strong> tam ad ya da kısaltma (<code>Pzt</code>, <code>Sal</code>, <code>Çar</code>, <code>Per</code>, <code>Cum</code>).</li>
              <li><strong>Nöbet:</strong> ders adına <code>Nöbet</code> yaz, otomatik nöbet olarak işaretlenir.</li>
              <li><code>#</code> ile başlayan satırlar not sayılır, atlanır.</li>
              <li>
                <strong>Sınıf ve derslik yazacaksan</strong> alanları sekme, virgül ya da
                <strong>iki boşlukla</strong> ayır. Tek boşlukla yazarsan
                <code>Pazartesi 9 Ek Ders 11-C</code> satırında ders adı
                "Ek Ders 11-C" olur — sınıf ayrı alana geçmez.
              </li>
              <li>Dolu bir hücreye denk gelen satır üstüne yazar. Anlaşılmayan satır varsa kaç tane olduğu ve ilki mesajda bildirilir.</li>
            </ul>

            <label class="row center">
              <input type="checkbox" name="temizle" value="on" />
              <span>Önce mevcut programı tamamen temizle</span>
            </label>

            <button type="submit">Yapıştırılanı İşle</button>
          </form>
        </section>

        <section class="panel">
          <h3>Haftalık Çizelge</h3>
          <p class="muted">Boş hücredeki <strong>+</strong> ile o gün/saate ders eklersin; dolu hücreye tıklayınca düzenlersin.</p>
          <% const gunAdlari = ['','Pazartesi','Salı','Çarşamba','Perşembe','Cuma']; %>
          <div class="table-wrap">
            <div class="board" style="--gun-sayisi: 5; --saat-sayisi: <%= scheduleView.izgara.length %>">
              <div class="board-corner">Saat</div>
              <% scheduleView.izgara.forEach((satir, i) => { %>
              <div class="board-time <%= satir.lunchAfter ? 'lunch-after' : '' %>" style="--s: <%= i + 2 %>">
                <span class="period-no"><%= satir.period %>.</span>
                <span class="period-time"><%= satir.start %><br /><%= satir.end %></span>
              </div>
              <% }) %>

              <% [1,2,3,4,5].forEach((g) => { %>
              <h4 class="board-dayhead" style="--g: <%= g + 1 %>"><%= gunAdlari[g] %></h4>
              <% scheduleView.izgara.forEach((satir, i) => { const h = satir.hucreler[g - 1]; %>
              <div
                class="board-cell <%= h.entry ? (h.entry.kind === 'duty' ? 'duty' : 'filled') : 'empty' %> <%= satir.lunchAfter ? 'lunch-after' : '' %>"
                style="--g: <%= g + 1 %>; --s: <%= i + 2 %>"
              >
                <span class="board-cell-time"><%= satir.period %>. ders · <%= satir.start %>-<%= satir.end %></span>
                <% if (h.entry) { %>
                <a class="cell-link" href="/admin/schedule?duzenle=<%= h.entry.id %>">
                  <strong><%= h.entry.subject %></strong>
                  <% if (h.entry.className) { %><span><%= h.entry.className %></span><% } %>
                  <% if (h.entry.room) { %><span class="muted"><%= h.entry.room %></span><% } %>
                </a>
                <form method="post" action="/admin/schedule/entry/<%= h.entry.id %>/delete" onsubmit="return confirm('Bu ders kaydı silinsin mi?')">
                  <input type="hidden" name="next" value="/admin/schedule" />
                  <button type="submit" class="danger cell-delete" title="Sil">×</button>
                </form>
                <% } else { %>
                <a class="cell-add" href="/admin/schedule?gun=<%= h.dayOfWeek %>&saat=<%= satir.period %>" title="<%= h.gunAdi %> <%= satir.period %>. ders">+</a>
                <% } %>
              </div>
              <% }) %>
              <% }) %>
            </div>
          </div>
        </section>

        <section class="panel">
          <h3>Gün Özeti</h3>
          <div class="table-wrap">
            <table class="stack-mobile">
              <thead>
                <tr><th>Gün</th><th>Ders</th><th>Boş Saat</th><th>Nöbet</th></tr>
              </thead>
              <tbody>
                <% scheduleView.gunSayilari.forEach((g) => { %>
                <tr>
                  <td><%= g.gunAdi %></td>
                  <td><%= g.dersSayisi %></td>
                  <td><%= g.bosSaat %></td>
                  <td><% if (g.nobet) { %><span class="day-badge off">Var</span><% } else { %>-<% } %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% if (scheduleView.kayitlar.length) { %>
          <form method="post" action="/admin/schedule/clear" class="stack" onsubmit="return confirm('Tüm ders programı silinsin mi? Zil çizelgesi ayarları kalır.')">
            <input type="hidden" name="next" value="/admin/schedule" />
            <button type="submit" class="danger">Programı Boşalt</button>
          </form>
          <% } %>
        </section>
        <% } %>

        <% if (scheduleView.gorunum === 'konular' && scheduleView.topicWeek) { %>
        <% const tw = scheduleView.topicWeek; %>
        <header class="content-header row space-between center">
          <div>
            <h3><%= tw.weekStart %> - <%= tw.weekEnd %></h3>
            <p class="muted">
              <%= tw.academic.yearLabel %><% if (tw.academic.termLabel) { %> · <%= tw.academic.termLabel %><% } %><%
              if (tw.academic.weekNo) { %> · <%= tw.academic.weekNo %>. Hafta<% } %>
              &nbsp;·&nbsp; <%= tw.dolu %> / <%= tw.yazilabilir %> ders saati yazıldı
            </p>
          </div>
          <div class="row">
            <a class="button-link" href="/admin/schedule?gorunum=konular&hafta=<%= tw.thisWeekStart %>">Bu Hafta</a>
            <a class="button-link" href="/admin/schedule?gorunum=konular&hafta=<%= tw.prevWeekStart %>">Önceki Hafta</a>
            <a class="button-link" href="/admin/schedule?gorunum=konular&hafta=<%= tw.nextWeekStart %>">Sonraki Hafta</a>
          </div>
        </header>

        <% if (!scheduleView.kayitlar.length) { %>
        <section class="panel narrow">
          <h3>Çizelge boş</h3>
          <p class="muted">
            Önce <a href="/admin/schedule">Çizelge</a> sekmesinden ders programını gir;
            konu yazılacak ders saatleri oradan gelir.
          </p>
        </section>
        <% } else { %>
        <form method="post" action="/admin/schedule/topics">
          <input type="hidden" name="next" value="/admin/schedule?gorunum=konular&hafta=<%= tw.weekStart %>" />
          <input type="hidden" name="weekStart" value="<%= tw.weekStart %>" />

          <section class="panel">
            <div class="table-wrap">
              <div class="board topic-board" style="--gun-sayisi: <%= tw.gunler.length %>; --saat-sayisi: <%= tw.izgara.length %>">
                <div class="board-corner">Saat</div>
                <% tw.izgara.forEach((satir, i) => { %>
                <div class="board-time <%= satir.lunchAfter ? 'lunch-after' : '' %>" style="--s: <%= i + 2 %>">
                  <span class="period-no"><%= satir.period %>.</span>
                  <span class="period-time"><%= satir.start %><br /><%= satir.end %></span>
                </div>
                <% }) %>

                <% tw.gunler.forEach((g, gi) => { %>
                <h4 class="board-dayhead" style="--g: <%= gi + 2 %>">
                  <%= g.gunAdi %>
                  <span class="th-sub"><%= g.tarih.slice(5) %></span>
                  <% if (!g.isSchoolDay) { %><span class="day-badge off"><%= g.dayLabel %></span><% } %>
                </h4>
                <% tw.izgara.forEach((satir, i) => { const h = satir.hucreler[gi]; %>
                <div
                  class="board-cell <%= h.entry && h.isSchoolDay ? 'filled' : 'empty' %> <%= h.entry && !h.isSchoolDay ? 'off-day' : '' %> <%= satir.lunchAfter ? 'lunch-after' : '' %>"
                  style="--g: <%= gi + 2 %>; --s: <%= i + 2 %>"
                >
                  <span class="board-cell-time"><%= satir.period %>. ders · <%= satir.start %>-<%= satir.end %></span>
                  <% if (h.entry && h.isSchoolDay) { %>
                  <p class="topic-head">
                    <strong><%= h.entry.subject %></strong>
                    <% if (h.entry.className) { %><span class="muted"><%= h.entry.className %></span><% } %>
                  </p>
                  <textarea
                    name="konu[<%= h.dayOfWeek %>-<%= satir.period %>]"
                    rows="2"
                    placeholder="İşlenen konu"
                  ><%= h.topic %></textarea>
                  <% if (!h.topic && h.oncekiTopic) { %>
                  <p class="topic-prev muted">geçen hafta: <%= h.oncekiTopic %></p>
                  <% } %>
                  <% } else if (h.entry && !h.isSchoolDay) { %>
                  <p class="muted topic-off"><%= h.dayLabel %></p>
                  <% } %>
                </div>
                <% }) %>
                <% }) %>
              </div>
            </div>

            <div class="row space-between center topic-actions">
              <p class="muted">
                Boş bıraktığın alanın kaydı silinir. Nöbet saatleri de yazılabilir.
              </p>
              <button type="submit">Haftayı Kaydet</button>
            </div>
          </section>
        </form>

        <section class="panel narrow">
          <h3>Defter Görevleri</h3>
          <p class="muted">
            Her okul haftası için tek görev: <strong>"Ders defterini doldur"</strong>.
            O haftanın tüm ders saatlerine konu girilince görev <strong>otomatik
            "yapıldı"</strong> işaretlenir. Görev haftanın son gününe (pazar)
            tarihlenir — cumartesi doldurmak da sayılsın diye.
          </p>
          <% if (tw.logTask) { %>
          <p class="muted">
            Bu haftanın görevi <strong><%= tw.logTask.studentName %></strong> için açık ·
            <% if (tw.logTask.status === 'done') { %>
            <span class="day-badge ok">Yapıldı</span>
            <% } else if (tw.logTask.status === 'not_done') { %>
            <span class="day-badge miss">Yapılmadı</span>
            <% } else { %>
            <span class="day-badge off">Bekliyor</span> — <%= tw.dolu %> / <%= tw.yazilabilir %> yazıldı
            <% } %>
          </p>
          <% } %>
          <% if (!students.length) { %>
          <p class="muted">Önce bir öğrenci ekleyin.</p>
          <% } else { %>
          <form method="post" action="/admin/schedule/log-tasks" class="stack">
            <input type="hidden" name="next" value="/admin/schedule?gorunum=konular" />
            <label>Öğrenci</label>
            <select name="studentId" required>
              <% students.forEach((st) => { %>
              <option value="<%= st.id %>" <%= tw.logTask && tw.logTask.studentName === st.name ? 'selected' : '' %>><%= st.name %></option>
              <% }) %>
            </select>
            <button type="submit">Defter Görevlerini Oluştur</button>
            <p class="muted">
              Öğretim yılındaki tüm okul haftaları için açılır; tekrar basmak
              yalnızca eksikleri tamamlar. Çizelge değişirse başlıklar tazelenir —
              ama işaretlenmiş ve günü geçmiş görevler asla oynatılmaz.
            </p>
          </form>
          <% } %>
        </section>

        <section class="panel narrow">
          <h3>Defteri Kim Yazabilir</h3>
          <p class="muted">
            Ders defteri uygulama genelinde <strong>tek kayıttır</strong> ve
            öğretmenin defteridir; öğrenciler onu normalde yalnızca okur.
            Aşağıda işaretlediğin öğrenci hesabı defteri <strong>kendi
            panelinden</strong> de yazabilir — sen hem admin hem öğrenci olarak
            giriyorsan hesap değiştirmek zorunda kalmazsın.
          </p>
          <% if (!scheduleView.ogrenciler.length) { %>
          <p class="muted">Henüz öğrenci yok.</p>
          <% } else { %>
          <ul class="teacher-list">
            <% scheduleView.ogrenciler.forEach((st) => { %>
            <li>
              <span>
                <strong><%= st.name %></strong>
                <% if (st.isTeacher) { %><span class="day-badge ok">Defteri yazabilir</span><% } %>
              </span>
              <form method="post" action="/admin/schedule/teacher">
                <input type="hidden" name="next" value="/admin/schedule?gorunum=konular" />
                <input type="hidden" name="studentId" value="<%= st.id %>" />
                <input type="hidden" name="isTeacher" value="<%= st.isTeacher ? '0' : '1' %>" />
                <button type="submit" class="ghost">
                  <%= st.isTeacher ? 'Yetkiyi kaldır' : 'Yetki ver' %>
                </button>
              </form>
            </li>
            <% }) %>
          </ul>
          <% } %>
        </section>

        <section class="panel narrow">
          <h3>Excel Çıktısı</h3>
          <p class="muted">
            Seçtiğin aralıktaki tüm işlenen konular tek dosyada iner: tarih, gün,
            ders saati, ders, sınıf ve konu. İkinci sayfada sınıf bazında özet var.
            Varsayılan aralık <strong><%= tw.exportLabel %></strong>.
          </p>
          <form method="get" action="/admin/schedule/topics/export" class="stack">
            <input type="hidden" name="next" value="/admin/schedule?gorunum=konular" />
            <label>Başlangıç</label>
            <input type="date" name="from" value="<%= tw.exportFrom %>" />
            <label>Bitiş</label>
            <input type="date" name="to" value="<%= tw.exportTo %>" />
            <button type="submit">Excel İndir</button>
          </form>
        </section>
        <% } %>
        <% } %>
        <% } %>

        <% if (currentPage === 'reports') { %>
        <header class="content-header">
          <h2>Performans Raporları</h2>
        </header>
        <section class="panel">
          <form method="get" action="/admin/reports" class="grid three">
            <div class="stack">
              <label>Öğrenci</label>
              <select name="reportStudentId" required>
                <option value="">Seçiniz</option>
                <% students.forEach((s) => { %>
                <option value="<%= s.id %>" <%= reportFilters.studentId === s.id ? 'selected' : '' %>><%= s.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="stack">
              <label>Başlangıç</label>
              <input type="date" name="reportFrom" value="<%= reportFilters.fromDate %>" required />
            </div>
            <div class="stack">
              <label>Bitiş</label>
              <input type="date" name="reportTo" value="<%= reportFilters.toDate %>" required />
            </div>
            <div class="stack"><button type="submit">Rapor Getir</button></div>
          </form>

          <% if (reportError) { %>
          <div class="alert error"><%= reportError %></div>
          <% } %>

          <% if (report) { %>
          <p>
            <strong><%= report.student.name %></strong> için <%= report.fromDate %> - <%= report.toDate %>
            dönemi tamamlanma oranı: <strong>%<%= report.completionRate %></strong>
          </p>
          <p class="muted">
            Toplam Görev: <%= report.totals.due %> | Tamamlanan: <%= report.totals.done %> |
            Soru: <%= report.totals.questions %>
          </p>

          <div class="table-wrap">
            <table class="stack-mobile">
              <thead>
                <tr>
                  <th>Tarih</th>
                  <th>Görev</th>
                  <th>Yapıldı</th>
                  <th>Yapılmadı</th>
                  <th>Soru</th>
                </tr>
              </thead>
              <tbody>
                <% report.rows.forEach((r) => { %>
                <tr>
                  <td><%= r.date %></td>
                  <td><%= r.dueCount %></td>
                  <td><%= r.doneCount %></td>
                  <td><%= r.notDoneCount %></td>
                  <td><%= r.questionCount %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </section>
        <% } %>
      </section>
    </main>
    <script>
      // Mobilde tablolar karta doner (bkz. .stack-mobile). Kartta sutun basligi
      // gorunmedigi icin her hucreye etiketi buradan yaziyoruz - her <td>'ye
      // elle data-label yazmak yerine basliktan turetiyoruz. Betik calismazsa
      // tablo eskisi gibi yatay kaydirilir, icerik kaybolmaz.
      (() => {
        for (const tablo of document.querySelectorAll('table.stack-mobile')) {
          const basliklar = [...tablo.querySelectorAll('thead th')].map((th) =>
            th.textContent.trim()
          );
          if (!basliklar.length) continue;
          for (const satir of tablo.querySelectorAll('tbody tr')) {
            [...satir.children].forEach((hucre, i) => {
              const etiket = basliklar[i];
              if (etiket && !hucre.hasAttribute('data-label')) {
                hucre.setAttribute('data-label', etiket);
              }
            });
          }
        }
      })();
    </script>
  </body>
</html>

