          <p class="muted">Önce bir öğrenci ekleyin.</p>
          <% } else { %>
          <form method="post" action="/admin/sport" class="stack">
            <input type="hidden" name="next" value="/admin/sport?bolum=rutinler" />
            <label>Öğrenci</label>
            <select name="studentId" required>
              <% students.forEach((st) => { %>
              <option value="<%= st.id %>" <%= sa.selected && sa.selected.id === st.id ? 'selected' : '' %>><%= st.name %></option>
