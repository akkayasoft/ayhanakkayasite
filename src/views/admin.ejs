                      <form method="post" action="/admin/sport/delete" onsubmit="return confirm('Rutin kaldırılsın mı? Geçmiş kayıtlar silinmez.')">
                        <input type="hidden" name="next" value="/admin/sport?bolum=rutinler" />
                        <input type="hidden" name="studentId" value="<%= r.student.id %>" />
                        <button type="submit" class="danger">Kaldır</button>
                      </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
        <% } %>

        <% if (currentSection === 'kayitlar') { %>
        <% if (sa.detail && sa.detail.routine) { %>
        <section class="panel">
          <h3><%= sa.selected.name %> — Son <%= sa.detail.summary.gunSayisi %> Gün</h3>
          <p class="muted">
            Zamanında <%= sa.detail.summary.onTime %> · Geç <%= sa.detail.summary.late %> ·
