                    <span class="day-badge off">Bekliyor</span>
                    <% } else { %>
                    <span class="muted">-</span>
                    <% } %>
                    <% if (r.correctionText) { %>
                    <small class="muted status-fix-trace"><%= r.correctionText %></small>
                    <% } %>
                  </td>
                  <td>
                    <form method="post" action="/admin/routines/sport/log" class="status-fix-form">
                      <input type="hidden" name="next" value="/admin/sport?bolum=kayitlar&sportStudentId=<%= sa.selected.id %>" />
                      <input type="hidden" name="studentId" value="<%= sa.selected.id %>" />
                      <input type="hidden" name="day" value="<%= r.day %>" />
                      <input type="time" name="time" value="<%= r.doneAt || '' %>" aria-label="<%= r.day %> spor saati" />
                      <input type="text" name="note" maxlength="300" placeholder="Gerekçe (opsiyonel)" />
                      <div class="task-table-actions">
                        <button type="submit" name="action" value="set">Kaydet</button>
                        <% if (r.status !== 'missed') { %>
                        <button type="submit" name="action" value="missed">Yapılmadı</button>
