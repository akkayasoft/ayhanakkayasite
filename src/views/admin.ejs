              <p class="kpi-value"><%= gv.facts.accuracy === null ? '-' : gv.facts.accuracy + '%' %></p>
            </article>
            <article class="kpi">
              <span class="kpi-icon" aria-hidden="true"><%- menuIcons.duration %></span>
              <p class="kpi-label">Çalışma Süresi</p>
              <p class="kpi-value"><%= gv.facts.duration %> dk</p>
            </article>
            <article class="kpi">
              <span class="kpi-icon" aria-hidden="true"><%- menuIcons.wake %></span>
              <p class="kpi-label">Zamanında Uyanma</p>
              <p class="kpi-value"><%= gv.facts.wakeOnTime %> / <%= gv.facts.wakeTracked %></p>
            </article>
            <article class="kpi">
              <span class="kpi-icon" aria-hidden="true"><%- menuIcons.sport %></span>
              <p class="kpi-label">Zamanında Spor</p>
              <p class="kpi-value"><%= gv.facts.sportOnTime %> / <%= gv.facts.sportTracked %></p>
            </article>
          </div>
        </section>

        <section class="panel narrow">
          <h3>Yeni Hedef</h3>
          <form method="post" action="/admin/goals" class="stack">
            <input type="hidden" name="next" value="/admin/goals?ay=<%= gv.monthStart.slice(0,7) %>&goalStudentId=<%= gv.student.id %>" />
            <input type="hidden" name="studentId" value="<%= gv.student.id %>" />
            <input type="hidden" name="monthStart" value="<%= gv.monthStart %>" />
            <label>Hedef</label>
            <input type="text" name="title" maxlength="200" placeholder="Örn. Python'da 3 proje bitir" required />
            <label>Açıklama (opsiyonel)</label>
            <textarea name="description" rows="2" maxlength="1000" placeholder="Hedefin ölçüsü ne? Neye bakınca başarıldı sayılacak?"></textarea>
            <button type="submit">Hedefi Ekle</button>
            <p class="muted">
              Aynı ay içinde aynı başlıkta ikinci hedef açılmaz.
            </p>
          </form>
        </section>

        <% if (!gv.goals.length) { %>
        <section class="panel narrow">
          <h3>Bu ay hedef yok</h3>
          <p class="muted"><%= gv.monthLabel %> için <%= gv.student.name %> adına henüz hedef girilmedi.</p>
        </section>
        <% } else { %>
        <% gv.goals.forEach((g) => { %>
        <section class="panel goal-card">
          <header class="row space-between center">
            <div>
              <h3><%= g.title %></h3>
              <% if (g.description) { %><p class="muted"><%= g.description %></p><% } %>
            </div>
            <span class="day-badge <%= g.status === 'achieved' ? 'ok' : g.status === 'missed' ? 'miss' : 'off' %>"><%= g.statusLabel %></span>
          </header>

          <form method="post" action="/admin/goals/<%= g.id %>/evaluate" class="stack">
            <input type="hidden" name="next" value="/admin/goals?ay=<%= gv.monthStart.slice(0,7) %>&goalStudentId=<%= gv.student.id %>" />
            <label>Kanıt</label>
            <textarea name="evidence" rows="3" maxlength="2000" placeholder="Ne yapıldı, nereden görülüyor? (Başarıldı işaretlemek için zorunlu)"><%= g.evidence %></textarea>
            <label>Durum</label>
            <select name="status">
              <option value="pending" <%= g.status === 'pending' ? 'selected' : '' %>>Bekliyor</option>
              <option value="achieved" <%= g.status === 'achieved' ? 'selected' : '' %>>Başarıldı</option>
              <option value="missed" <%= g.status === 'missed' ? 'selected' : '' %>>Başarılamadı</option>
            </select>
            <div class="row space-between center">
              <p class="muted">
                <% if (g.evaluatedAt) { %>Son değerlendirme: <%= new Date(g.evaluatedAt).toLocaleDateString('tr-TR') %><% } else { %>Henüz değerlendirilmedi.<% } %>
              </p>
              <button type="submit">Kaydet</button>
            </div>
          </form>

          <form method="post" action="/admin/goals/<%= g.id %>/delete" onsubmit="return confirm('Bu hedef silinsin mi?')">
            <input type="hidden" name="next" value="/admin/goals?ay=<%= gv.monthStart.slice(0,7) %>&goalStudentId=<%= gv.student.id %>" />
            <button type="submit" class="danger">Hedefi Sil</button>
          </form>
        </section>
        <% }) %>
        <% } %>
        <% } %>
        <% } %>

        <% if (currentPage === 'sport' && sportAdmin) { %>
        <% const sa = sportAdmin; %>
        <header class="content-header">
          <h2>Spor Rutini</h2>
          <p class="muted">
            Uyanma rutininin kardeşi: öğrenci her gün tek dokunuşla işaretler,
            basılan saat kaydedilir. Hedef tek saat değil bir <strong>aralıktır</strong>
            (varsayılan <%= sa.defaults.startTime %> - <%= sa.defaults.endTime %>).
            Aralık bitişine kadar basmak <strong>zamanında</strong>, sonrası
            <strong>geç</strong> (saatiyle) sayılır; hiç basılmayan gün ertesi gün
            otomatik <strong>yapılmadı</strong> mühürlenir. Erken yapmak geç kalmak
            değildir — gecikme aralık <em>başlangıcına</em> göre ölçülür.
          </p>
        </header>

        <section class="panel narrow">
          <h3>Rutin Ayarla</h3>
          <% if (!students.length) { %>
          <p class="muted">Önce bir öğrenci ekleyin.</p>
          <% } else { %>
          <form method="post" action="/admin/sport" class="stack">
            <input type="hidden" name="next" value="/admin/sport" />
            <label>Öğrenci</label>
            <select name="studentId" required>
              <% students.forEach((st) => { %>
              <option value="<%= st.id %>" <%= sa.selected && sa.selected.id === st.id ? 'selected' : '' %>><%= st.name %></option>
              <% }) %>
            </select>

            <label>Başlangıç Saati</label>
            <input type="time" name="startTime" required
                   value="<%= sa.detail && sa.detail.routine ? sa.detail.routine.startTime : sa.defaults.startTime %>" />

            <label>Bitiş Saati</label>
            <input type="time" name="endTime" required
                   value="<%= sa.detail && sa.detail.routine ? sa.detail.routine.endTime : sa.defaults.endTime %>" />
            <p class="muted">Bitiş, başlangıçtan sonra olmalı. Bitişten sonra basmak "geç" sayılır.</p>

            <label class="row center">
              <input type="checkbox" name="isActive" value="on"
                     <%= !sa.detail || !sa.detail.routine || sa.detail.routine.isActive ? 'checked' : '' %> />
              <span>Rutin aktif</span>
            </label>

            <button type="submit">Kaydet</button>
          </form>
          <% } %>
        </section>

        <section class="panel">
          <h3>Öğrenci Rutinleri</h3>
          <div class="table-wrap">
            <table class="stack-mobile">
              <thead>
                <tr>
                  <th>Öğrenci</th>
                  <th>Aralık</th>
                  <th>Durum</th>
                  <th>İşlem</th>
                </tr>
              </thead>
              <tbody>
                <% sa.rows.forEach((r) => { %>
                <tr>
                  <td><%= r.student.name %></td>
                  <td><%= r.routine ? r.routine.startTime + ' - ' + r.routine.endTime : '-' %></td>
                  <td>
                    <% if (!r.routine) { %>
                    <span class="day-badge off">Yok</span>
                    <% } else if (r.routine.isActive) { %>
                    <span class="day-badge ok">Aktif</span>
                    <% } else { %>
                    <span class="day-badge miss">Pasif</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="task-table-actions">
                      <a class="button-link" href="/admin/sport?sportStudentId=<%= r.student.id %>">İncele</a>
                      <% if (r.routine) { %>
                      <form method="post" action="/admin/sport/delete" onsubmit="return confirm('Rutin kaldırılsın mı? Geçmiş kayıtlar silinmez.')">
                        <input type="hidden" name="next" value="/admin/sport" />
                        <input type="hidden" name="studentId" value="<%= r.student.id %>" />
                        <button type="submit" class="danger">Kaldır</button>
                      </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>

        <% if (sa.detail && sa.detail.routine) { %>
        <section class="panel">
          <h3><%= sa.selected.name %> — Son <%= sa.detail.summary.gunSayisi %> Gün</h3>
          <p class="muted">
            Zamanında <%= sa.detail.summary.onTime %> · Geç <%= sa.detail.summary.late %> ·
            Yapılmadı <%= sa.detail.summary.missed %> ·
            Seri <%= sa.detail.streak %> gün ·
            Ortalama saat <%= sa.detail.summary.averageTime || '-' %>
          </p>
          <p class="muted">
            Öğrenci işaretlemeyi unuttuysa günün saatini elle yazabilirsiniz;
            saat, kaydın kendi aralığına göre değerlendirilir. Elle yazılan
            kayıt kimin yazdığıyla birlikte saklanır.
          </p>
          <div class="table-wrap">
            <table class="stack-mobile routine-log-table">
              <thead>
                <tr>
                  <th>Tarih</th>
                  <th>Gün</th>
                  <th>Aralık</th>
                  <th>Yapıldı</th>
                  <th>Gecikme</th>
                  <th>Durum</th>
                  <th>Elle Kayıt</th>
                </tr>
              </thead>
              <tbody>
                <% sa.detail.rows.forEach((r) => { %>
                <tr>
                  <td><%= r.day %></td>
                  <td><%= r.gunAdi %></td>
                  <td><%= r.startTime %> - <%= r.endTime %></td>
                  <td><%= r.doneAt || '-' %></td>
                  <td><%= r.delayMinutes ? r.delayMinutes + ' dk' : '-' %></td>
                  <td>
                    <% if (r.status === 'on_time') { %>
                    <span class="day-badge ok">Zamanında</span>
                    <% } else if (r.status === 'late') { %>
                    <span class="day-badge late">Geç</span>
                    <% } else if (r.status === 'missed') { %>
                    <span class="day-badge miss">Yapılmadı</span>
                    <% } else if (r.status === 'pending') { %>
                    <span class="day-badge off">Bekliyor</span>
                    <% } else { %>
                    <span class="muted">-</span>
                    <% } %>
                    <% if (r.correctionText) { %>
                    <small class="muted status-fix-trace"><%= r.correctionText %></small>
                    <% } %>
                  </td>
                  <td>
                    <form method="post" action="/admin/routines/sport/log" class="status-fix-form">
                      <input type="hidden" name="next" value="/admin/sport?sportStudentId=<%= sa.selected.id %>" />
                      <input type="hidden" name="studentId" value="<%= sa.selected.id %>" />
                      <input type="hidden" name="day" value="<%= r.day %>" />
                      <input type="time" name="time" value="<%= r.doneAt || '' %>" aria-label="<%= r.day %> spor saati" />
                      <input type="text" name="note" maxlength="300" placeholder="Gerekçe (opsiyonel)" />
                      <div class="task-table-actions">
                        <button type="submit" name="action" value="set">Kaydet</button>
                        <% if (r.status !== 'missed') { %>
                        <button type="submit" name="action" value="missed">Yapılmadı</button>
                        <% } %>
                        <% if (r.canClear) { %>
                        <button type="submit" name="action" value="clear" class="danger">Temizle</button>
                        <% } %>
                      </div>
                    </form>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
        <% } %>
        <% } %>

        <% if (currentPage === 'wake' && wakeAdmin) { %>
        <header class="content-header">
          <h2>Uyanma Rutini</h2>
          <p class="muted">
            Öğrenci her sabah tek dokunuşla işaretler; basılan saat kaydedilir.
            Hedef + tolerans içindeyse <strong>zamanında</strong>, sonrasıysa
            <strong>geç</strong> (saatiyle birlikte) yazılır. Hiç basılmayan gün
            ertesi gün otomatik <strong>kaçırıldı</strong> mühürlenir.
          </p>
        </header>

        <section class="panel narrow">
          <h3>Rutin Ayarla</h3>
          <% if (!students.length) { %>
          <p class="muted">Önce bir öğrenci ekleyin.</p>
          <% } else { %>
          <form method="post" action="/admin/wake" class="stack">
            <input type="hidden" name="next" value="/admin/wake" />
            <label>Öğrenci</label>
            <select name="studentId" required>
              <% students.forEach((s) => { %>
              <option value="<%= s.id %>" <%= wakeAdmin.selected && wakeAdmin.selected.id === s.id ? 'selected' : '' %>><%= s.name %></option>
              <% }) %>
            </select>

            <label>Hedef Uyanma Saati</label>
