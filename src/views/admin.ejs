              <thead>
                <tr>
                  <th>Öğrenci</th>
                  <th>Hedef</th>
                  <th>Tolerans</th>
                  <th>Durum</th>
                  <th>İşlem</th>
                </tr>
              </thead>
              <tbody>
                <% wakeAdmin.rows.forEach((r) => { %>
                <tr>
                  <td><a href="/admin/wake?bolum=kayitlar&wakeStudentId=<%= r.student.id %>"><%= r.student.name %></a></td>
                  <td><%= r.routine ? r.routine.targetTime : '-' %></td>
                  <td><%= r.routine ? '+' + r.routine.toleranceMinutes + ' dk' : '-' %></td>
                  <td>
                    <% if (!r.routine) { %>
                    <span class="day-badge off">Tanımsız</span>
                    <% } else if (r.routine.isActive) { %>
                    <span class="day-badge ok">Aktif</span>
                    <% } else { %>
                    <span class="day-badge off">Pasif</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (r.routine) { %>
                    <form method="post" action="/admin/wake/delete" onsubmit="return confirm('<%= r.student.name %> için rutin kaldırılsın mı? Geçmiş kayıtlar silinmez.')">
                      <input type="hidden" name="next" value="/admin/wake?bolum=rutinler" />
                      <input type="hidden" name="studentId" value="<%= r.student.id %>" />
                      <button type="submit" class="danger">Kaldır</button>
                    </form>
                    <% } else { %>
                    <span class="muted">-</span>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
        <% } %>

        <% if (currentSection === 'kayitlar') { %>
        <% if (wakeAdmin.detail && wakeAdmin.detail.routine) { %>
        <header class="content-header">
          <h3><%= wakeAdmin.selected.name %> · Son <%= wakeAdmin.detail.summary.gunSayisi %> Gün</h3>
        </header>

        <p class="section-label">Son 14 Gün</p>
        <section class="kpi-grid">
          <article class="kpi <%= wakeAdmin.detail.streak > 0 ? 'ok' : '' %>">
            <span class="kpi-icon" aria-hidden="true"><%- menuIcons.streak %></span>
            <p class="kpi-label">Zamanında Serisi</p>
            <p class="kpi-value"><%= wakeAdmin.detail.streak %> gün</p>
          </article>
          <article class="kpi">
            <span class="kpi-icon" aria-hidden="true"><%- menuIcons.percent %></span>
            <p class="kpi-label">Zamanında Oranı</p>
            <p class="kpi-value"><%= wakeAdmin.detail.summary.onTimeRate === null ? '-' : wakeAdmin.detail.summary.onTimeRate + '%' %></p>
          </article>
          <article class="kpi">
            <span class="kpi-icon" aria-hidden="true"><%- menuIcons.clock %></span>
            <p class="kpi-label">Ortalama Uyanma</p>
            <p class="kpi-value"><%= wakeAdmin.detail.summary.averageWake || '-' %></p>
          </article>
          <article class="kpi">
            <span class="kpi-icon" aria-hidden="true"><%- menuIcons.clock %></span>
            <p class="kpi-label">Ortalama Gecikme</p>
            <p class="kpi-value"><%= wakeAdmin.detail.summary.averageDelay === null ? '-' : wakeAdmin.detail.summary.averageDelay + ' dk' %></p>
          </article>
        </section>

        <%# ELLE KAYIT. Ogrenci tarafinda "ilk basis gecerli" kurali durur;
            burada admin bir GUNUN kaydini kendisi yazar ya da duzeltir.
            Her yazma kim/ne zaman/neyin uzerine bilgisiyle saklanir. %>
        <section class="panel">
          <h3>Günlük Kayıtlar</h3>
          <p class="muted">
            Öğrenci işaretlemeyi unuttuysa günün saatini buradan elle
            yazabilirsiniz; saat, rutinin o güne kopyalanan hedefine göre
            <strong>zamanında</strong> ya da <strong>geç</strong> sayılır.
            Elle yazılan kayıt, <strong>kimin yazdığı ve neyin üzerine
            yazıldığı</strong> ile birlikte saklanır ve satırda görünür.
          </p>
          <div class="table-wrap">
            <table class="stack-mobile routine-log-table">
              <thead>
                <tr>
                  <th>Tarih</th>
                  <th>Gün</th>
                  <th>Hedef</th>
                  <th>Kalkış</th>
                  <th>Gecikme</th>
                  <th>Durum</th>
                  <th>Elle Kayıt</th>
                </tr>
              </thead>
              <tbody>
                <% wakeAdmin.detail.rows.forEach((r) => { %>
                <tr>
                  <td><%= r.day %></td>
                  <td><%= r.gunAdi %></td>
                  <td><%= r.targetTime %></td>
                  <td><%= r.wokeAt || '-' %></td>
                  <td><%= r.delayMinutes ? r.delayMinutes + ' dk' : '-' %></td>
                  <td>
                    <% if (r.status === 'on_time') { %>
                    <span class="day-badge ok">Zamanında</span>
                    <% } else if (r.status === 'late') { %>
                    <span class="day-badge late">Geç</span>
                    <% } else if (r.status === 'missed') { %>
                    <span class="day-badge miss">Kaçırıldı</span>
                    <% } else if (r.status === 'pending') { %>
                    <span class="day-badge off">Bekliyor</span>
                    <% } else { %>
                    <span class="muted">-</span>
                    <% } %>
                    <% if (r.correctionText) { %>
                    <small class="muted status-fix-trace"><%= r.correctionText %></small>
                    <% } %>
                  </td>
                  <td>
                    <form method="post" action="/admin/routines/wake/log" class="status-fix-form">
                      <input type="hidden" name="next" value="/admin/wake?bolum=kayitlar&wakeStudentId=<%= wakeAdmin.selected.id %>" />
                      <input type="hidden" name="studentId" value="<%= wakeAdmin.selected.id %>" />
                      <input type="hidden" name="day" value="<%= r.day %>" />
                      <input type="time" name="time" value="<%= r.wokeAt || '' %>" aria-label="<%= r.day %> kalkış saati" />
                      <input type="text" name="note" maxlength="300" placeholder="Gerekçe (opsiyonel)" />
                      <div class="task-table-actions">
                        <button type="submit" name="action" value="set">Kaydet</button>
                        <% if (r.status !== 'missed') { %>
                        <button type="submit" name="action" value="missed">Kaçırıldı</button>
                        <% } %>
                        <%# Silme yalnizca KALICI oldugunda acik: muhurleyicinin
                            pencerisindeki bir gunde kayit 5 dakika icinde geri
                            gelirdi. %>
                        <% if (r.canClear) { %>
                        <button type="submit" name="action" value="clear" class="danger">Temizle</button>
                        <% } %>
                      </div>
                    </form>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
        <% } else { %>
        <section class="panel narrow">
          <h3>Kayıt yok</h3>
          <p class="muted">
            <%= wakeAdmin.selected ? wakeAdmin.selected.name : 'Bu öğrenci' %> için henüz rutin tanımlı değil. Önce
            <a href="/admin/wake?bolum=ayar">Rutin Ayarla</a> alanından bir hedef gir; günlük
            kayıtlar bundan sonra burada listelenir. Başka bir öğrencinin kayıtlarına
            <a href="/admin/wake?bolum=rutinler">Öğrenci Rutinleri</a> alanından geçebilirsin.
          </p>
        </section>
        <% } %>
        <% } %>
        <% } %>

        <%# PLANLI CALISMA RUTINI (admin) — yapay zeka · YDS. Iki tur birebir
            ayni davrandigi icin markup TEKTIR; gorunum modeli hangi tur
            oldugunu `studyAdmin` icinde tasir. Namazla farki gunde tek kayit
            ve bir PLANIN olmasi (gunluk pencere + dakika). %>
        <% if (studyAdmin) { %>
        <% const aa = studyAdmin; %>
        <header class="content-header">
          <h2><%= aa.label %> Rutini</h2>
          <p class="muted">
            Günlük çalışma planı (varsayılan <strong>1 saat</strong>). Durum saatten
            <strong>hesaplanmaz</strong>: öğrenci <strong>yapıldı</strong>,
            <strong>yapılmadı</strong> ya da <strong>telafi edildi</strong> olarak kendisi
            işaretler. Planlı saat geçince gün kapanmaz — işaretlenmeyen
            <strong>geçmiş</strong> günler "yapılmadı" mühürlenir.
          </p>
        </header>

        <% if (currentSection === 'ayar') { %>
        <section class="panel narrow">
          <h3>Rutin Ayarla</h3>
          <p class="muted">
            Plan başlangıç saati ve günlük dakikadan oluşur; bitiş saati bunlardan
            <strong>hesaplanır</strong>. Plan değerlendirmeyi belirlemez, yalnızca
            "bugün ne yapacağım"ı söyler — ve o günün kaydına kopyalanır ki plan
            sonradan değişse de geçmiş okunabilir kalsın.
          </p>
          <form method="post" action="<%= aa.adminPath %>" class="stack">
            <input type="hidden" name="next" value="<%= aa.adminPath %>?bolum=rutinler" />
            <label>Öğrenci</label>
            <select name="studentId" required>
              <% aa.rows.forEach((r) => { %>
              <option value="<%= r.student.id %>" <%= aa.selected && aa.selected.id === r.student.id ? 'selected' : '' %>><%= r.student.name %></option>
              <% }) %>
            </select>

            <label>Günlük Başlangıç</label>
            <input type="time" name="startTime" required value="<%= aa.detail && aa.detail.routine ? aa.detail.routine.startTime : aa.defaultStart %>" />

            <label>Günlük Süre (dk)</label>
            <input type="number" name="minutes" min="15" max="600" required value="<%= aa.detail && aa.detail.routine ? aa.detail.routine.minutes : aa.defaultMinutes %>" />

            <label>Durum</label>
            <select name="isActive">
              <option value="on">Açık</option>
              <option value="off">Pasif</option>
            </select>

            <button type="submit">Rutini Kaydet</button>
          </form>
        </section>
        <% } %>

        <% if (currentSection === 'rutinler') { %>
        <section class="panel">
          <h3>Öğrenci Rutinleri</h3>
          <p class="muted">Bir öğrencinin adına tıklayınca günlük kayıtları açılır.</p>
          <div class="table-wrap">
            <table class="stack-mobile">
              <thead>
                <tr><th>Öğrenci</th><th>Plan</th><th>Rutin</th><th>İşlem</th></tr>
              </thead>
              <tbody>
                <% aa.rows.forEach((r) => { %>
                <tr>
                  <td><a href="<%= aa.adminPath %>?bolum=kayitlar&<%= aa.studentIdParam %>=<%= r.student.id %>"><%= r.student.name %></a></td>
                  <td class="single-line-cell">
                    <% if (r.routine) { %><%= r.routine.startTime %> - <%= r.routine.endTime %> · <%= r.routine.minutes %> dk<% } else { %>-<% } %>
                  </td>
                  <td>
                    <% if (!r.routine) { %>-
                    <% } else if (r.routine.isActive) { %><span class="day-badge ok">Açık</span>
                    <% } else { %><span class="day-badge off">Pasif</span><% } %>
                  </td>
                  <td>
                    <% if (r.routine) { %>
                    <form method="post" action="<%= aa.adminPath %>/delete" onsubmit="return confirm('<%= r.student.name %> için <%= aa.label %> rutini kaldırılsın mı? Geçmiş kayıtlar silinmez.')">
                      <input type="hidden" name="next" value="<%= aa.adminPath %>?bolum=rutinler" />
                      <input type="hidden" name="studentId" value="<%= r.student.id %>" />
                      <button type="submit" class="danger">Kaldır</button>
                    </form>
                    <% } else { %>
                    <form method="post" action="<%= aa.adminPath %>">
                      <input type="hidden" name="next" value="<%= aa.adminPath %>?bolum=rutinler" />
                      <input type="hidden" name="studentId" value="<%= r.student.id %>" />
                      <input type="hidden" name="startTime" value="<%= aa.defaultStart %>" />
                      <input type="hidden" name="minutes" value="<%= aa.defaultMinutes %>" />
                      <input type="hidden" name="isActive" value="on" />
                      <button type="submit">1 Saatlik Rutini Aç</button>
                    </form>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
        <% } %>

        <% if (currentSection === 'kayitlar') { %>
        <% if (aa.detail && aa.detail.routine) { %>
        <section class="panel">
          <h3><%= aa.selected.name %> · Son <%= aa.detail.summary.gunSayisi %> Gün</h3>
          <p class="muted">
            Yapıldı <%= aa.detail.summary.done %> · Telafi edildi <%= aa.detail.summary.makeup %> ·
            Yapılmadı <%= aa.detail.summary.notDone %> — planlanan
            <%= Math.round(aa.detail.summary.planlananDakika / 60 * 10) / 10 %> saatin
            <strong><%= Math.round(aa.detail.summary.yapilanDakika / 60 * 10) / 10 %> saati</strong> çalışıldı
            (<%= aa.detail.summary.gercekGirilenGun %> günde gerçek süre girildi, kalanlar plandan sayıldı).
            <br />Öğrenci tarafında yanlış basılan bir düğme geri alınamaz; düzeltmesi buradadır.
            Her düzeltme <strong>kim, ne zaman ve neyin üzerine</strong> yazdığıyla saklanır.
          </p>
          <div class="table-wrap">
            <table class="stack-mobile">
              <thead>
                <tr><th>Gün</th><th>Plan</th><th>Durum</th><th>Çalışılan Süre</th><th>Elle Yaz</th></tr>
              </thead>
              <tbody>
                <% aa.detail.rows.forEach((g) => { %>
                <tr>
                  <td class="single-line-cell"><%= g.gunAdi %><br /><span class="muted"><%= g.day %></span></td>
                  <td class="single-line-cell"><%= g.startTime %> - <%= g.endTime %><br /><span class="muted"><%= g.minutes %> dk</span></td>
                  <td>
                    <span class="state-pill <%= g.status %>"><%= g.statusText %></span>
                    <% if (g.makeupDay && g.makeupDay !== g.day) { %>
                    <br /><small class="muted"><%= g.makeupDay %> günü telafi edildi</small>
                    <% } %>
                    <% if (g.correctedAt) { %>
                    <br /><small class="muted">
                      Elle yazıldı<% if (g.correctedByName) { %> · <%= g.correctedByName %><% } %><%
                      if (g.previousStatusText) { %> (<%= g.previousStatusText %> → <%= g.statusText %>)<% } %><%
                      if (g.correctionNote) { %> · <%= g.correctionNote %><% } %>
                    </small>
                    <% } %>
                  </td>
                  <td class="single-line-cell">
                    <% if (g.actualMinutes !== null) { %>
                    <strong><%= g.actualMinutes %> dk</strong>
                    <% } else if (g.status === 'done' || g.status === 'makeup') { %>
                    <span class="muted">girilmedi</span><br /><small class="muted">plandan <%= g.minutes %> dk</small>
                    <% } else { %>
                    <span class="muted">-</span>
                    <% } %>
                  </td>
                  <td>
                    <form method="post" action="<%= aa.adminPath %>/log" class="state-fix">
                      <input type="hidden" name="next" value="<%= aa.adminPath %>?bolum=kayitlar&<%= aa.studentIdParam %>=<%= aa.selected.id %>" />
                      <input type="hidden" name="studentId" value="<%= aa.selected.id %>" />
                      <input type="hidden" name="day" value="<%= g.day %>" />
                      <select name="durum" aria-label="<%= g.day %> durumu">
                        <option value="done">Yapıldı</option>
                        <option value="makeup">Telafi edildi</option>
                        <option value="not_done">Yapılmadı</option>
                        <option value="clear">Kaydı sil</option>
                      </select>
                      <input type="number" name="dakika" min="1" max="1440" placeholder="dk" aria-label="<%= g.day %> çalışılan dakika" />
                      <input type="text" name="note" placeholder="gerekçe (opsiyonel)" maxlength="500" />
                      <button type="submit" class="ghost">Yaz</button>
                    </form>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
        <% } else { %>
        <section class="panel narrow">
          <h3>Kayıt yok</h3>
          <p class="muted">
            <%= aa.selected ? aa.selected.name : 'Bu öğrenci' %> için <%= aa.label %> rutini tanımlı
            değil. Önce <a href="<%= aa.adminPath %>?bolum=ayar">Rutin Ayarla</a> alanından planı gir;
            günlük kayıtlar bundan sonra burada listelenir. Başka bir öğrencinin kayıtlarına
            <a href="<%= aa.adminPath %>?bolum=rutinler">Öğrenci Rutinleri</a> alanından geçebilirsin.
          </p>
        </section>
        <% } %>
        <% } %>
        <% } %>

        <%# NAMAZ RUTINI (admin). Uyanma/spordan farki: rutinin ayari yok
            (vakit saatleri gune ve konuma gore kayar, uygulama bilmiyor),
            gun basina bes kayit var ve ucuncu bir durum (kaza) mevcut. %>
        <% if (currentPage === 'prayer' && prayerAdmin) { %>
        <% const pa = prayerAdmin; %>
        <header class="content-header">
          <h2>Namaz Rutini</h2>
          <p class="muted">
            Günlük beş vakit. Durum saatten <strong>hesaplanmaz</strong> — vakit saatleri güne
            ve konuma göre kaydığı için uygulama onları bilmiyor; öğrenci
            <strong>vaktinde kıldım</strong>, <strong>kılmadım</strong> ya da
            <strong>kazasını kıldım</strong> olarak kendisi işaretler.
            İşaretlenmeyen geçmiş vakitler <strong>kılınmadı</strong> mühürlenir.
          </p>
        </header>

        <% if (currentSection === 'ayar') { %>
        <section class="panel narrow">
          <h3>Rutin Ayarla</h3>
          <p class="muted">
            Namaz rutininin tek ayarı var: açık ya da kapalı. Hedef saat girilmez —
            vakit saatlerini uygulama bilemez, uydurulmuş bir hedefe göre
            değerlendirme yapmak kaydı bozardı.
          </p>
          <form method="post" action="/admin/prayer" class="stack">
            <input type="hidden" name="next" value="/admin/prayer?bolum=rutinler" />
            <label>Öğrenci</label>
            <select name="studentId" required>
              <% pa.rows.forEach((r) => { %>
              <option value="<%= r.student.id %>" <%= pa.selected && pa.selected.id === r.student.id ? 'selected' : '' %>><%= r.student.name %></option>
              <% }) %>
            </select>

            <label>Durum</label>
            <select name="isActive">
              <option value="on">Açık</option>
              <option value="off">Pasif</option>
            </select>

            <button type="submit">Rutini Kaydet</button>
          </form>
        </section>
        <% } %>

        <% if (currentSection === 'rutinler') { %>
        <section class="panel">
          <h3>Öğrenci Rutinleri</h3>
          <p class="muted">Bir öğrencinin adına tıklayınca günlük kayıtları açılır.</p>
          <div class="table-wrap">
            <table class="stack-mobile">
              <thead>
                <tr><th>Öğrenci</th><th>Rutin</th><th>İşlem</th></tr>
              </thead>
              <tbody>
                <% pa.rows.forEach((r) => { %>
                <tr>
                  <td><a href="/admin/prayer?bolum=kayitlar&prayerStudentId=<%= r.student.id %>"><%= r.student.name %></a></td>
                  <td>
                    <% if (!r.routine) { %>-
                    <% } else if (r.routine.isActive) { %><span class="day-badge ok">Açık</span>
                    <% } else { %><span class="day-badge off">Pasif</span><% } %>
                  </td>
                  <td>
                    <% if (r.routine) { %>
                    <form method="post" action="/admin/prayer/delete" onsubmit="return confirm('<%= r.student.name %> için namaz rutini kaldırılsın mı? Geçmiş kayıtlar silinmez.')">
                      <input type="hidden" name="next" value="/admin/prayer?bolum=rutinler" />
                      <input type="hidden" name="studentId" value="<%= r.student.id %>" />
                      <button type="submit" class="danger">Kaldır</button>
                    </form>
                    <% } else { %>
                    <form method="post" action="/admin/prayer">
                      <input type="hidden" name="next" value="/admin/prayer?bolum=rutinler" />
                      <input type="hidden" name="studentId" value="<%= r.student.id %>" />
                      <input type="hidden" name="isActive" value="on" />
                      <button type="submit">Rutini Aç</button>
                    </form>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
        <% } %>

        <% if (currentSection === 'kayitlar') { %>
        <% if (pa.detail && pa.detail.routine) { %>
        <section class="panel">
          <h3><%= pa.selected.name %> · Son <%= pa.detail.summary.gunSayisi %> Gün</h3>
          <p class="muted">
            Vaktinde <%= pa.detail.summary.onTime %> · Kazası kılındı <%= pa.detail.summary.qada %> ·
            Kılınmadı <%= pa.detail.summary.missed %>.
            <br />Öğrenci tarafında yanlış basılan bir düğme geri alınamaz; düzeltmesi buradadır.
            Her düzeltme <strong>kim, ne zaman ve neyin üzerine</strong> yazdığıyla saklanır.
          </p>
          <div class="table-wrap">
            <table class="stack-mobile prayer-log-table">
              <thead>
                <tr>
                  <th>Gün</th>
                  <% pa.prayers.forEach((v) => { %><th><%= v.label %></th><% }) %>
                </tr>
              </thead>
              <tbody>
                <% pa.detail.rows.forEach((g) => { %>
                <tr>
                  <td class="single-line-cell">
                    <%= g.gunAdi %><br /><span class="muted"><%= g.day %></span>
                  </td>
                  <% g.vakitler.forEach((v) => { %>
                  <td>
                    <span class="state-pill <%= v.status %>"><%= v.statusText %></span>
                    <% if (v.correctedAt) { %>
                    <br /><small class="muted">
                      Elle yazıldı<% if (v.correctedByName) { %> · <%= v.correctedByName %><% } %><%
                      if (v.previousStatusText) { %> (<%= v.previousStatusText %> → <%= v.statusText %>)<% } %><%
                      if (v.correctionNote) { %> · <%= v.correctionNote %><% } %>
                    </small>
                    <% } %>
                    <form method="post" action="/admin/prayer/log" class="state-fix">
                      <input type="hidden" name="next" value="/admin/prayer?bolum=kayitlar&prayerStudentId=<%= pa.selected.id %>" />
                      <input type="hidden" name="studentId" value="<%= pa.selected.id %>" />
                      <input type="hidden" name="day" value="<%= v.day %>" />
                      <input type="hidden" name="vakit" value="<%= v.prayer %>" />
                      <select name="durum" aria-label="<%= g.day %> <%= v.prayerLabel %> durumu">
                        <option value="on_time">Vaktinde</option>
                        <option value="qada">Kaza</option>
                        <option value="missed">Kılınmadı</option>
                        <option value="clear">Kaydı sil</option>
                      </select>
                      <input type="text" name="note" placeholder="gerekçe (opsiyonel)" maxlength="500" />
                      <button type="submit" class="ghost">Yaz</button>
                    </form>
                  </td>
                  <% }) %>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
        <% } else { %>
        <section class="panel narrow">
          <h3>Kayıt yok</h3>
          <p class="muted">
            <%= pa.selected ? pa.selected.name : 'Bu öğrenci' %> için namaz rutini tanımlı değil.
            Önce <a href="/admin/prayer?bolum=ayar">Rutin Ayarla</a> alanından rutini aç; günlük
            kayıtlar bundan sonra burada listelenir. Başka bir öğrencinin kayıtlarına
            <a href="/admin/prayer?bolum=rutinler">Öğrenci Rutinleri</a> alanından geçebilirsin.
          </p>
        </section>
        <% } %>
        <% } %>
        <% } %>

        <% if (currentPage === 'schedule' && scheduleView) { %>
        <header class="content-header row space-between center">
          <div>
            <h2>GAP MTAL</h2>
            <p class="muted">
              <% if (scheduleView.gorunum === 'konular') { %>
              Haftalık işlenen konular. Çizelgeyle aynı ızgara; dersi olan her saate
              o hafta işlediğin konuyu yazarsın. <strong>Tatil ve bayram günleri de
              yazılabilir</strong> — takvim yalnızca rozetle uyarır, engellemez.
              <% } else { %>
              Haftalık ders çizelgen. Zil saatleri başlangıç saati ve sürelerden
              <strong>hesaplanır</strong>; bu düzene uymayan günlerde saatleri
              <strong>gün gün elle</strong> (o haftaya özel) de girebilirsin.
              Program Haftalık Takvim'de de görünür. <strong>Her hafta bağımsızdır</strong>:
              girdiğin dersler ve saatler yalnızca o haftaya işler; girilmemiş haftalar
              boştur.
              <% } %>
            </p>
          </div>
        </header>

        <% if (scheduleView.gorunum === 'cizelge') { %>
        <%# HAFTAYA OZEL CIZELGE. Varsayilan sablon KALKTI: her hafta bagimsizdir,
            admin o hafta gelince girer, girilmemis hafta bostur (gelecek onceden
            belli degil). "Bu hafta ders yok" demek icin hafta bosaltilir. %>
        <% const hf = scheduleView.hafta; %>
        <%# Yollar secili ALANI ve HAFTAYI tasir: kayittan sonra kullanici ayni
            alanda ve ayni haftada kalmali. %>
        <% const haftaSorgu = `?bolum=${currentSection}&hafta=${hf}`; %>
        <% const cizelgeYolu = `/admin/schedule${haftaSorgu}`; %>
        <% if (currentSection === 'hafta') { %>
        <section class="panel">
          <div class="datatable-toolbar">
            <div class="row center">
              <a class="button-link <%= hf === scheduleView.buHafta ? 'active' : '' %>" href="/admin/schedule?bolum=<%= currentSection %>&hafta=<%= scheduleView.buHafta %>">Bu hafta</a>
              <a class="button-link" href="/admin/schedule?bolum=<%= currentSection %>&hafta=<%= scheduleView.oncekiHafta %>">← Önceki</a>
              <a class="button-link" href="/admin/schedule?bolum=<%= currentSection %>&hafta=<%= scheduleView.sonrakiHafta %>">Sonraki →</a>
            </div>
            <form method="get" action="/admin/schedule" class="row center">
              <input type="hidden" name="bolum" value="<%= currentSection %>" />
              <label for="scheduleWeek">Hafta</label>
              <input id="scheduleWeek" type="date" name="hafta" value="<%= hf %>" />
              <button type="submit">Git</button>
            </form>
          </div>

          <p class="muted">
            <strong><%= hf %> - <%= scheduleView.haftaSonu %></strong>
            <% if (scheduleView.haftaAkademik && scheduleView.haftaAkademik.termLabel) { %>
              · <%= scheduleView.haftaAkademik.termLabel %><% } %><%
              if (scheduleView.haftaAkademik && scheduleView.haftaAkademik.weekNo) { %>
              · <%= scheduleView.haftaAkademik.weekNo %>. hafta<% } %>
            <% if (scheduleView.haftaAkademik && scheduleView.haftaAkademik.note) { %>
              · <%= scheduleView.haftaAkademik.note %><% } %>
          </p>
          <p class="muted">
            Her hafta <strong>bağımsızdır</strong>: bu haftaya girdiğin dersler ve zil
            saatleri yalnızca bu haftaya işler; diğer haftalar etkilenmez. Girilmemiş
            haftalar boştur — <strong>gelecek haftalar önceden belli değildir</strong>,
            her haftanın çizelgesini o hafta gelince girersin.
            <% if (scheduleView.ozelHafta && scheduleView.toplamDers === 0) { %>
            <br />Bu hafta <strong>boşaltılmış</strong>: "ders yok" sayılır (defter görevi açılmaz).
            <% } %>
          </p>
        </section>
        <% } %>

        <p class="section-label">Haftanın Ders Özeti</p>
        <section class="kpi-grid">
          <article class="kpi">
            <span class="kpi-icon" aria-hidden="true"><%- menuIcons.schedule %></span>
            <p class="kpi-label">Haftalık Ders</p>
            <p class="kpi-value"><%= scheduleView.toplamDers %></p>
          </article>
          <article class="kpi">
            <span class="kpi-icon" aria-hidden="true"><%- menuIcons.schedule %></span>
            <p class="kpi-label">Günün Bitişi</p>
            <p class="kpi-value"><%= scheduleView.bitisSaati %></p>
          </article>
          <article class="kpi">
            <span class="kpi-icon" aria-hidden="true"><%- menuIcons.clock %></span>
            <p class="kpi-label">Günlük Ders Saati</p>
            <p class="kpi-value"><%= scheduleView.ayar.periodCount %></p>
          </article>
          <% if (scheduleView.toplamNobet) { %>
          <article class="kpi">
            <span class="kpi-icon" aria-hidden="true"><%- menuIcons.analysis %></span>
            <p class="kpi-label">Nöbet</p>
            <p class="kpi-value"><%= scheduleView.toplamNobet %></p>
          </article>
          <% } %>
        </section>

        <section class="grid two">
        <% if (currentSection === 'ders') { %>
          <article class="panel">
            <h3><%= scheduleView.form.isEdit ? 'Dersi Düzenle' : 'Ders Ekle' %></h3>
            <form method="post" action="/admin/schedule/entry" class="stack">
              <input type="hidden" name="next" value="<%= cizelgeYolu %>" />
              <% if (hf) { %><input type="hidden" name="hafta" value="<%= hf %>" /><% } %>
              <label>Gün</label>
              <select name="dayOfWeek" required>
                <option value="">Seçin</option>
                <% scheduleView.gunler.forEach((g) => { %>
                <option value="<%= g.dayOfWeek %>" <%= String(scheduleView.form.dayOfWeek) === String(g.dayOfWeek) ? 'selected' : '' %>><%= g.gunAdi %></option>
                <% }) %>
              </select>

              <label>Ders Saati</label>
              <select name="period" required>
                <option value="">Seçin</option>
                <% scheduleView.saatler.forEach((s) => { %>
                <option value="<%= s.period %>" <%= String(scheduleView.form.period) === String(s.period) ? 'selected' : '' %>><%= s.period %>. ders (<%= s.start %> - <%= s.end %>)</option>
                <% }) %>
              </select>

              <label>Ders Adı</label>
              <input type="text" name="subject" required value="<%= scheduleView.form.subject %>" placeholder="Mobil Uygulamalar" />

              <label>Sınıf / Şube</label>
              <input type="text" name="className" value="<%= scheduleView.form.className %>" placeholder="11-A" />

              <label>Derslik</label>
              <input type="text" name="room" value="<%= scheduleView.form.room %>" placeholder="Lab 2" />

              <label>Tür</label>
              <select name="kind">
                <option value="lesson" <%= scheduleView.form.kind === 'lesson' ? 'selected' : '' %>>Ders</option>
                <option value="duty" <%= scheduleView.form.kind === 'duty' ? 'selected' : '' %>>Nöbet</option>
              </select>

              <button type="submit">Kaydet</button>
              <p class="muted">
                Dolu bir saate tekrar kaydedersen üstüne yazılır; önce silmene gerek yok.
                <br />Ders <strong><%= hf %> - <%= scheduleView.haftaSonu %></strong> haftasına
                eklenir; yalnızca bu haftaya işler, diğer haftalar etkilenmez.
              </p>
            </form>
          </article>
        <% } %>

        <% if (currentSection === 'zil') { %>
          <article class="panel">
            <h3>Zil Çizelgesi</h3>
            <form method="post" action="/admin/schedule/settings" class="stack">
              <input type="hidden" name="next" value="/admin/schedule?bolum=zil" />
              <label>İlk Ders Başlangıcı</label>
              <input type="time" name="startTime" required value="<%= scheduleView.ayar.startTime %>" />

              <label>Ders Süresi (dk)</label>
              <input type="number" name="lessonMinutes" min="10" max="120" required value="<%= scheduleView.ayar.lessonMinutes %>" />

              <label>Teneffüs (dk)</label>
              <input type="number" name="breakMinutes" min="0" max="60" required value="<%= scheduleView.ayar.breakMinutes %>" />

              <label>Günlük Ders Saati Sayısı</label>
              <input type="number" name="periodCount" min="1" max="16" required value="<%= scheduleView.ayar.periodCount %>" />

              <label>Öğle Arası Hangi Dersten Sonra</label>
              <input type="number" name="lunchAfterPeriod" min="1" max="16" value="<%= scheduleView.ayar.lunchAfterPeriod === null ? '' : scheduleView.ayar.lunchAfterPeriod %>" placeholder="boş = öğle arası yok" />

              <label>Öğle Arası (dk)</label>
              <input type="number" name="lunchMinutes" min="0" max="180" required value="<%= scheduleView.ayar.lunchMinutes %>" />

              <button type="submit">Zil Çizelgesini Kaydet</button>
              <p class="muted">
                Şu anki ayarla gün <strong><%= scheduleView.ayar.startTime %> - <%= scheduleView.bitisSaati %></strong>
                arası. Bitiş saati tutmuyorsa süreleri değiştir.
                <% if (scheduleView.ayar.isDefault) { %><br />Henüz kaydedilmedi, varsayılan gösteriliyor.<% } %>
                <br />Bu ayar <strong>bütün günler</strong> için geçerlidir; tek bir günün
                saatleri farklıysa aşağıdaki panelden o güne elle yaz.
              </p>
            </form>
          </article>
        <% } %>
        </section>

        <%# GUNE OZEL ZIL SAATLERI. Varsayilan duzen yukaridaki ayardan
            hesaplanir; burasi yalnizca ISTISNADIR. Bos birakilan satir
            varsayilana doner (kayit silinir), bir satira saat yazmak sonraki
            saatleri KAYDIRMAZ. %>
        <% if (currentSection === 'gunzil') { %>
        <section class="panel">
          <h3>Gün Gün Zil Saatleri</h3>
          <p class="muted">
            Bütün günler aynı düzende olmayabilir (ikili öğretim, DYK, kısa cuma,
            telafi). Zil saatleri <strong>haftaya özeldir</strong>: burada
            <strong><%= hf %> - <%= scheduleView.haftaSonu %></strong> haftasının
            <strong><%= scheduleView.saatGunAdi %></strong> gününün ders saatlerini
            elle yazarsın; yazdığın saat yalnızca o haftanın o gününü etkiler ve
            <strong>sonraki saatleri kaydırmaz</strong>. Boş bıraktığın satır
            hesaplanan varsayılana döner.
            <% if (scheduleView.ozelSaatSayisi) { %>
            <br />Bu haftada toplam <strong><%= scheduleView.ozelSaatSayisi %></strong> ders saati elle girilmiş.
            <% } else { %>
            <br />Bu hafta için elle saat girilmemiş; tüm günler hesaplanan çizelgeyi kullanıyor.
            <% } %>
          </p>

          <div class="row" style="margin-bottom: 10px">
            <% scheduleView.gunSayilari.forEach((g) => { %>
            <a
              class="button-link <%= scheduleView.saatGunu === g.dayOfWeek ? 'active' : '' %>"
              href="/admin/schedule?bolum=gunzil&saatGun=<%= g.dayOfWeek %><%= hf ? `&hafta=${hf}` : '' %>"
            ><%= g.gunAdi %><% if (g.ozelSayisi) { %> · <%= g.ozelSayisi %><% } %></a>
            <% }) %>
          </div>

          <form method="post" action="/admin/schedule/period-times" class="stack">
            <input type="hidden" name="next" value="/admin/schedule?bolum=gunzil&saatGun=<%= scheduleView.saatGunu %>&hafta=<%= hf %>" />
            <input type="hidden" name="gun" value="<%= scheduleView.saatGunu %>" />
            <input type="hidden" name="hafta" value="<%= hf %>" />
            <div class="table-wrap">
              <table class="stack-mobile">
                <thead>
                  <tr>
                    <th>Ders Saati</th>
                    <th>Başlangıç</th>
                    <th>Bitiş</th>
                    <th>Varsayılan</th>
                  </tr>
                </thead>
                <tbody>
                  <% scheduleView.saatSatirlari.forEach((sa) => { %>
                  <tr>
                    <td><%= sa.period %>. ders</td>
                    <td>
                      <input
                        type="time"
                        name="bas<%= sa.period %>"
                        value="<%= sa.ozel ? sa.start : '' %>"
                        placeholder="<%= sa.varsayilanStart %>"
                      />
                    </td>
                    <td>
                      <input
                        type="time"
                        name="bit<%= sa.period %>"
                        value="<%= sa.ozel ? sa.end : '' %>"
                        placeholder="<%= sa.varsayilanEnd %>"
                      />
                    </td>
                    <td class="single-line-cell">
                      <%= sa.varsayilanStart %> - <%= sa.varsayilanEnd %>
                      <% if (sa.ozel) { %><br /><span class="day-badge off">Elle girildi</span><% } %>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <div class="row">
              <button type="submit"><%= scheduleView.saatGunAdi %> Saatlerini Kaydet</button>
              <button
                type="submit"
                name="islem"
                value="sifirla"
                class="danger"
                onclick="return confirm('<%= scheduleView.saatGunAdi %> gününün elle girilmiş saatleri silinsin mi? Gün hesaplanan çizelgeye döner.')"
              >Bu Günü Varsayılana Döndür</button>
            </div>
            <p class="muted">
              Boş satır = varsayılan. Bir satıra varsayılanla <strong>aynı</strong> saati
              yazarsan da kayıt tutulmaz: süreler sonradan değişince o hücrenin eski
              saatte donmaması için.
            </p>
          </form>
        </section>
        <% } %>

        <% if (currentSection === 'yapistir') { %>
        <section class="panel">
          <h3>Toplu Yapıştır</h3>
          <p class="muted">
            Programı satır satır yapıştır: <strong>gün · ders saati · ders adı · sınıf · derslik</strong>.
            Son iki sütun isteğe bağlı. Ayraç fark etmez (sekme, virgul, noktalı virgül veya boşluk),
            Excel'den kopyala-yapıştır da olur.
          </p>
          <form method="post" action="/admin/schedule/paste" class="stack">
            <input type="hidden" name="next" value="<%= cizelgeYolu %>" />
            <% if (hf) { %><input type="hidden" name="hafta" value="<%= hf %>" /><% } %>
            <textarea name="metin" rows="8" class="paste-box" placeholder="Salı&#9;1-2&#9;Mobil Uygulamalar&#9;11-A&#9;Lab 2
Salı&#9;5&#9;Nesne Tabanlı Programlama&#9;12-B&#9;D-104
Perşembe&#9;3-4&#9;Veritabanı&#9;10-C&#9;D-201
Perşembe&#9;1-3&#9;Web Tasarım&#9;9-A&#9;Lab 1
Cuma&#9;8&#9;Nöbet"></textarea>

            <ul class="clean-list muted paste-hints">
              <li><strong>Blok ders:</strong> <code>1-2</code> ya da <code>2/4</code> yazarsan her saate ayrı ayrı işlenir.</li>
              <li><strong>Gün adı:</strong> tam ad ya da kısaltma (<code>Sal</code>, <code>Per</code>, <code>Cum</code>) — ders programı yalnızca <strong>Salı · Perşembe · Cuma</strong>; diğer günlerin satırları kabul edilmez.</li>
              <li><strong>Nöbet:</strong> ders adına <code>Nöbet</code> yaz, otomatik nöbet olarak işaretlenir.</li>
              <li><code>#</code> ile başlayan satırlar not sayılır, atlanır.</li>
              <li>
                <strong>Sınıf ve derslik yazacaksan</strong> alanları sekme, virgül ya da
                <strong>iki boşlukla</strong> ayır. Tek boşlukla yazarsan
                <code>Salı 9 Ek Ders 11-C</code> satırında ders adı
                "Ek Ders 11-C" olur — sınıf ayrı alana geçmez.
              </li>
              <li>Dolu bir hücreye denk gelen satır üstüne yazar. Anlaşılmayan satır varsa kaç tane olduğu ve ilki mesajda bildirilir.</li>
            </ul>

            <label class="row center">
              <input type="checkbox" name="temizle" value="on" />
              <span>Önce mevcut programı tamamen temizle</span>
            </label>

            <button type="submit">Yapıştırılanı İşle</button>
          </form>
        </section>
        <% } %>

        <% if (currentSection === 'cizelge') { %>
        <section class="panel">
          <h3>Haftalık Çizelge</h3>
          <p class="muted">Boş hücredeki <strong>+</strong> ile o gün/saate ders eklersin; dolu hücreye tıklayınca düzenlersin. Hücrelerdeki kutuları işaretleyip <strong>Seçilenleri Sil</strong> ile toplu silebilirsin.</p>
          <form
            id="bulkScheduleForm"
            method="post"
            action="/admin/schedule/entries/bulk-delete"
            class="row center"
            style="margin-bottom: 10px"
            onsubmit="return confirm('Seçili ders kayıtları silinsin mi?');"
          >
            <input type="hidden" name="next" value="<%= cizelgeYolu %>" />
            <button type="submit" class="danger" id="bulkScheduleBtn" disabled>
              Seçilenleri Sil (<span id="bulkScheduleCount">0</span>)
            </button>
          </form>
          <div class="table-wrap">
            <div class="board" style="--gun-sayisi: <%= scheduleView.gunler.length %>; --saat-sayisi: <%= scheduleView.izgara.length %>">
              <div class="board-corner">Saat</div>
              <% scheduleView.izgara.forEach((satir, i) => { %>
              <div class="board-time <%= satir.lunchAfter ? 'lunch-after' : '' %>" style="--s: <%= i + 2 %>">
                <span class="period-no"><%= satir.period %>.</span>
                <span class="period-time"><%= satir.start %><br /><%= satir.end %></span>
              </div>
              <% }) %>

              <% scheduleView.gunler.forEach((g, gi) => { %>
              <h4 class="board-dayhead" style="--g: <%= gi + 2 %>"><%= g.gunAdi %></h4>
              <% scheduleView.izgara.forEach((satir, i) => { const h = satir.hucreler[gi]; %>
              <div
                class="board-cell <%= h.entry ? (h.entry.kind === 'duty' ? 'duty' : 'filled') : 'empty' %> <%= satir.lunchAfter ? 'lunch-after' : '' %>"
                style="--g: <%= gi + 2 %>; --s: <%= i + 2 %>"
              >
                <span class="board-cell-time <%= h.saat.ozel ? 'ozel-saat' : '' %>" <%= h.saat.ozel ? 'title="Bu güne elle girilmiş saat"' : '' %>><%= satir.period %>. ders · <%= h.saat.start %>-<%= h.saat.end %></span>
                <% if (h.entry) { %>
                <input type="checkbox" class="cell-select" name="entryIds" value="<%= h.entry.id %>" form="bulkScheduleForm" title="Toplu silme için seç" aria-label="Toplu silme için seç" />
                <a class="cell-link" href="/admin/schedule?bolum=ders&duzenle=<%= h.entry.id %><%= hf ? `&hafta=${hf}` : '' %>">
                  <strong><%= h.entry.subject %></strong>
                  <% if (h.entry.className) { %><span><%= h.entry.className %></span><% } %>
                  <% if (h.entry.room) { %><span class="muted"><%= h.entry.room %></span><% } %>
                </a>
                <form method="post" action="/admin/schedule/entry/<%= h.entry.id %>/delete" onsubmit="return confirm('Bu ders kaydı silinsin mi?')">
                  <input type="hidden" name="next" value="<%= cizelgeYolu %>" />
                  <button type="submit" class="danger cell-delete" title="Sil">×</button>
                </form>
                <% } else { %>
                <a class="cell-add" href="/admin/schedule?bolum=ders&gun=<%= h.dayOfWeek %>&saat=<%= satir.period %><%= hf ? `&hafta=${hf}` : '' %>" title="<%= h.gunAdi %> <%= satir.period %>. ders">+</a>
                <% } %>
              </div>
              <% }) %>
              <% }) %>
            </div>
          </div>
          <script>
            (() => {
              const btn = document.getElementById('bulkScheduleBtn');
              const say = document.getElementById('bulkScheduleCount');
              const kutular = Array.from(
                document.querySelectorAll('input[name="entryIds"][form="bulkScheduleForm"]')
              );
              if (!btn || !kutular.length) return;
              const senkron = () => {
                const secili = kutular.filter((k) => k.checked).length;
                if (say) say.textContent = String(secili);
                btn.disabled = secili === 0;
              };
              kutular.forEach((k) => k.addEventListener('change', senkron));
              senkron();
            })();
          </script>
        </section>
        <% } %>

        <% if (currentSection === 'ozet') { %>
        <section class="panel">
          <h3>Gün Özeti</h3>
          <div class="table-wrap">
            <table class="stack-mobile">
              <thead>
                <tr><th>Gün</th><th>Saat Aralığı</th><th>Ders</th><th>Boş Saat</th><th>Nöbet</th></tr>
              </thead>
              <tbody>
                <% scheduleView.gunSayilari.forEach((g) => { %>
                <tr>
                  <td><%= g.gunAdi %></td>
                  <td class="single-line-cell">
                    <%= g.aralik ? `${g.aralik.start} - ${g.aralik.end}` : '-' %>
                    <% if (g.ozelSayisi) { %><br /><span class="day-badge off"><%= g.ozelSayisi %> saat elle</span><% } %>
                  </td>
                  <td><%= g.dersSayisi %></td>
                  <td><%= g.bosSaat %></td>
                  <td><% if (g.nobet) { %><span class="day-badge off">Var</span><% } else { %>-<% } %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% if (scheduleView.kayitlar.length) { %>
          <form method="post" action="/admin/schedule/clear" class="stack" onsubmit="return confirm('<%= hf %> haftasının dersleri silinsin mi? Hafta boş kalırsa o hafta ders yok sayılır.')">
            <input type="hidden" name="next" value="<%= cizelgeYolu %>" />
            <input type="hidden" name="hafta" value="<%= hf %>" />
            <button type="submit" class="danger">Bu Haftayı Boşalt</button>
          </form>
          <% } %>
        </section>
        <% } %>
        <% } %>

        <% if (scheduleView.gorunum === 'konular' && scheduleView.topicWeek) { %>
        <% const tw = scheduleView.topicWeek; %>
        <header class="content-header row space-between center">
          <div>
            <h3><%= tw.weekStart %> - <%= tw.weekEnd %></h3>
            <p class="muted">
              <%= tw.academic.yearLabel %><% if (tw.academic.termLabel) { %> · <%= tw.academic.termLabel %><% } %><%
              if (tw.academic.weekNo) { %> · <%= tw.academic.weekNo %>. Hafta<% } %>
              &nbsp;·&nbsp; <%= tw.dolu %> / <%= tw.yazilabilir %> ders saati yazıldı<% if (tw.ozelHafta) { %>&nbsp;·&nbsp;<span class="day-badge">bu haftaya özel çizelge</span><% } %>
            </p>
          </div>
          <div class="row">
            <a class="button-link" href="/admin/schedule?bolum=<%= currentSection %>&hafta=<%= tw.thisWeekStart %>">Bu Hafta</a>
            <a class="button-link" href="/admin/schedule?bolum=<%= currentSection %>&hafta=<%= tw.prevWeekStart %>">Önceki Hafta</a>
            <a class="button-link" href="/admin/schedule?bolum=<%= currentSection %>&hafta=<%= tw.nextWeekStart %>">Sonraki Hafta</a>
          </div>
        </header>

        <% if (currentSection === 'konular') { %>
        <% if (!scheduleView.kayitlar.length) { %>
        <section class="panel narrow">
          <h3>Çizelge boş</h3>
          <p class="muted">
            Önce <a href="/admin/schedule?bolum=cizelge">Çizelge</a> sekmesinden ders programını gir;
            konu yazılacak ders saatleri oradan gelir.
          </p>
        </section>
        <% } else { %>
        <form method="post" action="/admin/schedule/topics">
          <input type="hidden" name="next" value="/admin/schedule?bolum=konular&hafta=<%= tw.weekStart %>" />
          <input type="hidden" name="weekStart" value="<%= tw.weekStart %>" />

          <section class="panel">
            <div class="table-wrap">
              <div class="board topic-board" style="--gun-sayisi: <%= tw.gunler.length %>; --saat-sayisi: <%= tw.izgara.length %>">
                <div class="board-corner">Saat</div>
                <% tw.izgara.forEach((satir, i) => { %>
                <div class="board-time <%= satir.lunchAfter ? 'lunch-after' : '' %>" style="--s: <%= i + 2 %>">
                  <span class="period-no"><%= satir.period %>.</span>
                  <span class="period-time"><%= satir.start %><br /><%= satir.end %></span>
                </div>
                <% }) %>

                <% tw.gunler.forEach((g, gi) => { %>
                <h4 class="board-dayhead" style="--g: <%= gi + 2 %>">
                  <%= g.gunAdi %>
                  <span class="th-sub"><%= g.tarih.slice(5) %></span>
                  <% if (g.olagandisi) { %><span class="day-badge off" title="Takvimde tatil — yine de yazabilirsin"><%= g.dayLabel %></span><% } %>
                </h4>
                <% tw.izgara.forEach((satir, i) => { const h = satir.hucreler[gi]; %>
                <div
                  class="board-cell <%= h.entry ? 'filled' : 'empty' %> <%= h.entry && h.olagandisi ? 'off-day' : '' %> <%= satir.lunchAfter ? 'lunch-after' : '' %>"
                  style="--g: <%= gi + 2 %>; --s: <%= i + 2 %>"
                >
                  <span class="board-cell-time <%= h.saat && h.saat.ozel ? 'ozel-saat' : '' %>"><%= satir.period %>. ders · <%= h.saat ? h.saat.start : satir.start %>-<%= h.saat ? h.saat.end : satir.end %></span>
                  <% if (h.entry) { %>
                  <p class="topic-head">
                    <strong><%= h.entry.subject %></strong>
                    <% if (h.entry.className) { %><span class="muted"><%= h.entry.className %></span><% } %>
                  </p>
                  <textarea
                    name="konu[<%= h.dayOfWeek %>-<%= satir.period %>]"
                    rows="2"
                    placeholder="İşlenen konu"
                  ><%= h.topic %></textarea>
                  <% if (!h.topic && h.oncekiTopic) { %>
                  <p class="topic-prev muted">geçen hafta: <%= h.oncekiTopic %></p>
                  <% } %>
                  <% } %>
                </div>
                <% }) %>
                <% }) %>
              </div>
            </div>

            <div class="row space-between center topic-actions">
              <p class="muted">
                Boş bıraktığın alanın kaydı silinir. Nöbet saatleri de yazılabilir.
              </p>
              <button type="submit">Haftayı Kaydet</button>
            </div>
          </section>
        </form>
        <% } %>

        <section class="panel narrow">
          <h3>İşlenen Konuları Toplu Sil</h3>
          <p class="muted">
            Seçilen tarih aralığındaki <strong>tüm işlenen konu kayıtları</strong>
            kalıcı olarak silinir. Çizelge ve dersler etkilenmez; yalnızca o
            günlere yazılmış konu metinleri gider. Geri alınamaz.
          </p>
          <form
            method="post"
            action="/admin/schedule/topics/bulk-delete"
            class="stack"
            onsubmit="return confirm('Seçilen aralıktaki işlenen konular silinsin mi? Bu işlem geri alınamaz.');"
          >
            <input type="hidden" name="next" value="/admin/schedule?bolum=konular&hafta=<%= tw.weekStart %>" />
            <label>Başlangıç tarihi</label>
            <input type="date" name="from" required value="<%= tw.weekStart %>" />
            <label>Bitiş tarihi</label>
            <input type="date" name="to" required value="<%= tw.weekEnd %>" />
            <button type="submit" class="danger">Aralıktaki Konuları Sil</button>
          </form>
        </section>
        <% } %>

        <%# Ders Gorevleri / Defteri Kim Yazabilir / Excel panelleri cizelge BOS
            olsa da gorunur. Once hepsi "cizelge dolu" dalinin icindeydi: tam da
            durumu anlamak gereken anda (bu haftada hic ders yokken) panel
            ortadan kayboluyordu — kullanici "gorev yok falan da yazmiyor"
            dedi. %>
        <% if (currentSection === 'gorevler') { %>
        <section class="panel narrow">
          <h3>Ders Görevleri</h3>
          <p class="muted">
            Çizelgedeki <strong>her ders saati kendi görevidir</strong>
            (ör. "3. ders · Matematik") ve kendi gününe düşer. O dersin
            <strong>işlenen konusu yazılınca görev anında "Yapıldı"</strong>
            işaretlenir. Öğrencinin listesinde <strong>içinde bulunulan
            haftanın</strong> dersleri görünür.
          </p>
          <%# TESHIS: gorevler yalnizca aktarim yapilan ogrenciye yazilir.
              "Olusturdum ama gorunmuyor" vakasinin en olasi sebebi yanlis
              ogrenci oldugu icin her ogrencinin bu haftaki sayisi ayri ayri
              gosteriliyor. %>
          <%# Once CIZELGE: bu haftada hic ders yoksa gorev de olmaz. Iki
              durumu ayirt etmek icin sayiyi acikca yaziyoruz. %>
          <p class="muted">
            Bu haftanın çizelgesinde
            <strong><%= tw.yazilabilir %> ders saati</strong> var
            (<%= tw.weekStart %> - <%= tw.weekEnd %>).
            <% if (!tw.yazilabilir) { %>
            <br />
            <span class="day-badge miss">Çizelge boş</span>
            Bu hafta hiç ders tanımlı değil; ders görevi de açılmaz.
            <strong>Çizelge</strong> sekmesinde bu haftanın derslerini girin —
            girdiğiniz dersler yalnızca <em>bu haftaya</em> yazılır.
            <% } %>
          </p>
          <% if (tw.haftaGorevleri && tw.haftaGorevleri.length) { %>
          <%# Her ogrencinin KENDI satirinda kendi dugmesi var. Once acilir
              liste + tek dugme vardi: kullanici listeyi degistirmeden bastigi
              icin gorevler yanlis ogrenciye yazildi ve "olusturdum ama
              gorunmuyor" ortaya cikti. Satir bazinda dugme o hatayi
              yapisal olarak kaldiriyor. %>
          <p class="muted">Bu haftanın ders görevleri:</p>
          <ul class="clean-list">
            <% tw.haftaGorevleri.forEach((g) => { %>
            <li class="row space-between center">
              <span>
                <strong><%= g.studentName %></strong>
                <% if (!g.toplam) { %>
                <span class="day-badge miss">Görev yok</span>
                <% } else { %>
                <span class="day-badge <%= g.isaretli >= g.toplam ? 'ok' : 'off' %>">
                  <%= g.toplam %> ders · <%= g.isaretli %> konusu yazıldı
                </span>
                <% } %>
              </span>
              <form method="post" action="/admin/schedule/log-tasks">
                <input type="hidden" name="next" value="/admin/schedule?bolum=gorevler" />
                <input type="hidden" name="studentId" value="<%= g.studentId %>" />
                <button type="submit" class="<%= g.toplam ? 'ghost' : '' %>">
                  <%= g.toplam ? 'Güncelle' : 'Görevleri Oluştur' %>
                </button>
              </form>
            </li>
            <% }) %>
          </ul>
          <p class="muted">
            Öğretim yılındaki tüm ders saatleri o öğrenci için açılır; tekrar
            basmak yalnızca eksikleri tamamlar. Çizelge değişirse başlıklar
            tazelenir — ama işaretlenmiş ve günü geçmiş görevler asla
            oynatılmaz. Öğrencinin <strong>Görevlerim</strong> sayfasında bu
            haftanın dersleri görünür.
          </p>
          <% } %>
          <% if (!students.length) { %>
          <p class="muted">Önce bir öğrenci ekleyin.</p>
          <% } %>

          <div style="margin-top: var(--sp-5); padding-top: var(--sp-4); border-top: 1px solid var(--border)">
            <p class="muted">
              <strong>Sıfırdan başlamak için:</strong> tüm öğrencilerdeki
              <strong>bütün ders görevlerini</strong> (geçmiş + gelecek) tek
              seferde siler. Çizelgeyi kurup yukarıdan yeniden oluşturabilirsin.
              İşaretlenmiş görevler ve durum kayıtları da gider; geri alınamaz.
            </p>
            <form
              method="post"
              action="/admin/schedule/tasks/delete-all"
              onsubmit="return confirm('TÜM ders görevleri (geçmiş ve gelecek, tüm öğrenciler) kalıcı olarak silinsin mi? Geri alınamaz.');"
            >
              <input type="hidden" name="next" value="/admin/schedule?bolum=gorevler" />
              <button type="submit" class="danger">Tüm Ders Görevlerini Sil</button>
            </form>
          </div>
        </section>
        <% } %>

        <% if (currentSection === 'defter') { %>
        <section class="panel narrow">
          <h3>Defteri Kim Yazabilir</h3>
          <p class="muted">
            Ders defteri uygulama genelinde <strong>tek kayıttır</strong> ve
            öğretmenin defteridir; öğrenciler onu normalde yalnızca okur.
            Aşağıda işaretlediğin öğrenci hesabı defteri <strong>kendi
            panelinden</strong> de yazabilir — sen hem admin hem öğrenci olarak
            giriyorsan hesap değiştirmek zorunda kalmazsın.
          </p>
          <% if (!scheduleView.ogrenciler.length) { %>
          <p class="muted">Henüz öğrenci yok.</p>
          <% } else { %>
          <ul class="teacher-list">
            <% scheduleView.ogrenciler.forEach((st) => { %>
            <li>
              <span>
                <strong><%= st.name %></strong>
                <% if (st.isTeacher) { %><span class="day-badge ok">Defteri yazabilir</span><% } %>
              </span>
              <form method="post" action="/admin/schedule/teacher">
                <input type="hidden" name="next" value="/admin/schedule?bolum=defter" />
                <input type="hidden" name="studentId" value="<%= st.id %>" />
                <input type="hidden" name="isTeacher" value="<%= st.isTeacher ? '0' : '1' %>" />
                <button type="submit" class="ghost">
                  <%= st.isTeacher ? 'Yetkiyi kaldır' : 'Yetki ver' %>
                </button>
              </form>
            </li>
            <% }) %>
          </ul>
          <% } %>
        </section>
        <% } %>

        <% if (currentSection === 'excel') { %>
        <section class="panel narrow">
          <h3>Excel Çıktısı</h3>
          <p class="muted">
            Seçtiğin aralıktaki tüm işlenen konular tek dosyada iner: tarih, gün,
            ders saati, ders, sınıf ve konu. İkinci sayfada sınıf bazında özet var.
            Varsayılan aralık <strong><%= tw.exportLabel %></strong>.
          </p>
          <form method="get" action="/admin/schedule/topics/export" class="stack">
            <input type="hidden" name="next" value="/admin/schedule?bolum=excel" />
            <label>Başlangıç</label>
            <input type="date" name="from" value="<%= tw.exportFrom %>" />
            <label>Bitiş</label>
            <input type="date" name="to" value="<%= tw.exportTo %>" />
            <button type="submit">Excel İndir</button>
          </form>
        </section>
        <% } %>
        <% } %>
        <% } %>

        <% if (currentPage === 'reports') { %>
        <header class="content-header">
          <h2>Performans Raporları</h2>
        </header>
        <section class="panel">
          <form method="get" action="/admin/reports" class="grid three">
            <div class="stack">
              <label>Öğrenci</label>
              <select name="reportStudentId" required>
                <option value="">Seçiniz</option>
                <% students.forEach((s) => { %>
                <option value="<%= s.id %>" <%= reportFilters.studentId === s.id ? 'selected' : '' %>><%= s.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="stack">
              <label>Başlangıç</label>
              <input type="date" name="reportFrom" value="<%= reportFilters.fromDate %>" required />
            </div>
            <div class="stack">
              <label>Bitiş</label>
              <input type="date" name="reportTo" value="<%= reportFilters.toDate %>" required />
            </div>
            <div class="stack"><button type="submit">Rapor Getir</button></div>
          </form>

          <% if (reportError) { %>
          <div class="alert error"><%= reportError %></div>
          <% } %>

          <% if (report) { %>
          <p>
            <strong><%= report.student.name %></strong> için <%= report.fromDate %> - <%= report.toDate %>
            dönemi tamamlanma oranı: <strong>%<%= report.completionRate %></strong>
          </p>
          <p class="muted">
            Toplam Görev: <%= report.totals.due %> | Tamamlanan: <%= report.totals.done %> |
            Soru: <%= report.totals.questions %>
          </p>

          <div class="table-wrap">
            <table class="stack-mobile">
              <thead>
                <tr>
                  <th>Tarih</th>
                  <th>Görev</th>
                  <th>Yapıldı</th>
                  <th>Yapılmadı</th>
                  <th>Soru</th>
                </tr>
              </thead>
              <tbody>
                <% report.rows.forEach((r) => { %>
                <tr>
                  <td><%= r.date %></td>
                  <td><%= r.dueCount %></td>
                  <td><%= r.doneCount %></td>
                  <td><%= r.notDoneCount %></td>
                  <td><%= r.questionCount %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </section>
        <% } %>
      </section>
    </main>
    <script>
      // Mobilde tablolar karta doner (bkz. .stack-mobile). Kartta sutun basligi
      // gorunmedigi icin her hucreye etiketi buradan yaziyoruz - her <td>'ye
      // elle data-label yazmak yerine basliktan turetiyoruz. Betik calismazsa
      // tablo eskisi gibi yatay kaydirilir, icerik kaybolmaz.
      (() => {
        for (const tablo of document.querySelectorAll('table.stack-mobile')) {
          const basliklar = [...tablo.querySelectorAll('thead th')].map((th) =>
            th.textContent.trim()
          );
          if (!basliklar.length) continue;
          for (const satir of tablo.querySelectorAll('tbody tr')) {
            // Gun basligi gibi TUM SATIRI kaplayan hucreler etiketlenmez:
            // "Tarih" etiketi basligin ustune yapisiyordu.
            if (satir.classList.contains('day-group-row')) continue;
            [...satir.children].forEach((hucre, i) => {
              if (hucre.colSpan > 1) return;
              const etiket = basliklar[i];
              if (etiket && !hucre.hasAttribute('data-label')) {
                hucre.setAttribute('data-label', etiket);
              }
            });
          }
        }
      })();
    </script>
  </body>
</html>

