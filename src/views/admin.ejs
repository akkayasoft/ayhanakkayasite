            <label class="row center">
              <input type="checkbox" name="isActive" value="on"
                     <%= !sa.detail || !sa.detail.routine || sa.detail.routine.isActive ? 'checked' : '' %> />
              <span>Rutin aktif</span>
            </label>

            <button type="submit">Kaydet</button>
          </form>
          <% } %>
        </section>
        <% } %>

        <% if (currentSection === 'rutinler') { %>
        <section class="panel">
          <h3>Öğrenci Rutinleri</h3>
