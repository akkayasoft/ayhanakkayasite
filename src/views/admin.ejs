                    <% if (!r.routine) { %>
                    <span class="day-badge off">Yok</span>
                    <% } else if (r.routine.isActive) { %>
                    <span class="day-badge ok">Aktif</span>
                    <% } else { %>
                    <span class="day-badge miss">Pasif</span>
                    <% } %>
                  </td>
