<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Paneli</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="shell">
      <aside class="sidebar">
        <div>
          <p class="sidebar-kicker">Yönetim</p>
          <h1 class="sidebar-title">Öğrenci Takip</h1>
          <p class="sidebar-user"><strong><%= user.name %></strong></p>
        </div>

        <nav class="menu">
          <a href="/admin/dashboard" class="menu-link <%= currentPage === 'dashboard' ? 'active' : '' %>">Genel Durum</a>
          <a href="/admin/students" class="menu-link <%= currentPage === 'students' ? 'active' : '' %>">Öğrenciler</a>
          <a href="/admin/users" class="menu-link <%= currentPage === 'users' ? 'active' : '' %>">Kullanıcı Yönetimi</a>
          <a href="/admin/categories" class="menu-link <%= currentPage === 'categories' ? 'active' : '' %>">Kategoriler</a>
          <a href="/admin/tasks/active" class="menu-link <%= ['tasks', 'tasks-create', 'tasks-update', 'tasks-active'].includes(currentPage) ? 'active' : '' %>">Görevler</a>
          <a href="/admin/analysis" class="menu-link <%= currentPage === 'analysis' ? 'active' : '' %>">Haftalık Analiz</a>
          <a href="/admin/yz-program" class="menu-link <%= currentPage === 'yz-program' ? 'active' : '' %>">YZ Programı</a>
          <a href="/admin/wake" class="menu-link <%= currentPage === 'wake' ? 'active' : '' %>">Uyanma Rutini</a>
          <a href="/admin/yds" class="menu-link <%= currentPage === 'yds' ? 'active' : '' %>">YDS Takibi</a>
          <a href="/admin/reports" class="menu-link <%= currentPage === 'reports' ? 'active' : '' %>">Raporlar</a>
        </nav>

        <form method="post" action="/logout" class="sidebar-logout">
          <button type="submit" class="ghost">Çıkış</button>
        </form>
      </aside>

      <section class="content">
        <% if (message) { %>
        <div class="alert success"><%= message %></div>
        <% } %>
        <% if (error) { %>
        <div class="alert error"><%= error %></div>
        <% } %>

        <% if (currentPage === 'dashboard') { %>
        <header class="content-header">
          <h2>Genel Durum</h2>
          <p class="muted">Günlük performans özeti - <strong><%= today %></strong></p>
        </header>

        <section class="kpi-grid">
          <article class="kpi"><p class="kpi-label">Öğrenci</p><p class="kpi-value"><%= students.length %></p></article>
          <article class="kpi"><p class="kpi-label">Aktif Görev</p><p class="kpi-value"><%= activeTasks.length %></p></article>
          <article class="kpi"><p class="kpi-label">Arşiv Görev</p><p class="kpi-value"><%= archivedTasks.length %></p></article>
          <article class="kpi"><p class="kpi-label">Kategori</p><p class="kpi-value"><%= categories.length %></p></article>
        </section>

        <section class="panel">
          <h3>Bugünlük Öğrenci Durumu</h3>
          <!-- React island (kademeli geçiş): /api/admin/daily-board verisinden beslenir -->
          <div id="island-daily-board" data-endpoint="/api/admin/daily-board">
            <p class="muted">Yükleniyor...</p>
          </div>
        </section>
        <script type="module" src="/dist/daily-board.js"></script>
        <% } %>

        <% if (currentPage === 'students') { %>
        <header class="content-header">
          <h2>Öğrenci Yönetimi</h2>
        </header>
        <section class="grid two">
          <article class="panel">
            <h3>Yeni Öğrenci</h3>
            <form method="post" action="/admin/students" class="stack">
              <input type="hidden" name="next" value="/admin/students" />
              <label>Ad Soyad</label>
              <input type="text" name="name" required />
              <label>Kullanıcı Adı</label>
              <input type="text" name="username" required />
              <label>Şifre</label>
              <input type="text" name="password" minlength="6" required />
              <button type="submit">Kaydet</button>
            </form>
          </article>

          <article class="panel">
            <h3>Mevcut Öğrenciler</h3>
            <ul class="clean-list">
              <% students.forEach((s) => { %>
              <li><strong><%= s.name %></strong> (@<%= s.username %>)</li>
              <% }) %>
            </ul>
          </article>
        </section>
        <% } %>

        <% if (currentPage === 'users') { %>
        <header class="content-header">
          <h2>Kullanıcı Yönetimi</h2>
          <p class="muted">Toplam kullanıcı: <strong><%= users.length %></strong> | Admin: <strong><%= adminCount %></strong></p>
        </header>

        <section class="grid two">
          <article class="panel">
            <h3>Yeni Kullanıcı</h3>
            <form method="post" action="/admin/users" class="stack">
              <input type="hidden" name="next" value="/admin/users" />
              <label>Ad Soyad</label>
              <input type="text" name="name" required />
              <label>Kullanıcı Adı</label>
              <input type="text" name="username" required />
              <label>Şifre</label>
              <input type="text" name="password" minlength="6" required />
              <label>Rol</label>
              <select name="role" required>
                <option value="student">Öğrenci</option>
                <option value="admin">Admin</option>
              </select>
              <button type="submit">Kullanıcı Ekle</button>
            </form>
          </article>

          <article class="panel">
            <h3>Kullanım Notları</h3>
            <ul class="clean-list">
              <li>Son admin hesabı silinemez veya öğrenciye düşürülemez.</li>
              <li>Kendi hesabınızın rolünü veya silme işlemini bu ekrandan yapamazsınız.</li>
              <li>Şifre güncellemede minimum 6 karakter zorunludur.</li>
            </ul>
          </article>
        </section>

        <section class="panel">
          <h3>Mevcut Kullanıcılar</h3>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Ad Soyad</th>
                  <th>Kullanıcı Adı</th>
                  <th>Rol</th>
                  <th>Şifre</th>
                  <th>Sil</th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach((u) => { %>
                <tr>
                  <td><%= u.name %> <%= u.id === user.id ? '(Siz)' : '' %></td>
                  <td>@<%= u.username %></td>
                  <td>
                    <form method="post" action="/admin/users/<%= u.id %>/role" class="row center">
                      <input type="hidden" name="next" value="/admin/users" />
                      <select name="role" <%= u.id === user.id ? 'disabled' : '' %>>
                        <option value="student" <%= u.role === 'student' ? 'selected' : '' %>>Öğrenci</option>
                        <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
                      </select>
                      <% if (u.id !== user.id) { %>
                      <button type="submit">Güncelle</button>
                      <% } %>
                    </form>
                  </td>
                  <td>
                    <form method="post" action="/admin/users/<%= u.id %>/password" class="row center">
                      <input type="hidden" name="next" value="/admin/users" />
                      <input type="text" name="password" minlength="6" placeholder="Yeni şifre" required />
                      <button type="submit">Şifre Değiştir</button>
                    </form>
                  </td>
                  <td>
                    <% if (u.id !== user.id) { %>
                    <form method="post" action="/admin/users/<%= u.id %>/delete" onsubmit="return confirm('Bu kullanıcı silinsin mi?')">
                      <input type="hidden" name="next" value="/admin/users" />
                      <button type="submit" class="danger">Sil</button>
                    </form>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
        <% } %>

        <% if (currentPage === 'categories') { %>
        <header class="content-header">
          <h2>Kategori Yönetimi</h2>
        </header>
        <section class="grid two">
          <article class="panel">
            <h3>Yeni Kategori</h3>
            <form method="post" action="/admin/categories" class="stack">
              <input type="hidden" name="next" value="/admin/categories" />
              <label>Kategori Adı</label>
              <input type="text" name="name" required />
              <button type="submit">Ekle</button>
            </form>
          </article>

          <article class="panel">
            <h3>Kategori Listesi</h3>
            <ul class="clean-list">
              <% categories.forEach((c) => { %>
              <li class="row space-between center">
                <span><%= c.name %></span>
                <form method="post" action="/admin/categories/<%= c.id %>/delete" onsubmit="return confirm('Kategori silinsin mi?')">
                  <input type="hidden" name="next" value="/admin/categories" />
                  <button type="submit" class="danger">Sil</button>
                </form>
              </li>
              <% }) %>
            </ul>
          </article>
        </section>
        <% } %>

        <% if (['tasks', 'tasks-create', 'tasks-update', 'tasks-active'].includes(currentPage)) { %>
        <% const taskSection = currentPage === 'tasks-create' ? 'create' : currentPage === 'tasks-update' ? 'update' : 'active'; %>
        <% const tasksPagePath = activeTaskFilters.studentId ? `/admin/tasks/${taskSection}?activeTaskStudentId=${activeTaskFilters.studentId}` : `/admin/tasks/${taskSection}`; %>
        <% const isUpdatePage = taskSection === 'update'; %>
        <% const isActivePage = taskSection === 'active'; %>
        <% const isInlineEditPage = isUpdatePage || isActivePage; %>
        <% const allTaskExportPath = activeTaskFilters.studentId ? `/admin/tasks/export-active?activeTaskStudentId=${activeTaskFilters.studentId}` : '/admin/tasks/export-active'; %>
        <header class="content-header">
          <h2>Görev Yönetimi</h2>
          <div class="row">
            <a href="/admin/tasks/create" class="button-link <%= taskSection === 'create' ? 'active' : '' %>">Görev Oluştur</a>
            <a href="/admin/tasks/update" class="button-link <%= taskSection === 'update' ? 'active' : '' %>">Görev Güncelle</a>
            <a href="/admin/tasks/active" class="button-link <%= taskSection === 'active' ? 'active' : '' %>">Tüm Görevler</a>
          </div>
        </header>

        <% if (taskSection === 'create') { %>
        <section class="panel">
          <h3>Yeni Görev Oluştur</h3>
          <form method="post" action="/admin/tasks" class="grid two">
            <input type="hidden" name="next" value="<%= tasksPagePath %>" />
            <div class="stack">
              <label>Görev Başlığı</label>
              <input type="text" name="title" required />

              <label>Açıklama</label>
              <textarea name="description"></textarea>

              <label>Kategori</label>
              <select name="categoryId" required>
                <option value="">Seçiniz</option>
                <% categories.forEach((c) => { %>
                <option value="<%= c.id %>"><%= c.name %></option>
                <% }) %>
              </select>

              <label>Öğrenci</label>
              <select name="studentId" required>
                <option value="">Seçiniz</option>
                <% students.forEach((s) => { %>
                <option value="<%= s.id %>"><%= s.name %></option>
                <% }) %>
              </select>
            </div>

            <div class="stack">
              <label>Tekrar Tipi</label>
              <select name="repeatType" required>
                <option value="once">Tek Seferlik</option>
                <option value="daily">Her Gün</option>
                <option value="weekly">Haftalık</option>
                <option value="monthly">Aylık</option>
                <option value="custom">Özel Tarihler</option>
              </select>

              <label>Tek Seferlik Tarih</label>
              <input type="date" name="singleDate" />

              <label>Tahmini Saat</label>
              <input type="time" name="estimatedTime" />

              <label>Haftalık Gün (0-6)</label>
              <input type="number" min="0" max="6" name="weeklyDay" />

              <label>Aylık Gün (1-31)</label>
              <input type="number" min="1" max="31" name="monthlyDay" />

              <label>Özel Tarihler (YYYY-MM-DD, virgülle)</label>
              <input type="text" name="customDates" placeholder="2026-05-10,2026-05-20" />

              <label>Başlangıç Tarihi</label>
              <input type="date" name="startDate" />

              <label>Bitiş Tarihi</label>
              <input type="date" name="endDate" />

              <button type="submit">Görevi Kaydet</button>
            </div>
          </form>
        </section>

        <section class="panel">
          <h3>Herhangi Bir Haftayı Kopyala</h3>
          <form method="post" action="/admin/tasks/copy-week" class="grid two">
            <input type="hidden" name="next" value="<%= tasksPagePath %>" />
            <div class="stack">
              <label>Kaynak Hafta (bu haftadan kopyala)</label>
              <input type="date" name="sourceWeekStart" value="<%= copyWeekStart %>" required />

              <label>Hedef Hafta (bu haftaya kopyala)</label>
              <input type="date" name="targetWeekStart" value="<%= copyWeekNextStart %>" required />
            </div>
            <div class="stack">
              <label>Öğrenci (opsiyonel)</label>
              <select name="studentId">
                <option value="">Tüm Öğrenciler</option>
                <% students.forEach((s) => { %>
                <option value="<%= s.id %>"><%= s.name %></option>
                <% }) %>
              </select>
              <p class="muted">Kaynak haftadaki görev planı, gün offset'i korunarak hedef haftaya tek seferlik görevler olarak kopyalanır.</p>
              <button type="submit">Haftayı Kopyala</button>
            </div>
          </form>
        </section>
        <% } %>

        <% if (isUpdatePage || isActivePage) { %>
        <section class="panel">
          <div class="datatable-toolbar">
            <form method="get" action="/admin/tasks/<%= taskSection %>" class="row center">
              <label for="activeTaskStudentId">Öğrenci</label>
              <select id="activeTaskStudentId" name="activeTaskStudentId">
                <option value="">Tüm Öğrenciler</option>
                <% students.forEach((s) => { %>
                <option value="<%= s.id %>" <%= activeTaskFilters.studentId === s.id ? 'selected' : '' %>><%= s.name %></option>
                <% }) %>
              </select>
              <button type="submit">Filtrele</button>
              <% if (activeTaskFilters.studentId) { %>
              <a class="button-link" href="/admin/tasks/<%= taskSection %>">Temizle</a>
              <% } %>
              <% if (isActivePage) { %>
              <a class="button-link" href="<%= allTaskExportPath %>">Excel İndir</a>
              <% } %>
            </form>
            <div class="datatable-filter-row">
              <div class="datatable-search">
                <label for="taskSearchInput">Genel Ara</label>
                <input id="taskSearchInput" type="text" placeholder="Başlık, konu, öğrenci, kategori..." />
              </div>
              <div class="datatable-search">
                <label for="taskTitleFilter">Başlık</label>
                <input id="taskTitleFilter" type="text" placeholder="Başlığa göre filtrele" />
              </div>
              <div class="datatable-search">
                <label for="taskCategoryFilter">Kategori</label>
                <select id="taskCategoryFilter">
                  <option value="">Tüm Kategoriler</option>
                  <% categories.forEach((c) => { %>
                  <option value="<%= c.name %>"><%= c.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="datatable-search">
                <label for="taskDateFilter">Tarih</label>
                <input id="taskDateFilter" type="text" placeholder="YYYY-MM-DD" />
              </div>
            </div>
          </div>

          <% if (!taskTableTasks.length) { %>
          <p class="muted">Görev yok.</p>
          <% } %>
          <% if (taskTableTasks.length) { %>
          <% if (isUpdatePage) { %>
          <form id="bulkTaskForm" method="post" action="/admin/tasks/bulk-update" class="grid two">
            <input type="hidden" name="next" value="<%= tasksPagePath %>" />
            <div class="stack">
              <h4>Toplu Güncelle</h4>
              <label>Yeni Kategori (opsiyonel)</label>
              <select name="categoryId">
                <option value="">Değiştirme</option>
                <% categories.forEach((c) => { %>
                <option value="<%= c.id %>"><%= c.name %></option>
                <% }) %>
              </select>

              <label>Yeni Öğrenci (opsiyonel)</label>
              <select name="studentId">
                <option value="">Değiştirme</option>
                <% students.forEach((s) => { %>
                <option value="<%= s.id %>"><%= s.name %></option>
                <% }) %>
              </select>

              <label>Arşiv İşlemi</label>
              <select name="archiveAction">
                <option value="keep">Değiştirme</option>
                <option value="archive">Arşive Al</option>
                <option value="unarchive">Arşivden Çıkar</option>
              </select>
            </div>

            <div class="stack">
              <label>Yeni Tekrar Tipi (opsiyonel)</label>
              <select name="repeatType">
                <option value="">Değiştirme</option>
                <option value="once">Tek Seferlik</option>
                <option value="weekly">Haftalık</option>
                <option value="monthly">Aylık</option>
                <option value="custom">Özel Tarihler</option>
              </select>

              <label>Tek Seferlik Tarih</label>
              <input type="date" name="singleDate" />

              <label>Haftalık Gün (0-6)</label>
              <input type="number" min="0" max="6" name="weeklyDay" />

              <label>Aylık Gün (1-31)</label>
              <input type="number" min="1" max="31" name="monthlyDay" />

              <label>Özel Tarihler (YYYY-MM-DD, virgülle)</label>
              <input type="text" name="customDates" placeholder="2026-05-10,2026-05-20" />

              <label>Başlangıç Tarihi (opsiyonel)</label>
              <input type="date" name="startDate" />

              <label>Bitiş Tarihi (opsiyonel)</label>
              <input type="date" name="endDate" />

              <button type="submit">Seçili Görevleri Güncelle</button>
              <p class="muted">Toplu güncelleme sadece seçili görevlere uygulanır.</p>
            </div>
          </form>
          <% } %>

          <div class="table-wrap">
            <table class="task-table <%= isUpdatePage ? 'has-bulk-select' : '' %>" id="adminTasksTable">
              <thead>
                <tr>
                  <% if (isUpdatePage) { %>
                  <th><input id="bulkSelectAll" type="checkbox" /></th>
                  <% } %>
                  <th>Başlık</th>
                  <th>Konu</th>
                  <th>Öğrenci</th>
                  <th>Kategori</th>
                  <th>Saat</th>
                  <th>Tarih</th>
                  <th>İşlem</th>
                </tr>
              </thead>
              <tbody>
                <% taskTableTasks.forEach((t) => { %>
                <% const rowSearchText = `${t.title || ''} ${t.description || ''} ${t.student ? t.student.name : ''} ${t.category ? t.category.name : ''}`.toLowerCase(); %>
                <tr class="task-data-row" data-task-id="<%= t.id %>" data-search="<%= rowSearchText %>" data-title="<%= (t.title || '').toLowerCase() %>" data-category="<%= (t.category ? t.category.name : '').toLowerCase() %>" data-date="<%= (t.dateText || '').toLowerCase() %>">
                  <% if (isUpdatePage) { %>
                  <td><input type="checkbox" name="taskIds" value="<%= t.id %>" form="bulkTaskForm" /></td>
                  <% } %>
                  <td class="<%= isInlineEditPage ? 'editable-cell' : '' %>" data-field="title" data-value="<%= t.title || '' %>"><strong><%= t.title %></strong></td>
                  <td class="<%= isInlineEditPage ? 'editable-cell' : '' %>" data-field="description" data-value="<%= t.description || '' %>"><%= t.description || '-' %></td>
                  <td class="<%= isInlineEditPage ? 'editable-cell' : '' %>" data-field="studentId" data-value="<%= t.studentId || '' %>"><%= t.student ? t.student.name : 'Öğrenci yok' %></td>
                  <td class="<%= isInlineEditPage ? 'editable-cell' : '' %>" data-field="categoryId" data-value="<%= t.categoryId || '' %>"><%= t.category ? t.category.name : 'Kategori yok' %></td>
                  <td class="<%= isInlineEditPage ? 'editable-cell' : '' %>" data-field="estimatedTime" data-value="<%= t.estimatedTime || '' %>"><%= t.estimatedTime || '-' %></td>
                  <td><%= t.dateText %></td>
                  <td>
                    <div class="task-table-actions">
                      <form method="post" action="/admin/tasks/<%= t.id %>/delete" onsubmit="return confirm('Görev kalıcı olarak silinsin mi?')">
                        <input type="hidden" name="next" value="<%= tasksPagePath %>" />
                        <button type="submit" class="danger">Sil</button>
                      </form>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <script>
            (() => {
              const isUpdatePage = <%= isUpdatePage ? 'true' : 'false' %>;
              const isInlineEditPage = <%= isInlineEditPage ? 'true' : 'false' %>;
              const selectAll = document.getElementById('bulkSelectAll');
              const checkboxes = Array.from(
                document.querySelectorAll('input[name="taskIds"][form="bulkTaskForm"]')
              );
              const searchInput = document.getElementById('taskSearchInput');
              const titleFilterInput = document.getElementById('taskTitleFilter');
              const categoryFilterInput = document.getElementById('taskCategoryFilter');
              const dateFilterInput = document.getElementById('taskDateFilter');
              const dataRows = Array.from(document.querySelectorAll('.task-data-row'));
              const editableCells = Array.from(document.querySelectorAll('.editable-cell'));
              const studentOptions = <%- JSON.stringify(students.map((s) => ({ value: s.id, label: s.name }))) %>;
              const categoryOptions = <%- JSON.stringify(categories.map((c) => ({ value: c.id, label: c.name }))) %>;

              const syncHeader = () => {
                if (!selectAll) return;
                selectAll.checked = checkboxes.length > 0 && checkboxes.every((input) => input.checked);
              };

              if (selectAll && isUpdatePage) {
                selectAll.addEventListener('change', () => {
                  checkboxes.forEach((input) => {
                    input.checked = selectAll.checked;
                  });
                });
              }

              if (isUpdatePage) {
                checkboxes.forEach((input) => {
                  input.addEventListener('change', syncHeader);
                });
              }

              const applySearch = () => {
                const term = String((searchInput && searchInput.value) || '').toLowerCase().trim();
                const titleTerm = String((titleFilterInput && titleFilterInput.value) || '').toLowerCase().trim();
                const categoryTerm = String((categoryFilterInput && categoryFilterInput.value) || '').toLowerCase().trim();
                const dateTerm = String((dateFilterInput && dateFilterInput.value) || '').toLowerCase().trim();
                dataRows.forEach((row) => {
                  const text = row.getAttribute('data-search') || '';
                  const titleText = row.getAttribute('data-title') || '';
                  const categoryText = row.getAttribute('data-category') || '';
                  const dateText = row.getAttribute('data-date') || '';
                  const matchSearch = !term || text.includes(term);
                  const matchTitle = !titleTerm || titleText.includes(titleTerm);
                  const matchCategory = !categoryTerm || categoryText.includes(categoryTerm);
                  const matchDate = !dateTerm || dateText.includes(dateTerm);
                  const visible = matchSearch && matchTitle && matchCategory && matchDate;
                  row.hidden = !visible;
                });
              };

              if (searchInput) {
                searchInput.addEventListener('input', applySearch);
              }
              if (titleFilterInput) {
                titleFilterInput.addEventListener('input', applySearch);
              }
              if (categoryFilterInput) {
                categoryFilterInput.addEventListener('change', applySearch);
              }
              if (dateFilterInput) {
                dateFilterInput.addEventListener('input', applySearch);
              }

              const escapeHtml = (value) =>
                String(value || '')
                  .replace(/&/g, '&amp;')
                  .replace(/</g, '&lt;')
                  .replace(/>/g, '&gt;')
                  .replace(/"/g, '&quot;')
                  .replace(/'/g, '&#39;');

              const refreshRowSearch = (row) => {
                const title = row.querySelector('[data-field="title"]')?.textContent || '';
                const desc = row.querySelector('[data-field="description"]')?.textContent || '';
                const student = row.querySelector('[data-field="studentId"]')?.textContent || '';
                const category = row.querySelector('[data-field="categoryId"]')?.textContent || '';
                const date = row.querySelector('td:nth-child(<%= isUpdatePage ? 7 : 6 %>)')?.textContent || '';
                row.setAttribute('data-search', `${title} ${desc} ${student} ${category}`.toLowerCase());
                row.setAttribute('data-title', title.toLowerCase());
                row.setAttribute('data-category', category.toLowerCase());
                row.setAttribute('data-date', date.toLowerCase());
              };

              const finishEdit = (cell, originalMarkup) => {
                cell.classList.remove('is-editing');
                if (originalMarkup != null) {
                  cell.innerHTML = originalMarkup;
                }
              };

              const saveCell = async (cell, newValue, displayValue, originalMarkup) => {
                if (cell.classList.contains('is-saving')) return;
                const row = cell.closest('.task-data-row');
                if (!row) return;
                const taskId = row.getAttribute('data-task-id');
                const field = cell.getAttribute('data-field');
                const oldValue = cell.getAttribute('data-value') || '';
                const normalized = String(newValue || '').trim();

                if (normalized === oldValue) {
                  finishEdit(cell, originalMarkup);
                  return;
                }

                cell.classList.add('is-saving');
                try {
                  const body = new URLSearchParams({ field, value: normalized });
                  const response = await fetch(`/admin/tasks/${taskId}/cell-update`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
                    body
                  });
                  const data = await response.json();
                  if (!response.ok || !data.ok) {
                    throw new Error(data.error || 'Kayıt başarısız.');
                  }

                  cell.setAttribute('data-value', data.value || '');
                  if (field === 'title') {
                    cell.innerHTML = `<strong>${escapeHtml(data.display)}</strong>`;
                  } else {
                    cell.textContent = data.display || '-';
                  }
                  refreshRowSearch(row);
                } catch (err) {
                  alert(err.message || 'Kayıt başarısız.');
                  if (field === 'title') {
                    cell.innerHTML = `<strong>${escapeHtml(oldValue)}</strong>`;
                  } else if (field === 'description') {
                    cell.textContent = oldValue || '-';
                  } else {
                    cell.textContent = displayValue;
                  }
                } finally {
                  cell.classList.remove('is-saving');
                  cell.classList.remove('is-editing');
                }
              };

              editableCells.forEach((cell) => {
                if (!isInlineEditPage) return;
                cell.addEventListener('click', () => {
                  if (cell.classList.contains('is-editing')) return;

                  const field = cell.getAttribute('data-field');
                  const currentValue = cell.getAttribute('data-value') || '';
                  const currentDisplay = cell.textContent.trim();
                  const originalMarkup = cell.innerHTML;
                  cell.classList.add('is-editing');

                  if (field === 'studentId' || field === 'categoryId') {
                    const options = field === 'studentId' ? studentOptions : categoryOptions;
                    const select = document.createElement('select');
                    select.className = 'cell-editor';
                    options.forEach((item) => {
                      const option = document.createElement('option');
                      option.value = item.value;
                      option.textContent = item.label;
                      if (item.value === currentValue) option.selected = true;
                      select.appendChild(option);
                    });
                    cell.innerHTML = '';
                    cell.appendChild(select);
                    select.focus();
                    select.addEventListener('change', () => {
                      const selected = options.find((item) => item.value === select.value);
                      saveCell(cell, select.value, selected ? selected.label : currentDisplay, originalMarkup);
                    });
                    select.addEventListener('blur', () => {
                      if (!cell.classList.contains('is-saving')) {
                        finishEdit(cell, originalMarkup);
                      }
                    });
                    return;
                  }

                  const input = document.createElement('input');
                  input.type = field === 'estimatedTime' ? 'time' : 'text';
                  input.className = 'cell-editor';
                  input.value = currentValue;
                  cell.innerHTML = '';
                  cell.appendChild(input);
                  input.focus();
                  if (field !== 'estimatedTime') input.select();

                  const commit = () => saveCell(cell, input.value, currentDisplay, originalMarkup);
                  input.addEventListener('keydown', (event) => {
                    if (event.key === 'Enter') {
                      event.preventDefault();
                      commit();
                    }
                    if (event.key === 'Escape') {
                      finishEdit(cell, originalMarkup);
                    }
                  });
                  input.addEventListener('blur', commit);
                });
              });
            })();
          </script>
          <% } %>
        </section>
        <% } %>
        <% } %>

