          <form method="post" action="/admin/goals/<%= g.id %>/delete" onsubmit="return confirm('Bu hedef silinsin mi?')">
            <input type="hidden" name="next" value="/admin/goals?bolum=hedefler&ay=<%= gv.monthStart.slice(0,7) %>&goalStudentId=<%= gv.student.id %>" />
            <button type="submit" class="danger">Hedefi Sil</button>
          </form>
        </section>
        <% }) %>
        <% } %>
        <% } %>
        <% } %>
        <% } %>

        <% if (currentPage === 'sport' && sportAdmin) { %>
        <% const sa = sportAdmin; %>
        <header class="content-header">
