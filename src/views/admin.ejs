        <% if (currentSection === 'gun') { %>
        <section class="panel">
          <h3><%= weeklyAnalysis.detail.student.name %> — Gün Kırılımı</h3>
          <div class="table-wrap">
            <table class="analysis-day-table stack-mobile">
              <thead>
                <tr>
                  <th>Gün</th>
                  <th>Tarih</th>
                  <th>Takvim</th>
                  <th>Görev</th>
                  <th>Yapılan</th>
                  <th>Tamamlama</th>
                  <th>Soru</th>
                  <th>Doğruluk</th>
                  <th>Süre (dk)</th>
                  <th>Kalkış</th>
                  <th>Uyanma</th>
                  <th>Spor Saati</th>
                  <th>Spor</th>
                  <th>Namaz</th>
                  <% studyKinds.forEach((k) => { %><th><%= k.label %></th><% }) %>
                </tr>
              </thead>
              <tbody>
                <% weeklyAnalysis.detail.days.forEach((d) => { %>
                <tr class="<%= d.due > 0 ? '' : (!d.isSchoolDay ? 'day-off' : '') %>">
                  <td><%= d.dayName %></td>
                  <td><%= d.date %></td>
                  <td>
                    <% if (d.isSchoolDay) { %>
                    <span class="day-badge school">Ders günü</span>
                    <% } else { %>
                    <span class="day-badge off"><%= d.dayLabel %></span>
                    <% } %>
                  </td>
                  <td><%= d.due %></td>
                  <td><%= d.done %></td>
                  <td><%= d.completionRate === null ? '-' : d.completionRate + '%' %></td>
                  <td><%= d.questionTotal %></td>
                  <td><%= d.accuracy === null ? '-' : d.accuracy + '%' %></td>
                  <td><%= d.duration %></td>
                  <td>
                    <%= d.wake && d.wake.wokeAt ? d.wake.wokeAt : '-' %><% if (d.wake && d.wake.delayMinutes) { %>
                    <span class="muted">(+<%= d.wake.delayMinutes %> dk)</span><% } %>
                  </td>
                  <td>
                    <% if (!d.wake) { %>
                    <span class="muted">-</span>
                    <% } else if (d.wake.status === 'on_time') { %>
                    <span class="day-badge ok">Zamanında</span>
                    <% } else if (d.wake.status === 'late') { %>
                    <span class="day-badge late">Geç</span>
                    <% } else { %>
                    <span class="day-badge miss">Kaçırıldı</span>
                    <% } %>
                  </td>
                  <td>
                    <%= d.sport && d.sport.doneAt ? d.sport.doneAt : '-' %><% if (d.sport && d.sport.delayMinutes) { %>
                    <span class="muted">(+<%= d.sport.delayMinutes %> dk)</span><% } %>
                  </td>
                  <td>
                    <% if (!d.sport) { %>
                    <span class="muted">-</span>
                    <% } else if (d.sport.status === 'on_time') { %>
                    <span class="day-badge ok">Zamanında</span>
                    <% } else if (d.sport.status === 'late') { %>
                    <span class="day-badge late">Geç</span>
                    <% } else { %>
                    <span class="day-badge miss">Yapılmadı</span>
                    <% } %>
                  </td>
                  <%# Gunde bes vakit: tek rozet yerine kirilim. %>
                  <td>
                    <% if (!d.prayer) { %>
                    <span class="muted">-</span>
                    <% } else { %>
                    <span class="day-badge <%= d.prayer.onTime === d.prayer.tracked ? 'ok' : d.prayer.onTime ? 'late' : 'miss' %>">
                      <%= d.prayer.onTime %>/<%= d.prayer.tracked %> vaktinde
                    </span>
                    <% if (d.prayer.qada) { %><br /><small class="muted"><%= d.prayer.qada %> kaza</small><% } %>
                    <% if (d.prayer.missed) { %><br /><small class="muted"><%= d.prayer.missed %> kılınmadı</small><% } %>
                    <% } %>
                  </td>
                  <% studyKinds.forEach((k) => { const sl = d.studyLogs[k.key]; %>
                  <td>
                    <% if (!sl) { %>
                    <span class="muted">-</span>
                    <% } else { %>
                    <span class="state-pill <%= sl.status %>"><%= sl.statusText %></span>
                    <% if (sl.status === 'done' || sl.status === 'makeup') { %>
                    <br /><small class="muted">
                      <%= sl.actualMinutes === null ? sl.minutes : sl.actualMinutes %> dk<%
                      if (sl.actualMinutes === null) { %> <span title="Gerçek süre girilmedi, plan sayılıyor">(plan)</span><% } %>
                    </small>
                    <% } %>
                    <% } %>
                  </td>
                  <% }) %>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
        <% } %>
        <% } else { %>
        <% if (['kategori', 'gun'].includes(currentSection)) { %>
        <section class="panel">
          <p class="muted">Kategori ve gün kırılımını görmek için yukarıdaki tablodan bir öğrenci seçin.</p>
        </section>
        <% } %>
        <% } %>
        <% } %>

