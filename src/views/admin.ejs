<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Paneli</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="shell">
      <aside class="sidebar">
        <div class="sidebar-brand">
          <span class="sidebar-mark" aria-hidden="true"><%- menuIcons.dashboard %></span>
          <div>
            <h1 class="sidebar-title">Öğrenci Takip</h1>
            <p class="sidebar-kicker">Yönetim Paneli</p>
          </div>
        </div>

        <%# MENU TEK KAYNAKTAN (src/menu.js) basilir: satirlar, ikonlar,
            aktiflik ve alt bolumler orada tanimli. Bir sayfanin alanlari
            burada acilir; masaustunde satirin uzerine gelince (ya da klavyeyle
            odaklaninca) ucan liste, telefonda aktif sayfanin altinda serit. %>
        <nav class="menu">
          <% menuTree.forEach((item) => { %>
          <div class="menu-item <%= item.aktif ? 'active' : '' %> <%= item.sections.length ? 'has-sub' : '' %>">
            <a href="<%= item.href %>" class="menu-link <%= item.aktif ? 'active' : '' %>"><%- menuIcons[item.icon] %><%= item.label %><% if (item.sections.length) { %><span class="menu-caret" aria-hidden="true">›</span><% } %></a>
            <% if (item.sections.length) { %>
            <div class="submenu">
              <p class="submenu-title"><%= item.label %></p>
              <% item.sections.forEach((s) => { %>
              <a href="<%= s.href %>" class="submenu-link <%= s.aktif ? 'active' : '' %>"><%= s.label %></a>
              <% }) %>
            </div>
            <% } %>
          </div>
          <% }) %>
        </nav>

        <%# Kullanici blogu ve cikis en altta (referans tasarimdaki gibi):
            kimlik bilgisi menunun basini tutmuyor. %>
        <div class="sidebar-footer">
          <p class="sidebar-user">
            <strong><%= user.name %></strong>
            <span class="sidebar-role">Yönetici</span>
          </p>
          <form method="post" action="/logout" class="sidebar-logout">
            <button type="submit" class="ghost">Çıkış</button>
          </form>
        </div>
      </aside>

      <section class="content">
        <% if (message) { %>
        <div class="alert success"><%= message %></div>
        <% } %>
        <% if (error) { %>
        <div class="alert error"><%= error %></div>
        <% } %>

        <%# ALAN SEKMELERI: aktif sayfanin alanlari. Menudeki ucan listeyle
            ayni kaynaktan (src/menu.js) gelir; o liste yalnizca fareyle
            calistigi icin telefonda tek yol budur. %>
        <% const aktifMenu = menuTree.find((m) => m.aktif); %>
        <% if (aktifMenu && aktifMenu.sections.length) { %>
        <nav class="section-tabs" aria-label="<%= aktifMenu.label %> alanları">
          <% aktifMenu.sections.forEach((s) => { %>
          <a href="<%= s.href %>" class="section-tab <%= s.aktif ? 'active' : '' %>"><%= s.label %></a>
          <% }) %>
        </nav>
        <% } %>

        <% if (currentPage === 'dashboard') { %>
        <header class="content-header">
          <h2>Genel Durum</h2>
          <p class="muted">Günlük performans özeti - <strong><%= today %></strong></p>
        </header>

        <p class="section-label">Genel Durum</p>
        <section class="kpi-grid">
          <article class="kpi"><span class="kpi-icon" aria-hidden="true"><%- menuIcons.students %></span><p class="kpi-label">Öğrenci</p><p class="kpi-value"><%= students.length %></p></article>
          <article class="kpi"><span class="kpi-icon" aria-hidden="true"><%- menuIcons.tasks %></span><p class="kpi-label">Aktif Görev</p><p class="kpi-value"><%= activeTasks.length %></p></article>
          <article class="kpi"><span class="kpi-icon" aria-hidden="true"><%- menuIcons.archive %></span><p class="kpi-label">Arşiv Görev</p><p class="kpi-value"><%= archivedTasks.length %></p></article>
          <article class="kpi"><span class="kpi-icon" aria-hidden="true"><%- menuIcons.categories %></span><p class="kpi-label">Kategori</p><p class="kpi-value"><%= categories.length %></p></article>
        </section>

        <section class="panel">
          <h3>Bugünlük Öğrenci Durumu</h3>
          <!-- React island (kademeli geçiş): /api/admin/daily-board verisinden beslenir -->
          <div id="island-daily-board" data-endpoint="/api/admin/daily-board">
            <p class="muted">Yükleniyor...</p>
          </div>
        </section>
        <script type="module" src="/dist/daily-board.js"></script>
        <% } %>

        <% if (currentPage === 'students') { %>
        <header class="content-header">
          <h2>Öğrenci Yönetimi</h2>
        </header>
        <section class="grid">
        <% if (currentSection === 'ekle') { %>
          <article class="panel">
            <h3>Yeni Öğrenci</h3>
            <form method="post" action="/admin/students" class="stack">
              <input type="hidden" name="next" value="/admin/students?bolum=liste" />
              <label>Ad Soyad</label>
              <input type="text" name="name" required />
              <label>Kullanıcı Adı</label>
              <input type="text" name="username" required />
              <label>Şifre</label>
              <input type="text" name="password" minlength="6" required />
              <button type="submit">Kaydet</button>
            </form>
          </article>
        <% } %>

        <% if (currentSection === 'liste') { %>
          <article class="panel">
            <h3>Mevcut Öğrenciler</h3>
            <ul class="clean-list">
              <% students.forEach((s) => { %>
              <li><strong><%= s.name %></strong> (@<%= s.username %>)</li>
              <% }) %>
            </ul>
          </article>
        <% } %>
        </section>
        <% } %>

        <% if (currentPage === 'users') { %>
        <header class="content-header">
          <h2>Kullanıcı Yönetimi</h2>
          <p class="muted">Toplam kullanıcı: <strong><%= users.length %></strong> | Admin: <strong><%= adminCount %></strong></p>
        </header>

        <% if (currentSection === 'ekle') { %>
        <section class="grid two">
          <article class="panel">
            <h3>Yeni Kullanıcı</h3>
            <form method="post" action="/admin/users" class="stack">
              <input type="hidden" name="next" value="/admin/users?bolum=liste" />
              <label>Ad Soyad</label>
              <input type="text" name="name" required />
              <label>Kullanıcı Adı</label>
              <input type="text" name="username" required />
              <label>Şifre</label>
              <input type="text" name="password" minlength="6" required />
              <label>Rol</label>
              <select name="role" required>
                <option value="student">Öğrenci</option>
                <option value="admin">Admin</option>
              </select>
              <button type="submit">Kullanıcı Ekle</button>
            </form>
          </article>

          <article class="panel">
            <h3>Kullanım Notları</h3>
            <ul class="clean-list">
              <li>Son admin hesabı silinemez veya öğrenciye düşürülemez.</li>
              <li>Kendi hesabınızın rolünü veya silme işlemini bu ekrandan yapamazsınız.</li>
              <li>Şifre güncellemede minimum 6 karakter zorunludur.</li>
            </ul>
          </article>
        </section>
        <% } %>

        <% if (currentSection === 'liste') { %>
        <section class="panel">
          <h3>Mevcut Kullanıcılar</h3>
          <div class="table-wrap">
            <table class="stack-mobile">
              <thead>
                <tr>
                  <th>Ad Soyad</th>
                  <th>Kullanıcı Adı</th>
                  <th>Rol</th>
                  <th>Şifre</th>
                  <th>Sil</th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach((u) => { %>
                <tr>
                  <td><%= u.name %> <%= u.id === user.id ? '(Siz)' : '' %></td>
                  <td>@<%= u.username %></td>
                  <td>
                    <form method="post" action="/admin/users/<%= u.id %>/role" class="row center">
                      <input type="hidden" name="next" value="/admin/users?bolum=liste" />
                      <select name="role" <%= u.id === user.id ? 'disabled' : '' %>>
                        <option value="student" <%= u.role === 'student' ? 'selected' : '' %>>Öğrenci</option>
                        <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
                      </select>
                      <% if (u.id !== user.id) { %>
                      <button type="submit">Güncelle</button>
                      <% } %>
                    </form>
                  </td>
                  <td>
                    <form method="post" action="/admin/users/<%= u.id %>/password" class="row center">
                      <input type="hidden" name="next" value="/admin/users?bolum=liste" />
                      <input type="text" name="password" minlength="6" placeholder="Yeni şifre" required />
                      <button type="submit">Şifre Değiştir</button>
                    </form>
                  </td>
                  <td>
                    <% if (u.id !== user.id) { %>
                    <form method="post" action="/admin/users/<%= u.id %>/delete" onsubmit="return confirm('Bu kullanıcı silinsin mi?')">
                      <input type="hidden" name="next" value="/admin/users?bolum=liste" />
                      <button type="submit" class="danger">Sil</button>
                    </form>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
        <% } %>
        <% } %>

        <% if (currentPage === 'categories') { %>
        <header class="content-header">
          <h2>Kategori Yönetimi</h2>
        </header>
        <section class="grid">
        <% if (currentSection === 'ekle') { %>
          <article class="panel">
            <h3>Yeni Kategori</h3>
            <form method="post" action="/admin/categories" class="stack">
              <input type="hidden" name="next" value="/admin/categories?bolum=liste" />
              <label>Kategori Adı</label>
              <input type="text" name="name" required />
              <button type="submit">Ekle</button>
            </form>
          </article>
        <% } %>

        <% if (currentSection === 'liste') { %>
          <article class="panel">
            <h3>Kategori Listesi</h3>
            <ul class="clean-list">
              <% categories.forEach((c) => { %>
              <li class="row space-between center">
                <span><%= c.name %></span>
                <form method="post" action="/admin/categories/<%= c.id %>/delete" onsubmit="return confirm('Kategori silinsin mi?')">
                  <input type="hidden" name="next" value="/admin/categories?bolum=liste" />
                  <button type="submit" class="danger">Sil</button>
                </form>
              </li>
              <% }) %>
            </ul>
          </article>
        <% } %>
        </section>
        <% } %>

        <%# Gorev OLUSTURMA ve TOPLU GUNCELLEME sayfalari kaldirildi: gorevler
            artik yalnizca ders defterinden uretiliyor, elle gorev acilmiyor.
            Kalan iki sekme listeleme ve durum duzeltmedir. %>
        <% if (['tasks', 'tasks-active', 'tasks-status'].includes(currentPage)) { %>
        <% const taskSection = currentPage === 'tasks-status' ? 'status' : 'active'; %>
        <% const tasksPagePath = activeTaskFilters.studentId ? `/admin/tasks/${taskSection}?activeTaskStudentId=${activeTaskFilters.studentId}` : `/admin/tasks/${taskSection}`; %>
        <% const isUpdatePage = false; %>
        <% const isActivePage = taskSection === 'active'; %>
        <% const isInlineEditPage = false; %>
        <%# Toplu sil: "Tum Gorevler" listesinde satir kutulari + "Secilenleri Sil". %>
        <% const bulkSelect = isUpdatePage || isActivePage; %>
        <% const allTaskExportPath = activeTaskFilters.studentId ? `/admin/tasks/export-active?activeTaskStudentId=${activeTaskFilters.studentId}` : '/admin/tasks/export-active'; %>
        <header class="content-header">
          <h2>Görev Yönetimi</h2>
          <div class="row">
            <a href="/admin/tasks/active" class="button-link <%= taskSection === 'active' ? 'active' : '' %>">Tüm Görevler</a>
            <a href="/admin/tasks/status" class="button-link <%= taskSection === 'status' ? 'active' : '' %>">Durum Düzelt</a>
          </div>
        </header>

        <%# ISARETLEMENIN TEK GERI DONUSU. Duzeltilen sey gorev degil GOREV
            ORNEGIDIR (gorev + gun), cunku durum da o seviyede tutulur; panel
            bu yuzden gun bazli. %>
        <% if (taskSection === 'status') { %>
        <% const fix = taskStatusFixView || { students: [], rows: [], day: today, student: null }; %>
        <% const fixPagePath = `/admin/tasks/status?fixStudentId=${fix.student ? fix.student.id : ''}&fixDay=${fix.day}`; %>
        <section class="panel">
          <h3>Durum Düzelt</h3>
          <p class="muted">
            Öğrenci işaretlemeyi unuttuğunda otomatik mühürleme o görevi
            <strong>Yapılmadı</strong> yazar ve öğrenci tarafında bu geri
            alınamaz. Buradan günü seçip düzeltebilirsiniz. Her düzeltme
            <strong>kim yaptı, ne zaman ve neyin üzerine yazıldı</strong>
            bilgisiyle birlikte kaydedilir.
          </p>

          <div class="datatable-toolbar">
            <form method="get" action="/admin/tasks/status" class="row center status-fix-filter">
              <label for="fixStudentId">Öğrenci</label>
              <select id="fixStudentId" name="fixStudentId">
                <% fix.students.forEach((s) => { %>
                <option value="<%= s.id %>" <%= fix.student && fix.student.id === s.id ? 'selected' : '' %>><%= s.name %></option>
                <% }) %>
              </select>
              <label for="fixDay">Gün</label>
              <input id="fixDay" type="date" name="fixDay" value="<%= fix.day %>" />
              <button type="submit">Göster</button>
            </form>
            <div class="row center">
              <a class="button-link" href="/admin/tasks/status?fixStudentId=<%= fix.student ? fix.student.id : '' %>&amp;fixDay=<%= fix.prevDay %>">← Önceki gün</a>
              <a class="button-link" href="/admin/tasks/status?fixStudentId=<%= fix.student ? fix.student.id : '' %>&amp;fixDay=<%= fix.today %>">Bugün</a>
              <a class="button-link" href="/admin/tasks/status?fixStudentId=<%= fix.student ? fix.student.id : '' %>&amp;fixDay=<%= fix.nextDay %>">Sonraki gün →</a>
            </div>
          </div>

          <% if (fix.beforeSystemStart) { %>
          <p class="muted">
            <strong>Uyarı:</strong> <%= fix.day %>, sistem taban tarihinden
            (<%= fix.systemStartDate %>) önce. O günlere durum yazılamaz —
            açılıştaki temizlik bu kayıtları zaten siliyor.
          </p>
          <% } %>

          <% if (!fix.student) { %>
          <p class="muted">Öğrenci yok.</p>
          <% } else if (!fix.rows.length) { %>
          <p class="muted"><%= fix.day %> günü <%= fix.student.name %> için görev yok.</p>
          <% } else { %>
          <p class="muted">
            <%= fix.day %> · <%= fix.student.name %> — <%= fix.rows.length %> görev,
            <%= fix.doneCount %> tanesi yapıldı.
          </p>

          <%# GUNUN TAMAMINI ONAYLA. Gecmis gunler mühürleyici tarafından toplu
              "Yapılmadı" yazıldığı için, o gün gerçekten çalışıldıysa görevleri
              tek tek düzeltmek gerekiyordu (bir günde 4-5 görev olabiliyor). %>
          <% if (!fix.beforeSystemStart) { %>
          <form method="post" action="/admin/tasks/status-fix-bulk" class="row center status-fix-bulk"
                onsubmit="return confirm('<%= fix.day %> günündeki <%= fix.rows.length %> görevin tümü işaretlensin mi?')">
            <input type="hidden" name="next" value="<%= fixPagePath %>" />
            <input type="hidden" name="studentId" value="<%= fix.student.id %>" />
            <input type="hidden" name="day" value="<%= fix.day %>" />
            <span class="muted">Günün tamamı:</span>
            <input type="text" name="note" maxlength="300" placeholder="Gerekçe (opsiyonel)" />
            <button type="submit" name="action" value="done">Tümü Yapıldı</button>
            <button type="submit" name="action" value="not_done">Tümü Yapılmadı</button>
          </form>
          <% } %>

          <div class="table-wrap">
            <table class="task-table stack-mobile">
              <thead>
                <tr>
                  <th>Son Saat</th>
                  <th>Görev</th>
                  <th>Kategori</th>
                  <th>Durum</th>
                  <th>Düzelt</th>
                </tr>
              </thead>
              <tbody>
                <% fix.rows.forEach((r) => { %>
                <tr>
                  <td class="single-line-cell"><%= r.deadline %></td>
                  <td><strong><%= r.task.title %></strong></td>
                  <td class="single-line-cell"><%= r.task.category ? r.task.category.name : '-' %></td>
                  <td>
                    <span class="task-state-icon <%= r.status === 'done' ? 'ok' : r.status === 'not_done' ? 'bad' : 'idle' %>">
                      <%= r.status === 'done' ? '✓' : r.status === 'not_done' ? '✕' : '○' %>
                    </span>
                    <%= r.statusText %>
                    <% if (r.correctedAt) { %>
                    <small class="muted status-fix-trace">
                      Düzeltildi<%= r.correctedByName ? ` · ${r.correctedByName}` : '' %>
                      (<%= r.previousStatusText %> → <%= r.statusText %>)<%= r.correctionNote ? ` · ${r.correctionNote}` : '' %>
                    </small>
                    <% } %>
                  </td>
                  <td>
                    <%# Taban tarihinden onceki gunlere rota zaten yazmiyor
                        (acilistaki temizlik siler); dugmeyi de gostermeyelim,
                        yoksa basilip hata donen olu bir kontrol olurdu. %>
                    <% if (fix.beforeSystemStart) { %>
                    <span class="muted">Yazılamaz</span>
                    <% } else { %>
                    <form method="post" action="/admin/tasks/<%= r.task.id %>/status-fix" class="status-fix-form">
                      <input type="hidden" name="next" value="<%= fixPagePath %>" />
                      <input type="hidden" name="day" value="<%= fix.day %>" />
                      <input type="text" name="note" maxlength="300" placeholder="Gerekçe (opsiyonel)" />
                      <div class="task-table-actions">
                        <% if (r.status !== 'done') { %>
                        <button type="submit" name="action" value="done">Yapıldı</button>
                        <% } %>
                        <% if (r.status !== 'not_done') { %>
                        <button type="submit" name="action" value="not_done">Yapılmadı</button>
                        <% } %>
                        <%# Temizleme yalnizca KALICI oldugunda acik: suresi dolmus
                            bir ornekte muhurleyici 5 dakika icinde yeniden
                            'not_done' yazardi. %>
                        <% if (r.canClear) { %>
                        <button type="submit" name="action" value="clear" class="danger">İşareti Kaldır</button>
                        <% } %>
                      </div>
                    </form>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </section>
        <% } %>


        <% if (isUpdatePage || isActivePage) { %>
        <section class="panel">
          <div class="datatable-toolbar">
            <form method="get" action="/admin/tasks/<%= taskSection %>" class="row center">
              <label for="activeTaskStudentId">Öğrenci</label>
              <select id="activeTaskStudentId" name="activeTaskStudentId">
                <option value="">Tüm Öğrenciler</option>
                <% students.forEach((s) => { %>
                <option value="<%= s.id %>" <%= activeTaskFilters.studentId === s.id ? 'selected' : '' %>><%= s.name %></option>
                <% }) %>
              </select>
              <button type="submit">Filtrele</button>
              <% if (activeTaskFilters.studentId) { %>
              <a class="button-link" href="/admin/tasks/<%= taskSection %>">Temizle</a>
              <% } %>
              <% if (isActivePage) { %>
              <a class="button-link" href="<%= allTaskExportPath %>">Excel İndir</a>
              <% } %>
            </form>
            <% if (bulkSelect) { %>
            <form
              id="bulkTaskForm"
              method="post"
              action="/admin/tasks/bulk-delete"
              class="row center"
              onsubmit="return confirm('Seçili görevler kalıcı olarak silinsin mi?');"
            >
              <input type="hidden" name="next" value="<%= tasksPagePath %>" />
              <button type="submit" class="danger" id="bulkDeleteBtn" disabled>
                Seçilenleri Sil (<span id="bulkDeleteCount">0</span>)
              </button>
            </form>
            <% } %>
            <div class="datatable-filter-row">
              <div class="datatable-search">
                <label for="taskSearchInput">Genel Ara</label>
                <input id="taskSearchInput" type="text" placeholder="Başlık, konu, öğrenci, kategori..." />
              </div>
              <div class="datatable-search">
                <label for="taskTitleFilter">Başlık</label>
                <input id="taskTitleFilter" type="text" placeholder="Başlığa göre filtrele" />
              </div>
              <div class="datatable-search">
                <label for="taskCategoryFilter">Kategori</label>
                <select id="taskCategoryFilter">
                  <option value="">Tüm Kategoriler</option>
                  <% categories.forEach((c) => { %>
                  <option value="<%= c.name %>"><%= c.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="datatable-search">
                <label for="taskDateFilter">Tarih</label>
                <input id="taskDateFilter" type="text" placeholder="YYYY-MM-DD" />
              </div>
            </div>
          </div>

          <% if (!taskTableTasks.length) { %>
          <p class="muted">Görev yok.</p>
          <% } %>
          <% if (taskTableTasks.length) { %>

          <div class="table-wrap">
            <table class="task-table stack-mobile <%= bulkSelect ? 'has-bulk-select' : '' %>" id="adminTasksTable">
              <thead>
                <tr>
                  <% if (bulkSelect) { %>
                  <th><input id="bulkSelectAll" type="checkbox" title="Görünenleri seç" /></th>
                  <% } %>
                  <th>Tarih</th>
                  <th>Başlık</th>
                  <%# Ders gorevinde bu sutun o ders saatine YAZILAN KONUDUR. %>
                  <th>İşlenen Konu</th>
                  <th>Öğrenci</th>
                  <th>Kategori</th>
                  <th>Son Saat</th>
                  <th>İşlem</th>
                </tr>
              </thead>
              <tbody>
                <% taskTableTasks.forEach((t) => { %>
                <% const rowSearchText = `${t.title || ''} ${t.description || ''} ${t.student ? t.student.name : ''} ${t.category ? t.category.name : ''}`.toLowerCase(); %>
                <tr class="task-data-row" data-task-id="<%= t.id %>" data-search="<%= rowSearchText %>" data-title="<%= (t.title || '').toLowerCase() %>" data-category="<%= (t.category ? t.category.name : '').toLowerCase() %>" data-date="<%= (t.dateText || '').toLowerCase() %>">
                  <% if (bulkSelect) { %>
                  <td><input type="checkbox" name="taskIds" value="<%= t.id %>" form="bulkTaskForm" /></td>
                  <% } %>
                  <td><%= t.dateText %></td>
                  <td class="<%= isInlineEditPage ? 'editable-cell' : '' %>" data-field="title" data-value="<%= t.title || '' %>"><strong><%= t.title %></strong><% if (t.lessonMeta) { %><small class="muted lesson-topic"><%= t.lessonMeta %></small><% } %></td>
                  <td class="<%= isInlineEditPage ? 'editable-cell' : '' %>" data-field="description" data-value="<%= t.description || '' %>"><% if (t.lessonMeta) { %><%= t.lessonTopic || 'Konu yazılmadı' %><% } else { %><%= t.description || '-' %><% } %></td>
                  <td class="<%= isInlineEditPage ? 'editable-cell' : '' %>" data-field="studentId" data-value="<%= t.studentId || '' %>"><%= t.student ? t.student.name : 'Öğrenci yok' %></td>
                  <td class="<%= isInlineEditPage ? 'editable-cell' : '' %>" data-field="categoryId" data-value="<%= t.categoryId || '' %>"><%= t.category ? t.category.name : 'Kategori yok' %></td>
                  <td class="<%= isInlineEditPage ? 'editable-cell' : '' %>" data-field="estimatedTime" data-value="<%= t.estimatedTime || '' %>"><%= t.estimatedTime || '-' %></td>
                  <td>
                    <div class="task-table-actions">
                      <form method="post" action="/admin/tasks/<%= t.id %>/delete" onsubmit="return confirm('Görev kalıcı olarak silinsin mi?')">
                        <input type="hidden" name="next" value="<%= tasksPagePath %>" />
                        <button type="submit" class="danger">Sil</button>
                      </form>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <script>
            (() => {
              const isUpdatePage = <%= isUpdatePage ? 'true' : 'false' %>;
              const bulkSelect = <%= bulkSelect ? 'true' : 'false' %>;
              const isInlineEditPage = <%= isInlineEditPage ? 'true' : 'false' %>;
              const selectAll = document.getElementById('bulkSelectAll');
              const bulkDeleteBtn = document.getElementById('bulkDeleteBtn');
              const bulkDeleteCount = document.getElementById('bulkDeleteCount');
              const checkboxes = Array.from(
                document.querySelectorAll('input[name="taskIds"][form="bulkTaskForm"]')
              );
              const searchInput = document.getElementById('taskSearchInput');
              const titleFilterInput = document.getElementById('taskTitleFilter');
              const categoryFilterInput = document.getElementById('taskCategoryFilter');
              const dateFilterInput = document.getElementById('taskDateFilter');
              const dataRows = Array.from(document.querySelectorAll('.task-data-row'));
              const editableCells = Array.from(document.querySelectorAll('.editable-cell'));
              const studentOptions = <%- JSON.stringify(students.map((s) => ({ value: s.id, label: s.name }))) %>;
              const categoryOptions = <%- JSON.stringify(categories.map((c) => ({ value: c.id, label: c.name }))) %>;

              // "Tumunu sec" YALNIZCA filtreden gecen satirlari kapsar. Onceden
              // tum kutulari isaretliyordu: kategoriye gore filtreleyip basan
              // biri, ekranda gormedigi gorevleri de toplu guncellemeye
              // sokuyordu (orn. YZ'yi filtreleyip saat yazarken YDS gorevleri de
              // degisiyordu). Gizlenen satirin kutusu ayrica temizlenir, yoksa
              // filtre daraltildiginda eski secim formda asili kalirdi.
              const gorunurKutular = () =>
                checkboxes.filter((input) => {
                  const row = input.closest('.task-data-row');
                  return row && !row.hidden;
                });

              // Secili sayisini "Secilenleri Sil (N)" dugmesine yansit; sifirda
              // dugmeyi pasif tut (bos formu gondermek anlamsiz).
              const syncBulkButton = () => {
                if (!bulkDeleteBtn) return;
                const secili = checkboxes.filter((i) => i.checked).length;
                if (bulkDeleteCount) bulkDeleteCount.textContent = String(secili);
                bulkDeleteBtn.disabled = secili === 0;
              };

              const syncHeader = () => {
                if (selectAll) {
                  const gorunur = gorunurKutular();
                  selectAll.checked = gorunur.length > 0 && gorunur.every((input) => input.checked);
                }
                syncBulkButton();
              };

              if (selectAll && bulkSelect) {
                selectAll.addEventListener('change', () => {
                  gorunurKutular().forEach((input) => {
                    input.checked = selectAll.checked;
                  });
                  syncBulkButton();
                });
              }

              if (bulkSelect) {
                checkboxes.forEach((input) => {
                  input.addEventListener('change', syncHeader);
                });
                syncBulkButton();
              }

              const applySearch = () => {
                const term = String((searchInput && searchInput.value) || '').toLowerCase().trim();
                const titleTerm = String((titleFilterInput && titleFilterInput.value) || '').toLowerCase().trim();
                const categoryTerm = String((categoryFilterInput && categoryFilterInput.value) || '').toLowerCase().trim();
                const dateTerm = String((dateFilterInput && dateFilterInput.value) || '').toLowerCase().trim();
                dataRows.forEach((row) => {
                  const text = row.getAttribute('data-search') || '';
                  const titleText = row.getAttribute('data-title') || '';
                  const categoryText = row.getAttribute('data-category') || '';
                  const dateText = row.getAttribute('data-date') || '';
                  const matchSearch = !term || text.includes(term);
                  const matchTitle = !titleTerm || titleText.includes(titleTerm);
                  const matchCategory = !categoryTerm || categoryText.includes(categoryTerm);
                  const matchDate = !dateTerm || dateText.includes(dateTerm);
                  const visible = matchSearch && matchTitle && matchCategory && matchDate;
                  row.hidden = !visible;
                  if (!visible) {
                    const kutu = row.querySelector('input[name="taskIds"]');
                    if (kutu) kutu.checked = false;
                  }
                });
                syncHeader();
              };

              if (searchInput) {
                searchInput.addEventListener('input', applySearch);
              }
              if (titleFilterInput) {
                titleFilterInput.addEventListener('input', applySearch);
              }
              if (categoryFilterInput) {
                categoryFilterInput.addEventListener('change', applySearch);
              }
              if (dateFilterInput) {
                dateFilterInput.addEventListener('input', applySearch);
              }

              const escapeHtml = (value) =>
                String(value || '')
                  .replace(/&/g, '&amp;')
                  .replace(/</g, '&lt;')
                  .replace(/>/g, '&gt;')
                  .replace(/"/g, '&quot;')
                  .replace(/'/g, '&#39;');

              const refreshRowSearch = (row) => {
                const title = row.querySelector('[data-field="title"]')?.textContent || '';
                const desc = row.querySelector('[data-field="description"]')?.textContent || '';
                const student = row.querySelector('[data-field="studentId"]')?.textContent || '';
                const category = row.querySelector('[data-field="categoryId"]')?.textContent || '';
                const date = row.querySelector('td:nth-child(<%= bulkSelect ? 2 : 1 %>)')?.textContent || '';
                row.setAttribute('data-search', `${title} ${desc} ${student} ${category}`.toLowerCase());
                row.setAttribute('data-title', title.toLowerCase());
                row.setAttribute('data-category', category.toLowerCase());
                row.setAttribute('data-date', date.toLowerCase());
              };

              const finishEdit = (cell, originalMarkup) => {
                cell.classList.remove('is-editing');
                if (originalMarkup != null) {
                  cell.innerHTML = originalMarkup;
                }
              };

              const saveCell = async (cell, newValue, displayValue, originalMarkup) => {
                if (cell.classList.contains('is-saving')) return;
                const row = cell.closest('.task-data-row');
                if (!row) return;
                const taskId = row.getAttribute('data-task-id');
                const field = cell.getAttribute('data-field');
                const oldValue = cell.getAttribute('data-value') || '';
                const normalized = String(newValue || '').trim();

                if (normalized === oldValue) {
                  finishEdit(cell, originalMarkup);
                  return;
                }

                cell.classList.add('is-saving');
                try {
                  const body = new URLSearchParams({ field, value: normalized });
                  const response = await fetch(`/admin/tasks/${taskId}/cell-update`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
                    body
                  });
                  const data = await response.json();
                  if (!response.ok || !data.ok) {
                    throw new Error(data.error || 'Kayıt başarısız.');
                  }

                  cell.setAttribute('data-value', data.value || '');
                  if (field === 'title') {
                    cell.innerHTML = `<strong>${escapeHtml(data.display)}</strong>`;
                  } else {
                    cell.textContent = data.display || '-';
                  }
                  refreshRowSearch(row);
                } catch (err) {
                  alert(err.message || 'Kayıt başarısız.');
                  if (field === 'title') {
                    cell.innerHTML = `<strong>${escapeHtml(oldValue)}</strong>`;
                  } else if (field === 'description') {
                    cell.textContent = oldValue || '-';
                  } else {
                    cell.textContent = displayValue;
                  }
                } finally {
                  cell.classList.remove('is-saving');
                  cell.classList.remove('is-editing');
                }
              };

              editableCells.forEach((cell) => {
                if (!isInlineEditPage) return;
                cell.addEventListener('click', () => {
                  if (cell.classList.contains('is-editing')) return;

                  const field = cell.getAttribute('data-field');
                  const currentValue = cell.getAttribute('data-value') || '';
                  const currentDisplay = cell.textContent.trim();
                  const originalMarkup = cell.innerHTML;
                  cell.classList.add('is-editing');

                  if (field === 'studentId' || field === 'categoryId') {
                    const options = field === 'studentId' ? studentOptions : categoryOptions;
                    const select = document.createElement('select');
                    select.className = 'cell-editor';
                    options.forEach((item) => {
                      const option = document.createElement('option');
                      option.value = item.value;
                      option.textContent = item.label;
                      if (item.value === currentValue) option.selected = true;
                      select.appendChild(option);
                    });
                    cell.innerHTML = '';
                    cell.appendChild(select);
                    select.focus();
                    select.addEventListener('change', () => {
                      const selected = options.find((item) => item.value === select.value);
                      saveCell(cell, select.value, selected ? selected.label : currentDisplay, originalMarkup);
                    });
                    select.addEventListener('blur', () => {
                      if (!cell.classList.contains('is-saving')) {
                        finishEdit(cell, originalMarkup);
                      }
                    });
                    return;
                  }

                  const input = document.createElement('input');
                  input.type = field === 'estimatedTime' ? 'time' : 'text';
                  input.className = 'cell-editor';
                  input.value = currentValue;
                  cell.innerHTML = '';
                  cell.appendChild(input);
                  input.focus();
                  if (field !== 'estimatedTime') input.select();

                  const commit = () => saveCell(cell, input.value, currentDisplay, originalMarkup);
                  input.addEventListener('keydown', (event) => {
                    if (event.key === 'Enter') {
                      event.preventDefault();
                      commit();
                    }
                    if (event.key === 'Escape') {
                      finishEdit(cell, originalMarkup);
                    }
                  });
                  input.addEventListener('blur', commit);
                });
              });
            })();
          </script>
          <% } %>
        </section>
        <% } %>
        <% } %>

