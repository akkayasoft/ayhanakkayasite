        <% if (wakeAdmin.detail && wakeAdmin.detail.routine) { %>
        <header class="content-header">
          <h3><%= wakeAdmin.selected.name %> · Son <%= wakeAdmin.detail.summary.gunSayisi %> Gün</h3>
        </header>

        <section class="kpi-grid">
          <article class="kpi <%= wakeAdmin.detail.streak > 0 ? 'ok' : '' %>">
            <p class="kpi-label">Zamanında Serisi</p>
            <p class="kpi-value"><%= wakeAdmin.detail.streak %> gün</p>
          </article>
          <article class="kpi">
            <p class="kpi-label">Zamanında Oranı</p>
            <p class="kpi-value"><%= wakeAdmin.detail.summary.onTimeRate === null ? '-' : wakeAdmin.detail.summary.onTimeRate + '%' %></p>
          </article>
          <article class="kpi">
            <p class="kpi-label">Ortalama Uyanma</p>
            <p class="kpi-value"><%= wakeAdmin.detail.summary.averageWake || '-' %></p>
          </article>
          <article class="kpi">
            <p class="kpi-label">Ortalama Gecikme</p>
            <p class="kpi-value"><%= wakeAdmin.detail.summary.averageDelay === null ? '-' : wakeAdmin.detail.summary.averageDelay + ' dk' %></p>
          </article>
        </section>

        <section class="panel">
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Tarih</th>
                  <th>Gün</th>
                  <th>Hedef</th>
                  <th>Kalkış</th>
                  <th>Gecikme</th>
                  <th>Durum</th>
                </tr>
              </thead>
              <tbody>
                <% wakeAdmin.detail.rows.forEach((r) => { %>
                <tr>
                  <td><%= r.day %></td>
                  <td><%= r.gunAdi %></td>
                  <td><%= r.targetTime %></td>
                  <td><%= r.wokeAt || '-' %></td>
                  <td><%= r.delayMinutes ? r.delayMinutes + ' dk' : '-' %></td>
                  <td>
                    <% if (r.status === 'on_time') { %>
                    <span class="day-badge ok">Zamanında</span>
                    <% } else if (r.status === 'late') { %>
                    <span class="day-badge late">Geç</span>
                    <% } else if (r.status === 'missed') { %>
                    <span class="day-badge miss">Kaçırıldı</span>
                    <% } else if (r.status === 'pending') { %>
                    <span class="day-badge off">Bekliyor</span>
                    <% } else { %>
                    <span class="muted">-</span>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
        <% } %>
        <% } %>

        <% if (currentPage === 'yds' && ydsView) { %>
        <header class="content-header">
          <h2>YDS / YÖKDİL Takibi</h2>
          <p class="muted">
            Kaynak: yds.obs · aynı sunucudaki durum dosyası okunur, 5 dakikada bir
            otomatik yenilenir. Çözülen sorular <strong>Soru Takibi</strong>'ne de
            yazılır, böylece Haftalık Analiz'e akar.
          </p>
        </header>

        <% if (!ydsView.student) { %>
        <section class="panel narrow">
          <h3>Öğrenci eşleşmedi</h3>
          <p class="muted">
            YDS verisi <strong>@<%= ydsView.expectedUsername %></strong> kullanıcı adlı
            öğrenciye yazılır ama böyle bir öğrenci yok. Bu kullanıcı adıyla bir öğrenci
            ekleyin ya da <code>YDS_STUDENT_USERNAME</code> ortam değişkenini değiştirin.
          </p>
          <p class="muted">Okunan dosya: <code><%= ydsView.filePath %></code></p>
        </section>
        <% } else { %>

        <% if (ydsView.sync && ydsView.sync.lastError) { %>
        <section class="panel narrow">
          <h3>Veri çekilemiyor</h3>
          <p class="muted"><%= ydsView.sync.lastError %></p>
          <p class="muted">Okunan dosya: <code><%= ydsView.filePath %></code></p>
        </section>
        <% } %>

        <section class="kpi-grid">
          <article class="kpi <%= ydsView.sync && ydsView.sync.streakCount > 0 ? 'ok' : '' %>">
            <p class="kpi-label">Gün Serisi</p>
            <p class="kpi-value"><%= ydsView.sync ? ydsView.sync.streakCount : 0 %></p>
          </article>
          <article class="kpi">
            <p class="kpi-label">Hedef Tutan Gün</p>
            <p class="kpi-value"><%= ydsView.totals.goalDays %> / <%= ydsView.totals.dayCount %></p>
          </article>
          <article class="kpi">
            <p class="kpi-label">Çözülen Soru</p>
            <p class="kpi-value"><%= ydsView.totals.questionsSolved %></p>
          </article>
          <article class="kpi">
            <p class="kpi-label">Doğruluk (puanlı)</p>
            <p class="kpi-value"><%= ydsView.totals.accuracy === null ? '-' : ydsView.totals.accuracy + '%' %></p>
          </article>
          <article class="kpi">
            <p class="kpi-label">Öğrenilen Kelime</p>
            <p class="kpi-value"><%= ydsView.sync ? ydsView.sync.learnedCards : 0 %></p>
          </article>
        </section>

        <section class="panel narrow">
          <h3>Durum</h3>
          <ul class="clean-list">
            <li>Öğrenci: <strong><%= ydsView.student.name %></strong> (@<%= ydsView.student.username %>)</li>
            <% if (ydsView.sync) { %>
            <li>Günlük hedef: <%= ydsView.sync.goals.okuma %> okuma · <%= ydsView.sync.goals.kelime %> kelime · <%= ydsView.sync.goals.gramer %> gramer · <%= ydsView.sync.goals.test %> test</li>
            <li>En uzun seri: <%= ydsView.sync.streakMax %> gün<% if (ydsView.sync.streakLastDay) { %> · son: <%= ydsView.sync.streakLastDay %><% } %></li>
            <% if (ydsView.sync.planStart) { %><li>Plan başlangıcı: <%= ydsView.sync.planStart %></li><% } %>
            <li>Son senkron: <%= ydsView.sync.syncedAt ? new Date(ydsView.sync.syncedAt).toLocaleString('tr-TR') : 'hiç' %></li>
            <% } else { %>
            <li class="muted">Henüz senkron yapılmadı.</li>
            <% } %>
            <li class="muted">Dosya: <code><%= ydsView.filePath %></code></li>
          </ul>
          <form method="post" action="/admin/yds/sync" class="stack">
            <input type="hidden" name="next" value="/admin/yds" />
            <button type="submit">Şimdi Çek</button>
          </form>
        </section>

        <% if (ydsProgramView) { %>
        <section class="panel">
          <h3>Çalışma Programı</h3>
          <p class="muted">
            Kaynak: <%= ydsProgramView.kaynak %> · Sürüm <%= ydsProgramView.surum %> ·
            <%= ydsProgramView.baslangic %> - <%= ydsProgramView.bitis %> ·
            günde ~<%= ydsProgramView.gunlukDakika %> dk
          </p>
          <p class="muted">
            <%= ydsProgramView.toplamParca %> içerik parçası
            <%= ydsProgramView.dersGunu %> ders gününe yayıldı:
            <strong><%= ydsProgramView.doluGun %> gün</strong> içerikli,
            <strong><%= ydsProgramView.bekleyenGun %> gün</strong> içerik bekliyor.
            Bekleyen günlere konu uydurulmaz; yalnızca günlük çalışma görevi açılır.
            İçerik büyüyünce programı yeniden üretip aynı düğmeye bas — yeni içerik
            boş günlere yerleşir, geçmiş günler oynamaz.
          </p>

          <section class="kpi-grid">
            <article class="kpi">
              <p class="kpi-label">Programdaki Görev</p>
              <p class="kpi-value"><%= ydsProgramView.total %></p>
            </article>
            <article class="kpi">
              <p class="kpi-label">Aktarılan</p>
              <p class="kpi-value"><%= ydsProgramView.imported %></p>
            </article>
            <article class="kpi">
              <p class="kpi-label">Bekleyen</p>
              <p class="kpi-value"><%= ydsProgramView.pending %></p>
            </article>
          </section>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Kategori</th>
                  <th>Görev</th>
                  <th>Aktarılan</th>
                  <th>Toplam Süre</th>
                </tr>
              </thead>
              <tbody>
                <% ydsProgramView.turler.forEach((t) => { %>
                <tr>
                  <td><%= t.ad %></td>
                  <td><%= t.total %></td>
                  <td><%= t.imported %> / <%= t.total %></td>
                  <td><%= Math.round(t.sure / 60) %> saat</td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <% if (ydsView.student) { %>
          <form
            method="post"
            action="/admin/yds/program-import"
            class="stack"
            onsubmit="return confirm('<%= ydsProgramView.pending %> görev <%= ydsView.student.name %> adlı öğrencinin görevlerine eklensin mi?')"
          >
            <input type="hidden" name="next" value="/admin/yds" />
            <button type="submit" <%= ydsProgramView.pending === 0 ? 'disabled' : '' %>>
              <%= ydsProgramView.pending === 0 ? 'Aktarılacak yeni görev yok' : 'Görevlere Aktar' %>
            </button>
          </form>
          <% } %>
        </section>

        <section class="panel">
          <h3>Yaklaşan Görevler</h3>
          <% if (!ydsProgramView.upcoming.length) { %>
          <p class="muted">Bugünden sonraya planlanmış görev kalmadı.</p>
          <% } else { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Tarih</th>
                  <th>Gün</th>
                  <th>Tür</th>
                  <th>Başlık</th>
                  <th>Süre</th>
                  <th>Durum</th>
                </tr>
              </thead>
              <tbody>
                <% ydsProgramView.upcoming.forEach((g) => { %>
                <tr>
                  <td><%= g.tarih %></td>
                  <td><%= g.gunAdi %></td>
                  <td><%= g.turAdi %></td>
                  <td><%= g.baslik %><% if (g.tekrar) { %> <span class="muted">(<%= g.tekrar %>. tekrar)</span><% } %></td>
                  <td><%= g.sure %> dk</td>
                  <td>
                    <% if (g.imported) { %>
                    <span class="day-badge ok">Aktarıldı</span>
                    <% } else { %>
                    <span class="day-badge off">Bekliyor</span>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </section>
        <% } %>

        <section class="panel">
          <h3>Son <%= ydsView.gunSayisi %> Gün</h3>
          <p class="muted">
            Doğruluk yalnızca <strong>puanlı</strong> testlerden hesaplanır; YDS tarafında
            dilbilgisi testleri puansız olduğu için çözülen soruların bir kısmı doğruluk
            paydasına girmez.
          </p>
          <% if (!ydsView.rows.length) { %>
          <p class="muted">Bu aralıkta kayıt yok.</p>
          <% } else { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Tarih</th>
                  <th>Gün</th>
                  <th>Okuma</th>
                  <th>Kelime</th>
                  <th>Gramer</th>
                  <th>Test</th>
                  <th>Kelime Kartı</th>
                  <th>Çözülen</th>
                  <th>Puanlı</th>
                  <th>Doğruluk</th>
                  <th>Hedef</th>
                </tr>
              </thead>
              <tbody>
                <% ydsView.rows.forEach((r) => { %>
                <tr>
                  <td><%= r.date %></td>
                  <td><%= r.gunAdi %></td>
                  <td><%= r.readings %></td>
                  <td><%= r.decks %></td>
                  <td><%= r.lessons %></td>
                  <td><%= r.quizzes %></td>
                  <td><%= r.wordsLearned %></td>
                  <td><%= r.questionsSolved %></td>
                  <td><%= r.scoredQuestions %></td>
                  <td><%= r.accuracy === null ? '-' : r.accuracy + '%' %></td>
                  <td>
                    <% if (r.goalMet) { %>
                    <span class="day-badge ok">Tuttu</span>
                    <% } else { %>
                    <span class="day-badge off">Eksik</span>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </section>
        <% } %>
        <% } %>

        <% if (currentPage === 'reports') { %>
        <header class="content-header">
          <h2>Performans Raporları</h2>
        </header>
        <section class="panel">
          <form method="get" action="/admin/reports" class="grid three">
            <div class="stack">
              <label>Öğrenci</label>
              <select name="reportStudentId" required>
                <option value="">Seçiniz</option>
                <% students.forEach((s) => { %>
                <option value="<%= s.id %>" <%= reportFilters.studentId === s.id ? 'selected' : '' %>><%= s.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="stack">
              <label>Başlangıç</label>
              <input type="date" name="reportFrom" value="<%= reportFilters.fromDate %>" required />
            </div>
            <div class="stack">
              <label>Bitiş</label>
              <input type="date" name="reportTo" value="<%= reportFilters.toDate %>" required />
            </div>
            <div class="stack"><button type="submit">Rapor Getir</button></div>
          </form>

          <% if (reportError) { %>
          <div class="alert error"><%= reportError %></div>
          <% } %>

          <% if (report) { %>
          <p>
            <strong><%= report.student.name %></strong> için <%= report.fromDate %> - <%= report.toDate %>
            dönemi tamamlanma oranı: <strong>%<%= report.completionRate %></strong>
          </p>
          <p class="muted">
            Toplam Görev: <%= report.totals.due %> | Tamamlanan: <%= report.totals.done %> |
            Soru: <%= report.totals.questions %>
          </p>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Tarih</th>
                  <th>Görev</th>
                  <th>Yapıldı</th>
                  <th>Yapılmadı</th>
                  <th>Soru</th>
                </tr>
              </thead>
              <tbody>
                <% report.rows.forEach((r) => { %>
                <tr>
                  <td><%= r.date %></td>
                  <td><%= r.dueCount %></td>
                  <td><%= r.doneCount %></td>
                  <td><%= r.notDoneCount %></td>
                  <td><%= r.questionCount %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </section>
        <% } %>
      </section>
    </main>
  </body>
</html>
