<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giris</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="login-hero">
      <div class="login-shell">
      <section class="login-brand-panel">
        <span class="hero-tag">Gorev ve Performans Takibi</span>
        <h1 class="brand-title">Ogrenci Takip Sistemi</h1>
        <p class="muted brand-subtitle">
          Ogrencilerin gunluk gorev, soru, sure ve puan takibini tek bir panelde
          yonetin.
        </p>
        <ul class="login-feature-list">
          <li>Haftalik takvim ve gorev ilerleme gorunumu</li>
          <li>Odul-ceza puanlama ve raporlama akisi</li>
          <li>Mobil uyumlu, hizli gorev giris deneyimi</li>
        </ul>
      </section>

      <section class="login-auth-panel">
        <h2>Hesabina Giris Yap</h2>
        <p class="muted">Rolune gore paneline guvenli sekilde yonlendirilirsin.</p>

        <% if (error) { %>
        <div class="alert error"><%= error %></div>
        <% } %>

        <form method="post" action="/login" class="stack login-form">
          <label>Kullanici Adi</label>
          <input type="text" name="username" autocomplete="username" required />

          <label>Sifre</label>
          <input type="password" name="password" autocomplete="current-password" required />

          <button type="submit">Giris Yap</button>
          <p class="muted login-footnote">
            Guvenli oturum acilir. Cikis yaptiginda oturum sonlandirilir.
          </p>
        </form>
      </section>
      </div>
    </main>
  </body>
</html>
