<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giris</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="container narrow">
      <section class="login-hero">
        <span class="hero-tag">Gorev ve Performans Takibi</span>
        <h1 class="brand-title">Ogrenci Takip Sistemi</h1>
        <p class="muted brand-subtitle">Admin ve ogrenci paneli ile gunluk gorev, puan ve soru takibini tek noktadan yonetin.</p>
      </section>

      <% if (error) { %>
      <div class="alert error"><%= error %></div>
      <% } %>

      <form method="post" action="/login" class="card stack login-form">
        <label>Kullanici Adi</label>
        <input type="text" name="username" required />

        <label>Sifre</label>
        <input type="password" name="password" required />

        <button type="submit">Giris Yap</button>
        <p class="muted login-footnote">Giris sonrasinda rolunuze gore panelinize yonlendirilirsiniz.</p>
      </form>
    </main>
  </body>
</html>
